# rutinario corrompía las corridas vecinas (I-439). El arnés (`src/lib/test-db-url.ts`) lo DERIVA por worktree
# en local; en CI el workflow lo provee (heredoc) y se respeta tal cual. Nunca se cae a un default compartido.
JWT_SECRET="change-me-in-production-min-32-characters-long"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
