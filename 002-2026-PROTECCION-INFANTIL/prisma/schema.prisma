model Usuario {
  id                          String           @id @default(cuid())
  email                       String           @unique
  nombre                      String?
  // SPEC-334: datos de perfil del padre (aditivos, nullable). "Nombres" = `nombre`.
  apellidos                   String?
  // SPEC-339 (A-67): documento del padre. Obligatorio en el Paso 2 del camino
  // guiado (validación), nullable en el esquema porque hay cuentas vivas sin él.
  // NO se declara @@unique: dos padres pueden digitar mal el mismo número y
  // bloquear un registro por eso dejaría a un padre afuera sin salida propia.
  documentoTipo               String?
  documentoNumero             String?
  // SPEC-339: se conserva en la BD y deja de pedirse en el camino (decisión CEO
  // D-2, 31-08-2026). Ningún dato se borra.
  fechaNacimiento             DateTime?
  telefono                    String?
  paisId                      String?
  ciudadId                    String?
  passwordHash                String
  rol                         RolUsuario
  estado                      EstadoUsuario    @default(activo)
  // SPEC-240 (002-PI-143): estado de activación institucional.
  estadoActivacion            EstadoActivacion @default(REGISTRADO)
  tokenInvitacion             String?          @unique
  tokenInvitacionExpiraEn     DateTime?        @db.Timestamptz(6)
  debeCambiarPassword         Boolean          @default(false)
  intentosFallidos            Int              @default(0)
  bloqueadoHasta              DateTime?
  ultimaSesion                DateTime?
  tenantId                    String?
  colegioId                   String?          @unique
  // SPEC-168: cuenta compartida del Comité de Convivencia del colegio (una por colegio).
  comiteColegioId             String?          @unique
  // SPEC-119: ventana de servicio del cliente padre (PARENT). null = sin vigencia
  // definida = acceso permitido. Para SCHOOL_ADMIN la ventana es la del Colegio.
  /// @deprecated · usar Suscripcion.fechaInicio/fechaFin
  inicioServicio              DateTime?
  /// @deprecated · usar Suscripcion.fechaInicio/fechaFin
  finServicio                 DateTime?
  // SPEC-241 (002-PI-144): campos de consentimiento informado (aditivos).
  consentimientoAceptadoEn    DateTime?
  consentimientoVersion       String?
  consentimientoDocumentoHash String?
  consentimientoIP            String?
  creadoEn                    DateTime         @default(now())
  actualizadoEn               DateTime         @updatedAt

  tenant                           Tenant?                         @relation(fields: [tenantId], references: [id])
  colegio                          Colegio?                        @relation(fields: [colegioId], references: [id])
  comiteConvivenciaColegio         Colegio?                        @relation(name: "ComiteConvivenciaColegio", fields: [comiteColegioId], references: [id])
  parametros                       ParametroSistema[]
  auditLogs                        AuditLog[]
  permisosModuloActualizados       PermisoModulo[]
  codigos                          CodigoVerificacion[]
  tokensRecuperacion               TokenRecuperacion[]
  reportes                         Reporte[]
  reportesDadosDeBaja              Reporte[]                       @relation("ReportesDadosDeBaja")
  correcciones                     CorreccionAdmin[]
  alertasSuscripcion               AlertaSuscripcion[]
  simulaciones                     SimulacionRun[]
  casosAsignados                   Reporte[]                       @relation("CasosOperador")
  casosComiteAsignados             Reporte[]                       @relation("CasosComite")
  anonimizacionesValidadas         Reporte[]                       @relation("AnonimizacionesValidadas")
  perfilOperador                   PerfilOperador?
  operadoresCreados                PerfilOperador[]                @relation("OperadoresCreados")
  // SPEC-245 (002-PI-148): suscripciones que este admin autorizó manualmente.
  suscripcionesAutorizadas         Suscripcion[]                   @relation("SuscripcionesAutorizadasPorAdmin")
  // SPEC-246 (002-PI-149): cupones de recompensa de los que este usuario es beneficiario.
  bonosBeneficiario                BonoPromocional[]               @relation("BonosBeneficiario")
  contactosConfianza               ContactoConfianza[]
  // SPEC-339: los menores de este padre (ficha propia, no compartida).
  hijosPropios                     Hijo[]                          @relation("HijosDelPadre")
  /// @deprecated SPEC-339 · sin uso desde 31-08-2026 · ver nota en `HijoPadre`.
  hijos                            HijoPadre[]
  identificadoresHijoDesvinculados IdentificadorHijoDesvinculado[]
  notificacionesCirculo            Boolean                         @default(true)
  ultimaNotificacionCirculoEn      DateTime?
  // SPEC-339 (A-67 · punto 4 Calidad): interruptor y enfriamiento PROPIOS de los
  // avisos sobre hijos. NO se comparten con los del círculo: un aviso sobre un
  // contacto vigilado no puede silenciar el aviso sobre un hijo, ni apagar los
  // del círculo puede apagar los del hijo (regla de Jelkin: cada padre — y cada
  // frente — con sus interruptores).
  notificacionesHijos              Boolean                         @default(true)
  ultimaNotificacionHijosEn        DateTime?
  ultimaNotificacionColegioEn      DateTime?
  transicionesReporte              TransicionReporte[]
  solicitudesComite                SolicitudComite[]               @relation("SolicitudesComite")
  solicitudesEscaladas             SolicitudComite[]               @relation("SolicitudesEscaladas")
  solicitudesComiteCreadas         SolicitudComite[]               @relation("SolicitudesCreadasPorColegio")
  // SPEC-380 (PR A): backrefs para el análisis del comité y la recomendación
  // de emitir el informe (quién escribió / quién recomendó).
  solicitudesAnalisisPor           SolicitudComite[]               @relation("SolicitudesAnalisisPor")
  solicitudesRecomendacionPor      SolicitudComite[]               @relation("SolicitudesRecomendacionPor")
  notasSeguimiento                 NotaSeguimiento[]
  integrantesComite                IntegranteComite[]              @relation("IntegrantesComite")
  integrantesComiteCreados         IntegranteComite[]              @relation("IntegrantesComiteCreados")
  integrantesComiteModificados     IntegranteComite[]              @relation("IntegrantesComiteModificados")
  apelaciones                      Apelacion[]                     @relation("ApelacionesUsuario")
  apelacionesAsignadas             Apelacion[]                     @relation("ApelacionesAsignadasComite")
  apelacionesResueltas             Apelacion[]                     @relation("ApelacionesResueltas")
  accesosDocumentoApelacion        AccesoDocumentoApelacion[]
  alertasAsignadas                 AlertaColegio[]
  notificacionesInApp              NotificacionInApp[]
  // SPEC-184 (002-PI-079): blocklist y simulador de abusos.
  bloqueosCreados                  BlockList[]
  simulacionesAbuso                SimulacionAbusoRun[]
  // SPEC-230 (002-PI-130): expedientes del padre.
  expedientes                      Expediente[]
  // SPEC-340: informes del expediente generados por este padre.
  informesPadre                    InformePadre[]                  @relation("InformesPadreGenerados")
  // SPEC-351: informes de caso del colegio firmados por este usuario (rector).
  informesCasoFirmados             InformeCaso[]                   @relation("InformesCasoFirmados")
  // SPEC-206 (002-PI-120): sesiones activas del usuario.
  sesionesLog                      SesionLog[]
  // SPEC-241 (002-PI-144): traza inmutable de aceptaciones de consentimiento.
  auditConsentimientos             AuditConsentimiento[]
  // SPEC-234 (002-PI-134): informes consolidados generados por el usuario/worker.
  informesConsolidados             InformeConsolidado[]
  // SPEC-235 (002-PI-135): guías de acción creadas por el admin.
  guiasAccionCreadas               GuiaAccionCategoria[]
  // SPEC-210 (002-PI-110): módulo de pagos.
  suscripciones                    Suscripcion[]
  planesCreados                    Plan[]                          @relation("PlanesCreados")
  bonosCreados                     BonoPromocional[]               @relation("BonosCreados")
  pagosAutorizados                 Pago[]                          @relation("PagosAutorizados")
  referidosRevisados               CodigoReferidoUso[]             @relation("ReferidosRevisados")
  tasasIngresadas                  TasaCambio[]                    @relation("TasasIngresadas")
  // SPEC-220 (002-PI-121): dominio Análisis (reglas, recomendaciones, anomalías, digest).
  reglasRecomendacionCreadas       ReglaRecomendacion[]
  recomendacionesResueltas         Recomendacion[]
  anomaliasResueltas               Anomalia[]
  digestsSemanal                   DigestSemanal[]
  // SPEC-238 (002-PI-mega-cola): aclaraciones respondidas por el miembro del comité.
  aclaracionesRespondidas          AclaracionExpediente[]
  // SPEC-239 (002-PI-mega-cola): contactos de emergencia administrados por el padre.
  contactosEmergencia              ContactoEmergencia[]
  // SPEC-224 (002-PI-125): versiones de reglas de recomendación cambiadas por el admin.
  reglasHistorialCambiadas         ReglaRecomendacionHistorial[]
  // SPEC-334: país/ciudad del perfil del padre (catálogo geográfico existente).
  paisPerfil                       Pais?                           @relation("UsuariosPorPais", fields: [paisId], references: [id])
  ciudadPerfil                     Ciudad?                         @relation("UsuariosPorCiudad", fields: [ciudadId], references: [id])
  // SPEC-388 (A-75 · L1a): back-refs de la Red de Profesionales.
  perfilProfesional                PerfilProfesional?
  verificacionesProfesionalRevisadas VerificacionProfesional[]     @relation("VerificacionesRevisadasPor")
  solicitudesCitaComoPadre         SolicitudCita[]                 @relation("SolicitudesCitaPadre")

  @@index([email])
  @@index([rol])
  @@index([estado])
  @@index([tenantId])
  @@index([paisId])
  @@index([ciudadId])
  // SPEC-339: búsqueda del padre por documento desde administración.
  @@index([documentoTipo, documentoNumero])
}

model PerfilOperador {
  id                        String    @id @default(cuid())
  usuarioId                 String    @unique
  cupoMaximo                Int?
  esRevisorDeApelaciones    Boolean   @default(false)
  esComite                  Boolean   @default(false)
  notasInternas             String?
  ultimoEmailNotificacionEn DateTime?
  creadoPorId               String
  creadoEn                  DateTime  @default(now())
  actualizadoEn             DateTime  @updatedAt

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadoPor Usuario @relation(fields: [creadoPorId], references: [id], name: "OperadoresCreados")

  @@index([usuarioId])
  @@index([creadoPorId])
  @@index([esComite])
}

model IntegranteComite {
  id                   String                       @id @default(cuid())
  comiteId             String
  nombres              String
  apellidos            String
  tipoIdentificacion   TipoIdentificacionIntegrante
  numeroIdentificacion String
  hashIdentificacion   String
  email                String
  cargo                String?
  fechaInicio          DateTime                     @default(now())
  fechaFin             DateTime?
  estado               EstadoIntegranteComite       @default(ACTIVO)
  creadoPorId          String
  modificadoPorId      String?
  creadoEn             DateTime                     @default(now())
  actualizadoEn        DateTime                     @updatedAt

  comite              Usuario           @relation(fields: [comiteId], references: [id], name: "IntegrantesComite", onDelete: Cascade)
  creadoPor           Usuario           @relation(fields: [creadoPorId], references: [id], name: "IntegrantesComiteCreados")
  modificadoPor       Usuario?          @relation(fields: [modificadoPorId], references: [id], name: "IntegrantesComiteModificados")
  // SPEC-319 §2.4: casos cuyo cierre firmó este integrante.
  solicitudesFirmadas SolicitudComite[] @relation(name: "SolicitudesFirmadas")
  // SPEC-380 (PR B · C4/D-100): identificadores del integrante que se vigilan
  // igual que los de estudiantes/profesores/acudientes — 4º sujeto.
  identificadores     IdentificadorIntegranteComite[]

  @@unique([comiteId, hashIdentificacion])
  @@index([comiteId])
  @@index([estado])
  @@index([tipoIdentificacion])
}

// SPEC-380 (PR B · C4/D-100): identificadores del integrante del comité de
// convivencia. Mismo patrón que `IdentificadorProfesor` — soft delete por
// estado, tenant por colegio. Aviso al colegio, jamás a la persona vigilada.
model IdentificadorIntegranteComite {
  id           String   @id @default(cuid())
  integranteId String
  colegioId    String
  tipo         String
  valor        String
  plataformaId String?
  estado       String   @default("activo") // activo | inactivo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  integrante IntegranteComite @relation(fields: [integranteId], references: [id], onDelete: Cascade)
  colegio    Colegio          @relation(fields: [colegioId], references: [id])
  plataforma Plataforma?      @relation(fields: [plataformaId], references: [id])
  alertas    AlertaColegio[]

  // El único parcial WHERE estado='activo' vive en la migración (Prisma no lo
  // expresa) — misma red dura que estudiante/profesor/acudiente contra I-213.
  @@index([colegioId, estado])
  @@index([integranteId, estado])
  @@index([tipo, valor])
  @@index([plataformaId])
}

model CodigoVerificacion {
  id               String   @id @default(cuid())
  email            String
  codigoHash       String
  expiraEn         DateTime
  intentosFallidos Int      @default(0)
  usado            Boolean  @default(false)
  creadoEn         DateTime @default(now())

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([email])
  @@index([creadoEn])
}

model TokenRecuperacion {
  id            String   @id @default(cuid())
  email         String
  tokenHash     String
  expiraEn      DateTime
  usado         Boolean  @default(false)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([email])
  @@index([tokenHash])
  @@index([expiraEn])
}

/// SPEC-339 (A-67) · enlace de registro del padre.
///
/// Reemplaza al código de 6 dígitos SOLO para el padre: el registro de colegio
/// sigue usando `CodigoVerificacion` y sus rutas, intactos.
///
/// Sin relación con `Usuario`: cuando se pide el enlace la cuenta todavía no
/// existe; se crea al completar. Del token se guarda SOLO el hash — el valor en
/// claro viaja en el enlace del correo y nunca se persiste.
model TokenRegistro {
  id            String     @id @default(cuid())
  email         String
  tokenHash     String
  expiraEn      DateTime
  usado         Boolean    @default(false)
  // SPEC-344 (A-69 · C1): registro por enlace compartido padre + colegio.
  // Los tokens existentes quedan como PARENT (default) — coherente: SPEC-339
  // solo emitía tokens para padres. Nuevas emisiones del colegio llevan
  // SCHOOL_ADMIN. `completar` fuerza el rol del token, no confía en el cliente.
  rol           RolUsuario @default(PARENT)
  // SPEC-344 · datos EXTRA para tokens del colegio (nombre y NIT). Se guardan
  // al solicitar el enlace y se recuperan al completar — evita re-pedirlos al
  // rector y evita exponer el NIT en la URL del enlace. Nulos para PARENT.
  nombreColegio String?
  nit           String?
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  @@index([email])
  @@index([tokenHash])
  @@index([expiraEn])
}

model ParametroSistema {
  id               String             @id @default(cuid())
  clave            String             @unique
  valor            String
  tipo             TipoParametro
  categoria        CategoriaParametro
  esPublico        Boolean            @default(false)
  esSecreto        Boolean            @default(false)
  descripcion      String?
  reglasValidacion String?
  creadoEn         DateTime           @default(now())
  actualizadoEn    DateTime           @updatedAt
  actualizadoPorId String?

  actualizadoPor Usuario?   @relation(fields: [actualizadoPorId], references: [id])
  auditLogs      AuditLog[]

  @@index([clave])
  @@index([categoria])
}

model AuditLog {
  id            String      @id @default(cuid())
  accion        AccionAudit
  tipoRecurso   String
  recursoId     String?
  usuarioId     String?
  parametroId   String?
  colegioId     String?
  valorAnterior String?
  valorNuevo    String?
  ipAddress     String
  userAgent     String
  metadatos     Json?
  creadoEn      DateTime    @default(now())

  usuario   Usuario?          @relation(fields: [usuarioId], references: [id])
  parametro ParametroSistema? @relation(fields: [parametroId], references: [id])
  colegio   Colegio?          @relation(fields: [colegioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([parametroId])
  @@index([colegioId])
  @@index([accion])
  @@index([creadoEn])
}

// SPEC-206 (002-PI-120): bitácora de sesiones activas para instrumentación de uso.
model SesionLog {
  id                String              @id @default(cuid())
  usuarioId         String
  tenantId          String?
  rol               RolUsuario
  iniciadaEn        DateTime            @db.Timestamptz(6)
  ultimaActividadEn DateTime            @db.Timestamptz(6)
  cerradaEn         DateTime?           @db.Timestamptz(6)
  motivoCierre      MotivoCierreSesion?
  duracionMin       Int?
  ipHash            String
  userAgent         String?
  creadoEn          DateTime            @default(now())
  actualizadoEn     DateTime            @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, iniciadaEn(sort: Desc)])
  @@index([tenantId, iniciadaEn(sort: Desc)])
  @@index([cerradaEn, ultimaActividadEn])
  @@index([creadoEn])
  @@map("sesiones_log")
}

// SPEC-241 (002-PI-144): registro inmutable de aceptación de consentimiento informado.
model AuditConsentimiento {
  id                   String   @id @default(cuid())
  usuarioId            String
  version              String
  documentoTipo        String
  documentoHash        String
  aceptadoEn           DateTime @default(now())
  ip                   String
  userAgent            String?
  esRepresentanteLegal Boolean  @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, aceptadoEn])
  @@index([version])
  @@map("audit_consentimientos")
}

model Tenant {
  id       String   @id @default(cuid())
  nombre   String
  estado   String   @default("activo")
  creadoEn DateTime @default(now())

  usuarios Usuario[]
  reportes Reporte[]
  colegio  Colegio?
}

// SPEC-210 (002-PI-110): Plan enriquecido. El campo `precio` es legacy del
// placeholder original; la lógica nueva usa `precioBaseUSD`.
model Plan {
  id                    String       @id @default(cuid())
  nombre                String
  tipoTitular           TipoTitular
  duracion              DuracionPlan
  anio                  Int
  precioBaseUSD         Float
  precioBaseCOP         Float?
  esFreemium            Boolean      @default(false)
  usosMaximosPorCliente Int?
  descuentoAnualPct     Float?
  activo                Boolean      @default(true)
  descripcion           String?
  precio                Float? // legacy placeholder; no usar en lógica nueva
  creadoPorAdminId      String
  createdAt             DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(6)

  creadoPor     Usuario       @relation(fields: [creadoPorAdminId], references: [id], name: "PlanesCreados")
  suscripciones Suscripcion[]

  @@unique([tipoTitular, duracion, anio])
  @@index([activo, anio])
}

model Subscription {
  id        String    @id @default(cuid())
  tenantId  String
  planId    String
  estado    String    @default("activo")
  iniciaEn  DateTime
  terminaEn DateTime?
  creadoEn  DateTime  @default(now())
}

model BillingCycle {
  id             String   @id @default(cuid())
  subscriptionId String
  monto          Float
  estado         String   @default("pendiente")
  periodoInicio  DateTime
  periodoFin     DateTime
  creadoEn       DateTime @default(now())
}

// ============================================
// MÓDULO DE PAGOS (SPEC-210 · 002-PI-110)
// ============================================

model Suscripcion {
  id                   String            @id @default(cuid())
  tipoTitular          TipoTitular
  colegioId            String?
  usuarioId            String?
  estado               EstadoSuscripcion
  planActualId         String
  contratoPDFUrl       String?
  fechaInicio          DateTime          @db.Timestamptz(6)
  fechaFin             DateTime          @db.Timestamptz(6)
  fechaCorteProgramado DateTime?         @db.Timestamptz(6)
  esFreemium           Boolean           @default(false)
  freemiumFechaFin     DateTime?         @db.Timestamptz(6)
  codigoReferidoPropio String            @unique
  codigoReferidoUsado  String?
  monedaLocal          String            @default("COP")
  paisCliente          String            @default("CO")
  suspendidaEn         DateTime?         @db.Timestamptz(6)
  canceladaEn          DateTime?         @db.Timestamptz(6)
  canceladaPorUsuario  Boolean?
  motivoCancelacion    String?
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)

  // SPEC-244/245 (002-PI-147/148): trazabilidad de origen y pago manual.
  origen               OrigenSuscripcion @default(SOLICITADA_CLIENTE)
  autorizadoPorAdminId String?
  autorizadoEn         DateTime?         @db.Timestamptz(6)
  metodoPagoManual     MetodoPagoManual?
  referenciaPagoManual String?
  montoRealPagado      Float?
  fechaPagoReal        DateTime?         @db.Timestamptz(6)

  colegio               Colegio?            @relation(fields: [colegioId], references: [id])
  usuario               Usuario?            @relation(fields: [usuarioId], references: [id])
  autorizadoPor         Usuario?            @relation(fields: [autorizadoPorAdminId], references: [id], name: "SuscripcionesAutorizadasPorAdmin")
  planActual            Plan                @relation(fields: [planActualId], references: [id])
  pagos                 Pago[]
  bonosAplicados        BonoAplicado[]
  referidosCodigoPropio CodigoReferidoUso[] @relation("CodigoPropio")
  referidosUsados       CodigoReferidoUso[] @relation("Referida")
  // SPEC-220 (002-PI-121): snapshots mensuales del score de valor.
  scoreClientes         ScoreCliente[]

  @@index([estado, fechaFin])
  @@index([tipoTitular, estado])
  // SPEC-213 (002-PI-113): índices del worker de vigencia (activas por vencer + freemium; en gracia por cortar).
  @@index([estado, fechaFin, esFreemium])
  @@index([estado, fechaCorteProgramado])
  // SPEC-218 (002-PI-118): widget de crecimiento por país de la analítica dinero-vs-valor.
  @@index([estado, paisCliente, monedaLocal, createdAt])
  // SPEC-217 (002-PI-117): corte de freemiums vencidos por el worker y verificación de histórico por titular.
  @@index([esFreemium, freemiumFechaFin])
  @@index([usuarioId, esFreemium])
  @@index([colegioId, esFreemium])
}

model Pago {
  id                    String       @id @default(cuid())
  suscripcionId         String
  duracionCubierta      DuracionPlan
  montoBaseUSD          Float
  descuentoAplicadoUSD  Float        @default(0)
  montoNetoUSD          Float
  tasaCambioAplicada    Float
  montoLocalPagado      Float
  monedaLocal           String
  metodoDeclarado       MetodoPago
  comprobanteAdjuntoUrl String
  comprobanteMimeType   String
  comprobanteHashSha256 String
  fechaReporte          DateTime     @db.Timestamptz(6)
  fechaAutorizacion     DateTime?    @db.Timestamptz(6)
  estado                EstadoPago
  motivoRechazo         String?
  autorizadoPorAdminId  String?
  codigoReferidoUsado   String?
  // SPEC-212 (002-PI-112): campos aditivos de reembolso.
  montoReembolsoUSD     Float?
  motivoReembolso       String?
  referenciaReembolso   String?
  // SPEC-211 (002-PI-111): notas opcionales del cliente al reportar la renovación.
  notasCliente          String?
  createdAt             DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(6)

  suscripcion    Suscripcion    @relation(fields: [suscripcionId], references: [id])
  autorizadoPor  Usuario?       @relation(fields: [autorizadoPorAdminId], references: [id], name: "PagosAutorizados")
  bonosAplicados BonoAplicado[]

  @@index([suscripcionId, createdAt])
  @@index([estado, fechaReporte])
  // SPEC-218 (002-PI-118): KPIs de recaudo mes a mes de la analítica dinero-vs-valor.
  @@index([estado, createdAt, monedaLocal])
}

model BonoPromocional {
  id                          String       @id @default(cuid())
  nombre                      String       @unique
  tipo                        TipoBono
  valor                       Float
  vigenciaInicio              DateTime     @db.Timestamptz(6)
  vigenciaFin                 DateTime     @db.Timestamptz(6)
  usosMaximosTotales          Int?
  usosMaximosPorCliente       Int          @default(1)
  aplicaANuevos               Boolean      @default(true)
  aplicaARenovaciones         Boolean      @default(false)
  aplicaSoloA                 TipoTitular?
  combinableConCodigoPersonal Boolean      @default(false)
  activo                      Boolean      @default(true)
  descripcion                 String?
  creadoPorAdminId            String
  // SPEC-246 (002-PI-149): origen, beneficiario y transferibilidad del cupón.
  origen                      OrigenBono   @default(PROMOCION_ADMIN)
  beneficiarioUsuarioId       String?
  transferible                Boolean      @default(true)
  createdAt                   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime     @updatedAt @db.Timestamptz(6)

  creadoPor    Usuario        @relation(fields: [creadoPorAdminId], references: [id], name: "BonosCreados")
  beneficiario Usuario?       @relation(fields: [beneficiarioUsuarioId], references: [id], name: "BonosBeneficiario")
  usos         BonoAplicado[]

  @@index([activo, vigenciaInicio, vigenciaFin])
}

model BonoAplicado {
  id            String   @id @default(cuid())
  bonoId        String
  suscripcionId String
  pagoId        String?
  aplicadoEn    DateTime @default(now()) @db.Timestamptz(6)
  descuentoUSD  Float

  bono        BonoPromocional @relation(fields: [bonoId], references: [id])
  suscripcion Suscripcion     @relation(fields: [suscripcionId], references: [id])
  pago        Pago?           @relation(fields: [pagoId], references: [id])

  @@index([bonoId, aplicadoEn])
}

model CodigoReferidoUso {
  id                      String    @id @default(cuid())
  codigoReferidoUsuarioId String
  suscripcionReferidaId   String
  fechaRegistro           DateTime  @default(now()) @db.Timestamptz(6)
  fechaActivacion         DateTime? @db.Timestamptz(6)
  recompensaOtorgada      Boolean   @default(false)
  recompensaOtorgadaEn    DateTime? @db.Timestamptz(6)
  tipoRecompensa          String?
  anio                    Int
  requiereRevisionAdmin   Boolean   @default(false)
  revisadaPorAdminId      String?
  revisionOK              Boolean?

  referidor   Suscripcion @relation(fields: [codigoReferidoUsuarioId], references: [id], name: "CodigoPropio")
  referida    Suscripcion @relation(fields: [suscripcionReferidaId], references: [id], name: "Referida")
  revisadaPor Usuario?    @relation(fields: [revisadaPorAdminId], references: [id], name: "ReferidosRevisados")

  @@unique([codigoReferidoUsuarioId, suscripcionReferidaId])
  @@index([codigoReferidoUsuarioId, anio])
}

model TasaCambio {
  id                  String     @id @default(cuid())
  monedaOrigen        String
  monedaDestino       String
  tasa                Float
  fecha               DateTime   @db.Timestamptz(6)
  fuente              FuenteTasa
  apiUrl              String?
  ingresadoPorAdminId String?
  motivoManual        String?
  createdAt           DateTime   @default(now()) @db.Timestamptz(6)

  ingresadoPor Usuario? @relation(fields: [ingresadoPorAdminId], references: [id], name: "TasasIngresadas")

  @@index([monedaDestino, fecha])
}

model Colegio {
  id                               String              @id @default(cuid())
  nombre                           String
  // SPEC-320 (§2.2-bis): NIT institucional — llave del colegio, ÚNICA en todo el
  // sistema (no por tenant). Pensado para el puente padre↔colegio (el padre busca el
  // colegio por NIT). Obligatorio; se pide en /registro-colegio y en el alta admin.
  nit                              String              @unique
  paisId                           String
  departamentoId                   String?
  ciudadId                         String
  direccion                        String?
  representanteLegalNombre         String
  representanteLegalIdentificacion String
  representanteLegalEmail          String
  representanteLegalTelefono       String?
  inicioServicio                   DateTime
  finServicio                      DateTime?
  tipoPeriodo                      TipoPeriodoServicio
  estado                           String              @default("activo")
  // SPEC-351 (A-69 · D1): clave del escudo institucional cargado en Configuración
  // (solo PNG/JPG, ≤500 KB). Los informes firmados salen membreteados con él.
  escudoAssetKey                   String?
  tenantId                         String              @unique
  creadoEn                         DateTime            @default(now())
  actualizadoEn                    DateTime            @updatedAt

  pais                      Pais                       @relation(fields: [paisId], references: [id])
  departamento              Departamento?              @relation(fields: [departamentoId], references: [id])
  ciudad                    Ciudad                     @relation(fields: [ciudadId], references: [id])
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  admin                     Usuario?
  comiteConvivencia         Usuario?                   @relation(name: "ComiteConvivenciaColegio")
  cursos                    Curso[]
  estudiantes               Estudiante[]
  profesores                Profesor[]
  alertas                   AlertaColegio[]
  solicitudesComite         SolicitudComite[]
  patrones                  PatronInstitucional[]
  preferenciasAvisos        PreferenciaAlertaColegio[]
  registrosAvisos           RegistroAvisoColegio[]
  seguimientosCaso          SeguimientoCaso[]
  notasSeguimiento          NotaSeguimiento[]
  auditLogs                 AuditLog[]
  sesionesCarga             CargaRosterSesion[]
  Materia                   Materia[]
  CursoMateria              CursoMateria[]
  identificadoresAcudiente  IdentificadorAcudiente[]
  identificadoresProfesor   IdentificadorProfesor[]
  identificadoresEstudiante IdentificadorEstudiante[] // SPEC-320: colegioId denormalizado en el identificador de estudiante
  // SPEC-380 (PR B · C4): identificadores del comité vigilados por colegio.
  identificadoresIntegranteComite IdentificadorIntegranteComite[]
  onboarding                OnboardingColegio?
  notificacionesInApp       NotificacionInApp[]
  // SPEC-210 (002-PI-110): módulo de pagos.
  suscripciones             Suscripcion[]

  @@index([paisId])
  @@index([departamentoId])
  @@index([ciudadId])
  @@index([estado])
}

// SPEC-169 (Fase G): onboarding "Activa tu protección" — fila única por colegio.
// El progreso real se calcula sobre cursos, estudiantes, profesores, acudientes e
// identificadores activos; aquí solo se guarda estado, paso visible y timestamp.
model OnboardingColegio {
  id            String    @id @default(cuid())
  colegioId     String    @unique
  estado        String    @default("activo") // activo | omitido | completado
  pasoActual    Int       @default(1)
  completadoEn  DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  colegio Colegio @relation(fields: [colegioId], references: [id])

  @@index([estado])
}

// SPEC-169 (Fase G): notificaciones in-app dirigidas al SCHOOL_ADMIN del colegio.
// Estados implícitos por leidaEn / archivadaEn; nunca almacena texto del reporte.
model NotificacionInApp {
  id            String    @id @default(cuid())
  colegioId     String
  usuarioId     String
  tipo          String // ALERTA_NUEVA | ALERTA_GESTIONADA | ALERTA_ESCALADA | SISTEMA
  titulo        String
  mensaje       String
  entidadId     String?
  leidaEn       DateTime?
  archivadaEn   DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  colegio Colegio @relation(fields: [colegioId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([colegioId, usuarioId, archivadaEn, leidaEn, creadoEn])
  @@index([colegioId, usuarioId, archivadaEn, creadoEn])
  @@index([colegioId, entidadId, tipo])
}

model Curso {
  id                String   @id @default(cuid())
  colegioId         String
  nombre            String
  grado             String?
  anioLectivo       String?
  estado            String   @default("activo")
  profesorTitularId String? // SPEC-145: aditivo; existentes quedan NULL (no se retro-asigna)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  colegio         Colegio        @relation(fields: [colegioId], references: [id])
  profesorTitular Profesor?      @relation(fields: [profesorTitularId], references: [id])
  estudiantes     Estudiante[]
  CursoMateria    CursoMateria[]

  @@unique([colegioId, nombre, grado, anioLectivo])
  @@index([colegioId, estado])
}

// SPEC-145 (brief §7.2): modelo Profesor mínimo — nombre, apellidos, email?,
// teléfono?, estado. Baja = soft delete (estado "inactivo"), nunca borrado físico.
// SPEC-320 (§2.2): identidad del profesor OBLIGATORIA — tipo/número de documento,
// año de nacimiento, sexo, teléfono y email. Nacen NOT NULL sin nullable de
// transición (Jelkin arranca de cero). email/telefono dejan de ser nullable.
// Llave humana: (colegioId, tipoDocumento, numeroDocumento). documentoTipo se valida
// contra el catálogo TipoDocumento (clave). La de red social sigue siendo la del
// producto — van las dos.
model Profesor {
  id              String   @id @default(cuid())
  colegioId       String
  nombre          String
  apellidos       String
  tipoDocumento   String // clave del catálogo TipoDocumento
  numeroDocumento String
  anioNacimiento  Int
  sexo            String // set cerrado en Zod (M|F|OTRO)
  email           String
  telefono        String
  estado          String   @default("activo")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  colegio             Colegio                 @relation(fields: [colegioId], references: [id])
  cursos              Curso[]
  CursoMateria        CursoMateria[]
  identificadoresProf IdentificadorProfesor[]

  @@unique([colegioId, tipoDocumento, numeroDocumento])
  @@index([colegioId, estado])
}

// SPEC-162: catálogo de materias configurable por colegio.
model Materia {
  id            String   @id @default(cuid())
  colegioId     String
  nombre        String
  estado        String   @default("activo")
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  colegio      Colegio        @relation(fields: [colegioId], references: [id])
  CursoMateria CursoMateria[]

  @@unique([colegioId, nombre])
  @@index([colegioId, estado])
}

// SPEC-162: vínculo Curso × Materia × Profesor. Resuelve materia configurable
// y profesor multi-curso sin tocar Curso ni Estudiante.cursoId.
model CursoMateria {
  id            String   @id @default(cuid())
  colegioId     String
  cursoId       String
  materiaId     String
  profesorId    String?
  estado        String   @default("activo")
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  colegio  Colegio   @relation(fields: [colegioId], references: [id])
  curso    Curso     @relation(fields: [cursoId], references: [id])
  materia  Materia   @relation(fields: [materiaId], references: [id])
  profesor Profesor? @relation(fields: [profesorId], references: [id])

  @@unique([cursoId, materiaId])
  @@index([colegioId, estado])
  @@index([cursoId, estado])
  @@index([profesorId])
}

// SPEC-144: modelo Estudiante (antes Alumno; tabla física "Alumno" conservada).
// Obligatorios al alta (validación API, no BD): nombre + apellidos. El default ""
// de apellidos existe SOLO para el backfill de históricos (D4).
model Estudiante {
  id              String   @id @default(cuid())
  cursoId         String
  colegioId       String
  nombre          String
  apellidos       String   @default("")
  // SPEC-320 (§2.2-bis): documento del alumno OBLIGATORIO (antes opcional). Consume el
  // catálogo TipoDocumento (clave). Único por colegio (colegioId, documentoTipo,
  // documentoNumero) — índice parcial WHERE estado='activo' en la migración (Prisma no
  // expresa parciales). Pensado como dato confiable para el cruce padre↔colegio.
  documentoTipo   String
  documentoNumero String
  estado          String   @default("activo")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  curso           Curso                     @relation(fields: [cursoId], references: [id])
  colegio         Colegio                   @relation(fields: [colegioId], references: [id])
  identificadores IdentificadorEstudiante[]
  acudientes      AcudienteEstudiante[]
  observaciones   EstudianteObservacion[]

  @@index([cursoId, estado])
  @@index([colegioId, estado])
  @@map("Alumno")
}

// SPEC-144 (D1) / SPEC-163: acudiente del estudiante — tabla hija, máximo 2 por
// estudiante (orden 1|2). PII de un tercero: NUNCA se consulta por id suelto;
// siempre a través del estudiante ya acotado por colegioId (patrón E-1/SPEC-134).
// SPEC-163: estado (activo/inactivo) como baja lógica aditiva.
model AcudienteEstudiante {
  id           String   @id @default(cuid())
  estudianteId String
  orden        Int // 1 = principal, 2 = secundario
  nombre       String
  relacion     String // "madre" | "padre" | "tía" | … (texto libre corto)
  telefono     String?
  email        String?
  // SPEC-344 (A-69 · C1) · D-acud: documento del acudiente OPCIONAL (mockup 1.6).
  // Sin unicidad nueva — el mismo documento puede repetirse (padre con varios
  // hijos). El tipo se valida contra el catálogo TipoDocumento activo cuando
  // viene; ausente = ausente.
  documentoTipo   String?
  documentoNumero String?
  estado       String   @default("activo") // activo | inactivo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  estudiante      Estudiante               @relation(fields: [estudianteId], references: [id])
  identificadores IdentificadorAcudiente[]

  @@unique([estudianteId, orden, estado])
  @@index([estudianteId, estado])
}

// SPEC-163 (FR-001): identificadores tipados de un acudiente para matching de
// alertas (Fase C). colegioId denormalizado para validación de tenant y queries
// rápidas (patrón E-1/SPEC-134). Baja lógica por estado.
model IdentificadorAcudiente {
  id           String   @id @default(cuid())
  acudienteId  String
  colegioId    String
  tipo         String
  valor        String
  plataformaId String?
  estado       String   @default("activo") // activo | inactivo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  acudiente  AcudienteEstudiante @relation(fields: [acudienteId], references: [id])
  colegio    Colegio             @relation(fields: [colegioId], references: [id])
  plataforma Plataforma?         @relation(fields: [plataformaId], references: [id])
  alertas    AlertaColegio[]

  // SPEC-320 (§2.1 · EXCEPCIÓN asimétrica): la unicidad de acudiente se MANTIENE
  // por-acudiente (acudienteId,tipo,valor,plataformaId), NO por-colegio. Razón:
  // AcudienteEstudiante es @@unique([estudianteId, orden, estado]) → una fila de
  // acudiente por (estudiante, orden), así que un padre con dos hijos en el colegio
  // tiene DOS filas de acudiente y su mismo identificador va legítimamente en ambas.
  // La BD NO puede bloquear eso; el cruce entre filas lo cubre el warn de aplicación.
  // NO unificar a (colegioId,...) — rompería al padre-de-dos-hijos. Índice parcial
  // crudo (WHERE estado='activo', NULLS NOT DISTINCT) en la migración B.
  @@index([colegioId, estado])
  @@index([acudienteId, estado])
  @@index([valor])
}

// SPEC-164: identificadores tipados de un profesor (teléfono, email, nick/usuario
// en plataforma). Soft delete por estado; no borrado físico.
model IdentificadorProfesor {
  id           String   @id @default(cuid())
  profesorId   String
  colegioId    String
  tipo         String
  valor        String
  plataformaId String?
  estado       String   @default("activo") // activo | inactivo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profesor   Profesor        @relation(fields: [profesorId], references: [id])
  colegio    Colegio         @relation(fields: [colegioId], references: [id])
  plataforma Plataforma?     @relation(fields: [plataformaId], references: [id])
  alertas    AlertaColegio[]

  // SPEC-320 (§2.1): unicidad por (colegioId,tipo,valor,plataformaId) como índice
  // único PARCIAL crudo (WHERE estado='activo', NULLS NOT DISTINCT) en la migración B
  // — misma red dura de BD que estudiante (dos profesores del colegio con el mismo
  // identificador = bug I-213). Reemplaza el viejo @@unique por-profesor.
  @@index([colegioId, estado])
  @@index([profesorId, estado])
  @@index([valor])
}

// SPEC-150 (FR-001): observación especial del estudiante — la marca auditable
// (Ley 1581). Soft delete estilo Reporte: desmarcar CONSERVA la fila con
// quién/cuándo (activa=false + desactivadaEn/desactivadaPorId), nunca borra el
// histórico. colegioId denormalizado para acotar SIEMPRE por tenant (patrón
// E-1/SPEC-134); creadaPorId/desactivadaPorId son ids de Usuario sin FK (el
// actor puede desactivarse después sin romper el respaldo).
model EstudianteObservacion {
  id               String    @id @default(cuid())
  estudianteId     String
  colegioId        String
  activa           Boolean   @default(true)
  motivo           String?
  creadaPorId      String
  desactivadaEn    DateTime?
  desactivadaPorId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])

  @@index([estudianteId, activa])
}

model IdentificadorEstudiante {
  id               String                     @id @default(cuid())
  estudianteId     String                     @map("alumnoId")
  // SPEC-320 (§2.1 · H1): colegioId denormalizado. NO es redundante: es la
  // columna que habilita la unicidad por-colegio del identificador (la llave del
  // producto) con red de BD en el sujeto más importante (el alumno). Las tablas
  // de acudiente y profesor ya lo llevaban; el alumno era el único sin ella.
  // NO "limpiar" pensando que el tenant ya viaja por la relación estudiante.
  colegioId        String
  tipo             String
  valor            String
  plataformaId     String?
  etiquetaRelacion EtiquetaRelacionEstudiante @default(ESTUDIANTE)
  estado           String                     @default("activo")
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  estudiante Estudiante      @relation(fields: [estudianteId], references: [id])
  colegio    Colegio         @relation(fields: [colegioId], references: [id])
  plataforma Plataforma?     @relation(fields: [plataformaId], references: [id])
  alertas    AlertaColegio[]

  // SPEC-320 (§2.1): la unicidad se aplica como índice único PARCIAL crudo
  // (WHERE estado='activo', NULLS NOT DISTINCT) en la migración — Prisma no
  // expresa NULLS NOT DISTINCT ni índices parciales en @@unique. Estudiante y
  // profesor: unicidad por (colegioId,tipo,valor,plataformaId). Ver migración B.
  @@index([estudianteId, estado])
  @@index([colegioId, estado])
  @@map("IdentificadorAlumno")
}

// SPEC-165: alerta extendida a estudiante/profesor/acudiente. Una sola FK
// poblada según tipoSujeto; constraint única por tipo evita duplicados.
model AlertaColegio {
  id                        String   @id @default(cuid())
  colegioId                 String
  reporteId                 String
  identificadorEstudianteId String?  @map("identificadorAlumnoId")
  identificadorProfesorId   String?
  identificadorAcudienteId  String?
  // SPEC-380 (PR B · C4/D-100): 4º sujeto — integrante del comité de convivencia.
  // Adulto, no menor, pero se vigila igual: aviso al colegio, jamás a la persona.
  identificadorIntegranteComiteId String?
  tipoSujeto                String   @default("ESTUDIANTE") // ESTUDIANTE | PROFESOR | ACUDIENTE | INTEGRANTE_COMITE
  estado                    String   @default("nueva") // nueva | vista | gestionada | escalada | cerrada
  prioridad                 String   @default("media") // alta | media | baja
  vencimientoSla            DateTime @db.Timestamptz(6)
  asignadoAId               String?
  // SPEC-142 (F6): fila agregada que ESTA alerta aportó (idempotencia + reversa
  // exacta en baja). Nullable: las alertas previas a F6 no aportan al agregado.
  patronInstitucionalId     String?
  creadoEn                  DateTime @default(now()) @db.Timestamptz(6)
  actualizadoEn             DateTime @updatedAt @db.Timestamptz(6)

  colegio                 Colegio                  @relation(fields: [colegioId], references: [id])
  reporte                 Reporte                  @relation(fields: [reporteId], references: [id])
  identificadorEstudiante IdentificadorEstudiante? @relation(fields: [identificadorEstudianteId], references: [id])
  identificadorProfesor   IdentificadorProfesor?   @relation(fields: [identificadorProfesorId], references: [id])
  identificadorAcudiente  IdentificadorAcudiente?  @relation(fields: [identificadorAcudienteId], references: [id])
  // SPEC-380 (PR B): 4ª relación al identificador del integrante del comité.
  identificadorIntegranteComite IdentificadorIntegranteComite? @relation(fields: [identificadorIntegranteComiteId], references: [id])
  patronInstitucional     PatronInstitucional?     @relation(fields: [patronInstitucionalId], references: [id])
  asignadoA               Usuario?                 @relation(fields: [asignadoAId], references: [id])
  seguimiento             SeguimientoCaso?
  // SPEC-168: una alerta escalada genera una única solicitud al Comité de Convivencia.
  solicitudComite         SolicitudComite?

  @@unique([colegioId, reporteId, identificadorEstudianteId])
  @@unique([colegioId, reporteId, identificadorProfesorId])
  @@unique([colegioId, reporteId, identificadorAcudienteId])
  // SPEC-380 (PR B): mismo patrón — evita duplicar la alerta por integrante.
  @@unique([colegioId, reporteId, identificadorIntegranteComiteId])
  @@index([colegioId, estado])
  @@index([colegioId, prioridad, vencimientoSla])
  @@index([colegioId, asignadoAId])
  @@index([reporteId])
  @@index([tipoSujeto])
}

// SPEC-142 (F6): patrón institucional agregado por (colegio, grado, conducta,
// plataforma, trimestre). SIN PII por construcción (FR-002): nunca identificador,
// reporteId, alumnoId, nombres ni textos — solo conteos por dimensiones.
// El k-anonimato (k=3) se aplica en LECTURA, no aquí.
model PatronInstitucional {
  id            String            @id @default(cuid())
  colegioId     String
  periodo       String // trimestre calendario de Reporte.creadoEn: "2026-Q3"
  grado         String // snapshot de Curso.grado; sentinel "Sin grado registrado"
  conducta      CategoriaConducta
  plataformaId  String
  conteo        Int               @default(0)
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  colegio    Colegio         @relation(fields: [colegioId], references: [id])
  plataforma Plataforma      @relation(fields: [plataformaId], references: [id])
  alertas    AlertaColegio[]

  @@unique([colegioId, periodo, grado, conducta, plataformaId])
  @@index([colegioId, periodo])
  @@map("patrones_institucionales")
}

// SPEC-149 (FR-001): preferencias de avisos por email del colegio. UNA fila por
// (colegio, tipoEvento); sin fila rigen los defaults del pipeline (todo
// habilitado, destino = email del SCHOOL_ADMIN, N=3/7d curso, M=2/30d
// estudiante, resumen habilitado). tipoEvento es String con valores cerrados
// (mismo patrón que AlertaColegio.estado): REPORTE_NUEVO | UMBRAL_CURSO |
// ESTUDIANTE_REPETIDO | RESUMEN_SEMANAL. `umbral` y `ventanaDias` solo aplican
// a UMBRAL_CURSO y ESTUDIANTE_REPETIDO.
model PreferenciaAlertaColegio {
  id            String   @id @default(cuid())
  colegioId     String
  tipoEvento    String // REPORTE_NUEVO | UMBRAL_CURSO | ESTUDIANTE_REPETIDO | RESUMEN_SEMANAL
  habilitado    Boolean  @default(true)
  emailDestino  String?
  umbral        Int?
  ventanaDias   Int?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  colegio Colegio @relation(fields: [colegioId], references: [id])

  @@unique([colegioId, tipoEvento])
}

// SPEC-149 (FR-001): bitácora de avisos del colegio — LA idempotencia por
// constraint: @@unique([colegioId, tipoEvento, entidadId, dia]). Un mismo
// evento/entidad/día = UNA fila = UN email como máximo; el duplicado es no-op.
// ENVIADO solo se marca tras el 200 del proveedor (un FALLIDO no consume la
// idempotencia y pg-boss puede reintentar). estado es String con valores
// cerrados: ENVIADO | OMITIDO | PENDIENTE_DIGEST | FALLIDO. `entidadId` es el
// id de la entidad del evento (reporteId, cursoId, estudianteId) o "semanal"
// para el resumen. `dia` es la fecha del evento en día calendario (DATE).
model RegistroAvisoColegio {
  id            String   @id @default(cuid())
  colegioId     String
  tipoEvento    String // REPORTE_NUEVO | UMBRAL_CURSO | ESTUDIANTE_REPETIDO | RESUMEN_SEMANAL
  entidadId     String
  dia           DateTime @db.Date
  estado        String // ENVIADO | OMITIDO | PENDIENTE_DIGEST | FALLIDO
  detalle       String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  colegio Colegio @relation(fields: [colegioId], references: [id])

  @@unique([colegioId, tipoEvento, entidadId, dia])
  @@index([colegioId, estado])
}

// SPEC-159 (FR-001): seguimiento del caso del colegio — 1:1 con la alerta
// (alertaId único), nace LAZY con la primera nota de la bitácora (spec,
// Assumptions). estado es String con valores cerrados (mismo patrón que
// AlertaColegio.estado): en_seguimiento | cerrado. En esta versión no hay
// flujo de cierre manual: queda derivado de la alerta gestionada.
model SeguimientoCaso {
  id            String   @id @default(cuid())
  colegioId     String
  alertaId      String   @unique
  estado        String   @default("en_seguimiento") // en_seguimiento | cerrado
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  colegio    Colegio              @relation(fields: [colegioId], references: [id])
  alerta     AlertaColegio        @relation(fields: [alertaId], references: [id])
  notas      NotaSeguimiento[]
  // SPEC-350 (A-69 C3): análisis IA del caso (misma tubería de SPEC-341).
  analisisIa AnalisisExpediente[]
  // SPEC-351 (A-69 C5): informes firmados del caso (historial inmutable).
  informes   InformeCaso[]

  @@index([colegioId, estado])
}

// SPEC-159 (FR-001): nota de la bitácora — "lo actuado", INMUTABLE por
// construcción (no existe PATCH ni DELETE: respaldo forense, Ley 1581). Texto
// plano 1..1000 chars (Zod en el endpoint; React escapa al renderizar).
// colegioId denormalizado del seguimiento: tenant obligatorio por
// construcción (E-1) sin pasar por el join.
model NotaSeguimiento {
  id            String   @id @default(cuid())
  seguimientoId String
  colegioId     String
  texto         String
  autorId       String
  creadoEn      DateTime @default(now())

  seguimiento SeguimientoCaso @relation(fields: [seguimientoId], references: [id])
  colegio     Colegio         @relation(fields: [colegioId], references: [id])
  autor       Usuario         @relation(fields: [autorId], references: [id])

  @@index([seguimientoId, creadoEn])
}

// ============================================
// MÓDULO DE REPORTES COMUNITARIOS (FASE 2)
// ============================================

model Plataforma {
  id        String   @id @default(cuid())
  clave     String   @unique
  nombre    String
  categoria String   @default("otro")
  esActiva  Boolean  @default(true)
  creadoEn  DateTime @default(now())

  reportes                  Reporte[]
  identificadores           IdentificadorReportado[]
  alertasSuscripcion        AlertaSuscripcion[]
  identificadoresContacto   IdentificadorContacto[]
  identificadoresHijo       IdentificadorHijo[]
  identificadoresEstudiante IdentificadorEstudiante[]
  identificadoresAcudiente  IdentificadorAcudiente[]
  identificadoresProfesor   IdentificadorProfesor[]
  // SPEC-380 (PR B · C4): backref para reportes/matching por plataforma.
  identificadoresIntegranteComite IdentificadorIntegranteComite[]
  apelaciones               Apelacion[]
  patronesInstitucionales   PatronInstitucional[]

  @@index([clave])
  @@index([esActiva])
}

// SPEC-320 (§2.3): catálogo único de tipos de documento, administrable por el
// ADMIN. Fuente única de verdad del vocabulario de "tipo de documento" que
// consumen estudiante, profesor y comité — reemplaza los tres vocabularios
// paralelos previos (enum Zod estudiante, enum Prisma comité, etiquetas hardcode).
// Mismo patrón de catálogo que Plataforma (clave @unique / nombre / esActiva).
model TipoDocumento {
  id        String   @id @default(cuid())
  clave     String   @unique
  nombre    String
  categoria String   @default("persona")
  esActiva  Boolean  @default(true)
  creadoEn  DateTime @default(now())

  @@index([clave])
  @@index([esActiva])
}

model Pais {
  id       String   @id @default(cuid())
  codigo   String   @unique
  nombre   String
  esActivo Boolean  @default(true)
  creadoEn DateTime @default(now())

  ciudades       Ciudad[]
  departamentos  Departamento[]
  usuariosPerfil Usuario[]      @relation("UsuariosPorPais")
  colegios       Colegio[]
  reportes       Reporte[]

  @@index([codigo])
  @@index([esActivo])
}

model Departamento {
  id            String   @id @default(cuid())
  codigo        String?  @unique
  nombre        String
  paisId        String
  esActivo      Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pais     Pais      @relation(fields: [paisId], references: [id])
  ciudades Ciudad[]
  colegios Colegio[]

  @@unique([nombre, paisId])
  @@index([paisId])
  @@index([esActivo])
}

model Ciudad {
  id                String   @id @default(cuid())
  nombre            String
  paisId            String
  departamentoId    String?
  lat               Float?
  lng               Float?
  esActivo          Boolean  @default(true)
  creadoEn          DateTime @default(now())
  // SPEC-115 (catálogo geográfico GeoNames): clave estable del UPSERT y apoyo a la
  // búsqueda en servidor. nombreNormalizado = NFD sin diacríticos, minúsculas
  // (src/lib/normalizar.ts); poblacion ordena los resultados del buscador.
  geonameId         Int?     @unique
  nombreNormalizado String   @default("")
  poblacion         Int?

  pais           Pais          @relation(fields: [paisId], references: [id])
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  usuariosPerfil Usuario[]     @relation("UsuariosPorCiudad")
  colegios       Colegio[]
  reportes       Reporte[]
  // SPEC-388 (A-75 · L1a): profesionales que dicen atender en esta ciudad.
  perfilesProfesionales PerfilProfesional[]

  @@unique([nombre, paisId])
  @@index([paisId])
  @@index([departamentoId])
  @@index([esActivo])
  @@index([paisId, nombreNormalizado])
}

model Reporte {
  id                         String             @id @default(cuid())
  identificador              String
  plataformaId               String
  texto                      String             @db.Text
  textoOriginal              String?            @db.Text
  fechaIncidente             DateTime
  // SPEC-438 (I-305) · ¿la hora es EXACTA o la estimó el reportante?
  //
  // Hasta esta spec, si el formulario se enviaba sin hora, el cliente mandaba
  // `new Date()`: el instante del envío quedaba guardado como la hora del hecho.
  // No es un dato faltante, es un dato FALSO — indistinguible de uno verdadero,
  // alimentando la franja horaria que se le entrega al modelo, el patrón
  // nocturno y un informe con valor probatorio.
  //
  // Ahora la hora es obligatoria, y quien no la recuerda elige una FRANJA. Esa
  // elección queda marcada acá para que el análisis pueda distinguir una hora
  // precisa de una estimada, en vez de tratarlas igual.
  horaAproximada             Boolean  @default(false)
  ciudad                     String
  pais                       String
  paisId                     String?
  ciudadId                   String?
  otraPlataforma             String?
  estado                     EstadoReporte      @default(PENDIENTE)
  esAnonimo                  Boolean            @default(true)
  edadVictima                Int?
  usuarioId                  String?
  // SPEC-295 (002-PI-196 · I-146): rol del origen del reporte. NULL para
  // anónimos (histórico y nuevos). "PARENT" cuando el padre autenticado
  // reporta desde /dashboard/padre/reportar. Fase 2 puede migrar a enum.
  origenRol                  String?
  operadorId                 String?
  comiteId                   String?
  reporteOrigenId            String?
  numeroSeguimiento          String?            @unique
  tenantId                   String?
  processingError            String?            @db.Text
  prioridadAlta              Boolean            @default(false)
  keywordsDetectadas         String[]
  esRafaga                   Boolean            @default(false)
  fuenteConfianza            Float?
  eliminado                  Boolean            @default(false)
  motivoBaja                 MotivoBajaReporte?
  notaBaja                   String?            @db.Text
  eliminadoEn                DateTime?
  eliminadoPorId             String?
  anonimizacionValidadaPorId String?
  anonimizacionValidadaEn    DateTime?
  creadoEn                   DateTime           @default(now())
  actualizadoEn              DateTime           @updatedAt

  plataforma               Plataforma          @relation(fields: [plataformaId], references: [id])
  usuario                  Usuario?            @relation(fields: [usuarioId], references: [id])
  eliminadoPor             Usuario?            @relation(fields: [eliminadoPorId], references: [id], name: "ReportesDadosDeBaja")
  operador                 Usuario?            @relation(fields: [operadorId], references: [id], name: "CasosOperador")
  comite                   Usuario?            @relation(fields: [comiteId], references: [id], name: "CasosComite")
  anonimizacionValidadaPor Usuario?            @relation(fields: [anonimizacionValidadaPorId], references: [id], name: "AnonimizacionesValidadas")
  reporteOrigen            Reporte?            @relation("ReporteDuplicado", fields: [reporteOrigenId], references: [id])
  duplicados               Reporte[]           @relation("ReporteDuplicado")
  clasificacion            ClasificacionIA?
  embedding                EmbeddingReporte?
  fuente                   FuenteReporte?
  tenant                   Tenant?             @relation(fields: [tenantId], references: [id])
  paisRel                  Pais?               @relation(fields: [paisId], references: [id])
  ciudadRel                Ciudad?             @relation(fields: [ciudadId], references: [id])
  transiciones             TransicionReporte[]
  reintentos               ReintentoReporte[]
  pasosProcesamiento       PasoProcesamiento[]
  solicitudComite          SolicitudComite?
  alertasColegio           AlertaColegio[]
  eventoMatchDisparado     EventoMatch?
  // SPEC-230 (002-PI-130): relación inversa para EventoExpediente.
  // Autorizado por ZEUS: no modifica columnas de la tabla reportes.
  eventos                  EventoExpediente[]
  // SPEC-340 (A-68 · hallazgo T002): la CADENA gana casa propia. Antes la
  // vinculación solo existía como EventoExpediente (exigía expediente) — con el
  // expediente ahora manual (botón del padre), la cadena vive en el reporte:
  // null = principal o suelto; con valor = evento de esa cadena. SetNull: si el
  // principal cae por disputa, los eventos quedan ("se muestra lo que queda").
  reportePrincipalId       String?
  reportePrincipal         Reporte?            @relation("CadenaReportes", fields: [reportePrincipalId], references: [id], onDelete: SetNull)
  eventosDeCadena          Reporte[]           @relation("CadenaReportes")

  @@index([reportePrincipalId])
  @@index([identificador, plataformaId])
  @@index([estado])
  @@index([usuarioId, identificador])
  @@index([creadoEn])
  @@index([numeroSeguimiento])
  @@index([paisId])
  @@index([ciudadId])
  @@index([eliminado])
  @@index([eliminadoPorId])
  @@index([operadorId])
  @@index([comiteId])
  @@index([anonimizacionValidadaPorId])
}

model SolicitudComite {
  id                   String    @id @default(cuid())
  reporteId            String    @unique
  numero               String    @unique
  estado               String    @default("PENDIENTE")
  comiteId             String?
  operadorId           String?
  // SPEC-168: escalamiento colegio-scoped al Comité de Convivencia.
  colegioId            String?
  alertaColegioId      String?   @unique
  creadoPorId          String?
  motivo               String    @db.Text
  resolucion           String?   @db.Text
  creadoEn             DateTime  @default(now())
  resueltoEn           DateTime?
  // SPEC-319 §2.4: integrante del comité que firma el cierre (cuenta compartida →
  // trazabilidad de quién decidió). Nullable: cierres previos a la feature quedan sin firma.
  integranteFirmanteId String?

  // SPEC-380 (PR A · C4): análisis del comité EDITABLE durante la deliberación,
  // separado de `resolucion` (que solo se llena al cerrar y ya la lee el
  // informe del caso en informes-caso.ts:193 — no se toca su semántica).
  analisis              String?   @db.Text
  analisisActualizadoEn DateTime?
  analisisPorId         String?
  // SPEC-380 (PR A): "el comité recomienda al rector emitir el informe" — marca
  // temporal + quién la puso. La emisión sigue firmándola el rector.
  recomendacionInformeEn DateTime?
  recomendacionPorId     String?

  reporte            Reporte           @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  comite             Usuario?          @relation(fields: [comiteId], references: [id], name: "SolicitudesComite")
  operador           Usuario?          @relation(fields: [operadorId], references: [id], name: "SolicitudesEscaladas")
  colegio            Colegio?          @relation(fields: [colegioId], references: [id])
  alerta             AlertaColegio?    @relation(fields: [alertaColegioId], references: [id])
  creadoPor          Usuario?          @relation(fields: [creadoPorId], references: [id], name: "SolicitudesCreadasPorColegio")
  integranteFirmante IntegranteComite? @relation(fields: [integranteFirmanteId], references: [id], name: "SolicitudesFirmadas")
  analisisPor        Usuario?          @relation(fields: [analisisPorId], references: [id], name: "SolicitudesAnalisisPor")
  recomendacionPor   Usuario?          @relation(fields: [recomendacionPorId], references: [id], name: "SolicitudesRecomendacionPor")

  @@index([estado])
  @@index([comiteId])
  @@index([operadorId])
  @@index([colegioId])
  @@index([alertaColegioId])
  @@index([creadoPorId])
  @@index([creadoEn])
  @@index([integranteFirmanteId])
  // SPEC-380: consulta "casos con recomendación pendiente" del rector.
  @@index([colegioId, recomendacionInformeEn])
}

model TransicionReporte {
  id              String                @id @default(cuid())
  reporteId       String
  estadoAnterior  EstadoReporte
  estadoNuevo     EstadoReporte
  responsableTipo ResponsableTransicion
  responsableId   String?
  motivo          String?               @db.Text
  metadatos       Json?
  creadoEn        DateTime              @default(now())

  reporte            Reporte  @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  responsableUsuario Usuario? @relation(fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([reporteId])
  @@index([responsableTipo])
  @@index([responsableId])
  @@index([creadoEn])
}

model ReintentoReporte {
  id        String   @id @default(cuid())
  reporteId String
  intento   Int
  exitoso   Boolean  @default(false)
  error     String?  @db.Text
  creadoEn  DateTime @default(now())

  reporte Reporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  @@index([reporteId])
  @@index([creadoEn])
}

// Spec 096-US3: traza de pasos del pipeline (guardas, deduplicación, RAG, métricas).
// Escritura best-effort; onDelete Cascade para no dejar pasos huérfanos (disputas Ley 1581).
model PasoProcesamiento {
  id         String   @id @default(cuid())
  reporteId  String
  etapa      String
  veredicto  String?
  detalle    Json?
  latenciaMs Int?
  creadoEn   DateTime @default(now())

  reporte Reporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  @@index([reporteId, creadoEn])
  @@map("pasos_procesamiento")
}

model FuenteReporte {
  id                   String   @id @default(cuid())
  reporteId            String   @unique
  ipHash               String?
  fingerprintHash      String?
  cuentaDiasAntiguedad Int?
  reportesPrevios      Int      @default(0)
  reportesConfirmados  Int      @default(0)
  reportesDescartados  Int      @default(0)
  pesoAplicado         Float
  creadoEn             DateTime @default(now())

  reporte Reporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  @@index([ipHash])
  @@index([fingerprintHash])
  @@index([creadoEn])
}

model IdentificadorReportado {
  id                    String    @id @default(cuid())
  identificador         String
  plataformaId          String
  totalReportes         Int       @default(0)
  reportesAutenticados  Int       @default(0)
  reportesAnonimos      Int       @default(0)
  // SPEC-131 (BL-5): contadores APROBADOS (predicado único spec 089/D-08), base de la
  // decisión de visibilidad pública. Escritor único: recalcularYGuardarScore.
  reportesAprobados     Int       @default(0)
  autenticadosAprobados Int       @default(0)
  esVisiblePublicamente Boolean   @default(false)
  ocultoPorComiteEn     DateTime?
  score                 Int       @default(0)
  scoreAnonimo          Int       @default(0)
  scoreAutenticado      Int       @default(0)
  scoreAjustado         Int       @default(0)
  nivelRiesgo           String?
  ultimoReporteEn       DateTime?
  creadoEn              DateTime  @default(now())
  actualizadoEn         DateTime  @updatedAt

  plataforma   Plataforma    @relation(fields: [plataformaId], references: [id])
  eventosMatch EventoMatch[]

  @@unique([identificador, plataformaId])
  @@index([esVisiblePublicamente])
  @@index([totalReportes])
  @@index([score])
}

// SPEC-139 (F5): evento de match — un reporte APROBADO (D-08) sobre un identificador
// que ya tenía ≥1 aprobado de OTRO denunciante (huella S-1 o usuarioId).
// Solo metadatos agregados: NUNCA usuarioId, huellas ni textos (FR-009).
// Entidad global (sin tenant): el match cruza tenants como la consulta pública.
model EventoMatch {
  id                    String   @id @default(cuid())
  identificadorId       String
  reporteNuevoId        String   @unique
  conteoAcumulado       Int
  ciudades              String[]
  conductasCoincidentes String[]
  interCiudad           Boolean  @default(false)
  creadoEn              DateTime @default(now())

  identificador IdentificadorReportado @relation(fields: [identificadorId], references: [id])
  reporteNuevo  Reporte                @relation(fields: [reporteNuevoId], references: [id])

  @@index([identificadorId])
  @@index([interCiudad])
  @@index([creadoEn])
  @@map("eventos_match")
}

// SPEC-110: apelación del identificador reportado (reemplazo del módulo eliminado en SPEC-109).
// Flujo: apelante autenticado -> bandeja del comité -> resolución humana motivada.
// Reglas duras: apelar NO cambia visibilidad; el apelante NO ve contenido de reportes.
model Apelacion {
  id                   String          @id @default(cuid())
  numero               String          @unique
  usuarioId            String
  identificador        String
  plataformaId         String
  motivo               String          @db.Text
  esRepresentante      Boolean         @default(false)
  acreditacion         String?         @db.Text
  estado               EstadoApelacion @default(RECIBIDA)
  comiteId             String?
  asignadoEn           DateTime?
  plazoRespuestaEn     DateTime
  decision             String?
  motivacionResolucion String?         @db.Text
  quitoVisibilidad     Boolean         @default(false)
  resueltoPorId        String?
  resueltoEn           DateTime?
  creadoEn             DateTime        @default(now())
  actualizadoEn        DateTime        @updatedAt

  usuario     Usuario              @relation("ApelacionesUsuario", fields: [usuarioId], references: [id])
  plataforma  Plataforma           @relation(fields: [plataformaId], references: [id])
  comite      Usuario?             @relation("ApelacionesAsignadasComite", fields: [comiteId], references: [id])
  resueltoPor Usuario?             @relation("ApelacionesResueltas", fields: [resueltoPorId], references: [id])
  documentos  DocumentoApelacion[]

  @@index([usuarioId])
  @@index([estado])
  @@index([identificador, plataformaId])
  @@index([creadoEn])
  @@index([resueltoEn])
}

model DocumentoApelacion {
  id             String    @id @default(cuid())
  apelacionId    String
  nombreOriginal String
  rutaArchivo    String
  hashSha256     String
  tamanoBytes    Int
  mimeType       String
  eliminadoEn    DateTime?
  creadoEn       DateTime  @default(now())

  apelacion Apelacion                  @relation(fields: [apelacionId], references: [id], onDelete: Cascade)
  accesos   AccesoDocumentoApelacion[]

  @@index([apelacionId])
  @@index([eliminadoEn])
}

model AccesoDocumentoApelacion {
  id          String   @id @default(cuid())
  documentoId String
  usuarioId   String
  ipAddress   String
  userAgent   String
  accedidoEn  DateTime @default(now())

  documento DocumentoApelacion @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  usuario   Usuario            @relation(fields: [usuarioId], references: [id])

  @@index([documentoId])
  @@index([usuarioId])
}

model ContactoConfianza {
  id            String   @id @default(cuid())
  usuarioId     String
  etiqueta      String?  @db.VarChar(100) // SPEC-325: deprecado en favor de `nombre` (no se borra · aditivo)
  nombre        String?  @db.VarChar(100) // SPEC-325: campo propio (antes solo `etiqueta`)
  parentesco    String?  @db.VarChar(60) // SPEC-325: campo propio (madre/tío/amigo…)
  nota          String?  @db.Text
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuario         Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  identificadores IdentificadorContacto[]

  @@index([usuarioId, activo])
  @@index([usuarioId, creadoEn])
}

// ─── SPEC-325 (002-PI-225) · "A quién protejo" — módulo de hijos/familiares ───
// PII de menor: acceso solo por el padre dueño, nunca por id suelto en URL, sin
// logs con el documento en claro. Entidad separada de `ContactoConfianza`
// (protejo lleva documento obligatorio, vigilo no), pero UN mismo mecanismo de
// monitoreo (el cruce identificador→alerta es uno solo).
//
// SPEC-339 (A-67 · D-4, 31-08-2026): la ficha del menor tiene DUEÑO. Antes era
// global y única por documento en todo el sistema, y dos padres compartían la
// misma fila — con tres consecuencias verificadas: el interruptor del menor era
// compartido (un padre le apagaba los avisos al otro), el de cada identificador
// también, y corregir los datos del menor le reescribía la ficha al otro padre.
//
// Regla de Jelkin (31-08-2026): "si otro padre se registra con un correo
// diferente y quiere vincular los mismos hijos, no pasa absolutamente nada" —
// cada padre tiene su lista, sus interruptores y sus avisos, independientes.
model Hijo {
  id              String   @id @default(cuid())
  // SPEC-339: dueño de la ficha. Cascade porque la ficha no sobrevive a su padre:
  // sin esta regla `usuario.delete` falla por clave foránea y rompe
  // `scripts/limpieza/borrar-padre.ts`, que borra tabla por tabla (defecto A-65).
  usuarioId       String
  nombre          String
  apellidos       String   @default("")
  documentoTipo   String // set cerrado en Zod: RC|TI|CC|CE|PASAPORTE|OTRO (OBLIGATORIO)
  documentoNumero String // OBLIGATORIO
  anioNacimiento  Int? // durable (no `edad`) · consistente con A-58; la UI calcula la edad
  sexo            String? // set cerrado en Zod
  // SPEC-325 (extensión): estado activo/inactivo del hijo (patrón Profesor/Estudiante, A-58).
  estado          String   @default("activo")
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  usuario         Usuario             @relation("HijosDelPadre", fields: [usuarioId], references: [id], onDelete: Cascade)
  identificadores IdentificadorHijo[]
  /// @deprecated SPEC-339 · sin uso desde 31-08-2026 · ver nota en `HijoPadre`.
  padres          HijoPadre[]

  // SPEC-339: la unicidad del documento es POR PADRE, no global. Un mismo padre
  // no repite un documento; dos padres distintos sí pueden tener al mismo menor,
  // cada uno con su propia ficha. Reemplaza a @@unique([documentoTipo, documentoNumero]).
  @@unique([usuarioId, documentoTipo, documentoNumero])
  @@index([usuarioId])
  @@index([documentoTipo, documentoNumero])
  @@index([estado])
}

// Puente padre↔hijo (un niño puede tener dos padres separados · §3.1-bis).
//
// ⚠️ SIN USO desde SPEC-339 (31-08-2026). Existía para que dos padres
// compartieran UNA ficha de menor; desde D-4 cada padre tiene la suya
// (`Hijo.usuarioId`) y este puente dejó de leerse y de escribirse.
//
// NO SE ELIMINA por orden del CEO: si Jelkin revierte la regla de "cada padre
// su propia lista", el puente y sus datos históricos siguen ahí. Cualquier
// código nuevo debe usar `Hijo.usuarioId`, nunca esta tabla.
model HijoPadre {
  id        String   @id @default(cuid())
  hijoId    String
  usuarioId String
  creadoEn  DateTime @default(now())

  hijo    Hijo    @relation(fields: [hijoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([hijoId, usuarioId])
  @@index([usuarioId])
}

model IdentificadorHijo {
  id            String   @id @default(cuid())
  hijoId        String
  valor         String // SPEC-325: guardado normalizado (normalizarIdentificador)
  tipo          String?
  plataformaId  String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  hijo         Hijo                            @relation(fields: [hijoId], references: [id], onDelete: Cascade)
  plataforma   Plataforma?                     @relation(fields: [plataformaId], references: [id])
  desvinculado IdentificadorHijoDesvinculado[]

  @@index([valor])
  @@index([hijoId, activo])
  @@index([plataformaId])
}

// El identificador del hijo era compartido entre los dos padres; "quitar" solo
// lo desvinculaba de la vista de QUIEN lo quitaba, sin borrarlo para el otro.
//
// ⚠️ SIN USO desde SPEC-339 (31-08-2026). Era el parche para compartir una ficha
// de menor entre dos padres; con ficha propia (`Hijo.usuarioId`) quitar un
// identificador es quitarlo de verdad, y este mecanismo perdió su razón de ser.
//
// NO SE ELIMINA por orden del CEO: reversible si Jelkin revierte la regla D-4.
model IdentificadorHijoDesvinculado {
  id              String   @id @default(cuid())
  identificadorId String
  usuarioId       String
  creadoEn        DateTime @default(now())

  identificador IdentificadorHijo @relation(fields: [identificadorId], references: [id], onDelete: Cascade)
  usuario       Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([identificadorId, usuarioId])
  @@index([usuarioId])
}

model IdentificadorContacto {
  id            String   @id @default(cuid())
  contactoId    String
  valor         String
  tipo          String?
  plataformaId  String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  contacto   ContactoConfianza @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  plataforma Plataforma?       @relation(fields: [plataformaId], references: [id])

  @@unique([contactoId, valor, plataformaId])
  @@index([valor])
  @@index([contactoId, activo])
  @@index([plataformaId])
}

model AlertaSuscripcion {
  id            String    @id @default(cuid())
  usuarioId     String
  identificador String
  plataformaId  String
  activa        Boolean   @default(true)
  ultimoEmailEn DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  plataforma Plataforma @relation(fields: [plataformaId], references: [id])

  @@unique([usuarioId, identificador, plataformaId])
  @@index([usuarioId])
  @@index([identificador, plataformaId])
  @@index([activa])
}

model ClasificacionIA {
  id                    String            @id @default(cuid())
  reporteId             String            @unique
  categoria             CategoriaConducta
  confianza             Float
  contienePii           Boolean           @default(false)
  piiDetectada          String[]
  modeloUsado           String
  latenciaMs            Int
  promptTokens          Int?
  responseTokens        Int?
  rawResponse           String?           @db.Text
  categoriasSecundarias Json?
  votos                 Json?
  usoCascada            Boolean           @default(false)
  modeloCascada         String?
  posibleAgresorPar     Boolean           @default(false)
  // SPEC-398 (I-286): nombre del modelo si el caller pidió override intencional
  // (sandbox/A-B del admin). `NULL` = pipeline real → jurado completo esperado.
  // La alarma `senalJuradoReducido` filtra por `overrideModeloUsado IS NULL`
  // para distinguir el degradado del comité del uso deliberado del sandbox.
  // Se guarda el nombre (no un bool) para trazabilidad: sabemos qué se probó.
  overrideModeloUsado   String?
  creadoEn              DateTime          @default(now())

  reporte      Reporte                    @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  correccion   CorreccionAdmin?
  rubricaVotos ClasificacionRubricaVoto[]

  @@index([categoria])
  @@index([confianza])
}

model CorreccionAdmin {
  id                 String            @id @default(cuid())
  clasificacionId    String            @unique
  categoriaOriginal  CategoriaConducta
  categoriaCorregida CategoriaConducta
  adminId            String
  motivo             String?           @db.Text
  confirmada         Boolean           @default(false)
  creadoEn           DateTime          @default(now())

  clasificacion    ClasificacionIA        @relation(fields: [clasificacionId], references: [id], onDelete: Cascade)
  admin            Usuario                @relation(fields: [adminId], references: [id])
  datasetRegistros DatasetEntrenamiento[]

  @@index([adminId])
}

model DatasetEntrenamiento {
  id                     String            @id @default(cuid())
  texto                  String            @db.Text
  clasificacionCorrecta  CategoriaConducta
  fuente                 String
  correccionId           String?
  usadoParaEntrenamiento Boolean           @default(false)
  textoAnonimizado       Boolean           @default(false)
  creadoEn               DateTime          @default(now())

  correccion CorreccionAdmin?  @relation(fields: [correccionId], references: [id])
  embedding  EmbeddingDataset?

  @@index([usadoParaEntrenamiento])
}

model EmbeddingDataset {
  id          String                     @id @default(cuid())
  datasetId   String                     @unique
  // Índice hnsw sobre vector creado por migración SQL manual (20260717002004_add_pgvector_hnsw_indexes).
  // Prisma no lo gestiona; verificar que exista tras cada migrate deploy.
  vector      Unsupported("vector(768)")
  modeloUsado String
  creadoEn    DateTime                   @default(now())

  dataset DatasetEntrenamiento @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model EmbeddingReporte {
  id          String                     @id @default(cuid())
  reporteId   String                     @unique
  // Índice hnsw sobre vector creado por migración SQL manual (20260717002004_add_pgvector_hnsw_indexes).
  // Prisma no lo gestiona; verificar que exista tras cada migrate deploy.
  vector      Unsupported("vector(768)")
  modeloUsado String
  creadoEn    DateTime                   @default(now())

  reporte Reporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)
}

model RateLimit {
  key           String   @id
  scope         String
  identifier    String
  windowStart   DateTime
  count         Int      @default(0)
  createdAt     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([scope, identifier, windowStart])
}

model SimulacionRun {
  id           String              @id @default(cuid())
  modelo       String
  totalCasos   Int                 @default(0)
  progreso     Int                 @default(0)
  estado       String              @default("PENDIENTE") // PENDIENTE | EN_PROGRESO | COMPLETADA | FALLIDA | CANCELADA
  fechaInicio  DateTime            @default(now())
  fechaFin     DateTime?
  metricasJson Json?
  casosJson    Json? // Set de casos cargado (persistido para reejecución / comparación)
  creadoPorId  String
  creadoPor    Usuario             @relation(fields: [creadoPorId], references: [id])
  casos        SimulacionReporte[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([estado])
  @@index([creadoPorId])
  @@map("simulacion_runs")
}

model SimulacionReporte {
  id                 String        @id @default(cuid())
  simulacionRunId    String
  simulacionRun      SimulacionRun @relation(fields: [simulacionRunId], references: [id], onDelete: Cascade)
  reporteId          String        @unique
  indice             Int
  categoriaEsperada  String?
  secundariaEsperada String?
  createdAt          DateTime      @default(now())

  @@index([simulacionRunId])
  @@index([indice])
  @@index([reporteId])
  @@map("simulacion_reportes")
}

// SPEC-184 (002-PI-079): bloqueo persistente de IPs por ipHash.
model BlockList {
  id            String    @id @default(cuid())
  ipHash        String    @unique @map("ipHash")
  ipOriginal    String?   @map("ipOriginal")
  motivo        String    @map("motivo")
  expiraEn      DateTime? @map("expiraEn")
  creadoPorId   String    @map("creadoPorId")
  creadoEn      DateTime  @default(now()) @map("creadoEn")
  actualizadoEn DateTime  @updatedAt @map("actualizadoEn")

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])

  @@index([ipHash])
  @@map("block_list")
}

// SPEC-184 (002-PI-079): corrida del simulador de abusos (reportes reales).
model SimulacionAbusoRun {
  id             String   @id @default(cuid())
  escenario      String
  totalReportes  Int
  progreso       Int      @default(0)
  estado         String   @default("PENDIENTE") // PENDIENTE | EN_PROGRESO | COMPLETADA | CANCELADA | FALLIDA
  configJson     Json?
  resultadosJson Json?
  nota           String?  @db.VarChar(200)
  creadoPorId    String
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])

  @@index([estado])
  @@index([creadoPorId])
  @@map("simulacion_abuso_runs")
}

model ModuloPermisible {
  id            String   @id @default(cuid())
  clave         String   @unique
  nombre        String
  descripcion   String?
  padreId       String?
  categoria     String
  esCritico     Boolean  @default(false)
  orden         Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  padre      ModuloPermisible?  @relation("JerarquiaModulos", fields: [padreId], references: [id], onDelete: Restrict)
  submodulos ModuloPermisible[] @relation("JerarquiaModulos")
  permisos   PermisoModulo[]

  @@index([padreId])
}

model PermisoModulo {
  id               String   @id @default(cuid())
  rol              String
  moduloId         String
  activo           Boolean  @default(false)
  actualizadoPorId String?
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  modulo         ModuloPermisible @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  actualizadoPor Usuario?         @relation(fields: [actualizadoPorId], references: [id])

  @@unique([rol, moduloId])
  @@index([rol])
}

model ClasificacionRubricaVoto {
  id                String          @id @default(cuid())
  clasificacionIAId String
  clasificacionIA   ClasificacionIA @relation(fields: [clasificacionIAId], references: [id], onDelete: Cascade)
  modelo            String
  categoria         String
  cumple            Boolean
  preguntasJson     Json
  creadoEn          DateTime        @default(now())

  @@index([clasificacionIAId])
  @@map("clasificacion_rubrica_votos")
}

// SPEC-132 (S-4): sesión de carga masiva — el roster de alumnos vive server-side
// con TTL; el token de confirmación firma SOLO el id de esta sesión (sin PII).
model CargaRosterSesion {
  id        String   @id @default(cuid())
  colegioId String
  filas     Json
  creadoEn  DateTime @default(now())
  expiraEn  DateTime

  colegio Colegio @relation(fields: [colegioId], references: [id], onDelete: Cascade)

  @@index([expiraEn])
}

// SPEC-160 (002-PI-059): marcado quirúrgico de entidades demo para purga idempotente.
// La purga borra EXCLUSIVAMENTE por registros de esta tabla (por id); los prefijos
// DEMO-/RPT-DEMO- y los emails @innovadataco.com son defensa en profundidad.
model DemoMarcado {
  id        String   @id @default(cuid())
  entidad   String // nombre de la tabla Prisma/BD: Colegio, Curso, Estudiante, Usuario, Reporte, AuditLog, ...
  entidadId String
  metadata  Json? // { corrida: string, script: string, notas?: string }
  creadoEn  DateTime @default(now())

  @@unique([entidad, entidadId])
  @@index([entidad])
  @@index([entidadId])
  @@map("demo_marcado")
}

// SPEC-171 (Pilar B, I-51): probes de salud de infraestructura (append-only,
// retención corta; los escribe scripts/monitor-probes.mjs).
// SPEC-186 (002-PI-081): añade metodo para distinguir PING / PIGGYBACK / SMOKE.
model HealthProbe {
  id         String   @id @default(cuid())
  senal      String // app | worker | bd | ollama_ping | ollama_smoke | tailscale
  ok         Boolean
  latenciaMs Int      @default(0)
  detalle    String?
  metodo     String?  @default("SMOKE") // PING | PIGGYBACK | SMOKE
  creadoEn   DateTime @default(now())

  @@index([senal, creadoEn])
}

// SPEC-171: incidente de infraestructura abierto tras doble rojo (re-probe).
// Se resuelve solo cuando el probe vuelve a verde. Email con throttle por senal.
model IncidenteInfra {
  id            String    @id @default(cuid())
  senal         String // misma nomenclatura que HealthProbe.senal
  estado        String    @default("ABIERTO") // ABIERTO | RESUELTO
  inicio        DateTime  @default(now())
  fin           DateTime?
  detalle       String?
  ultimoEmailEn DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@index([senal, estado])
}

// SPEC-193 (Fase 1): bitácora de logs de workers y servicios.
// No almacena PII ni texto de reportes; retención acotada por purga explícita.
model WorkerLog {
  id           String   @id @default(cuid())
  servicio     String
  nivel        NivelLog
  mensaje      String   @db.VarChar(500)
  contextoJson Json?
  creadoEn     DateTime @default(now()) @db.Timestamptz(3)

  @@index([servicio, creadoEn(sort: Desc)], name: "idx_worker_logs_servicio_creado")
  @@index([nivel, creadoEn(sort: Desc)], name: "idx_worker_logs_nivel_creado")
  @@index([creadoEn(sort: Desc)], name: "idx_worker_logs_creado")
  @@map("worker_logs")
}

// SPEC-172 (Pilar D.5): snapshot semanal de la deriva del motor en producción
// por categoría (tasa de corrección humana confirmada vs accuracy del banco
// curado). Lo escribe el job semanal y el recálculo bajo demanda; el tablero
// solo lee (cero groupBys pesados por carga).
model DerivaMotorSnapshot {
  id             String   @id @default(cuid())
  semanaInicio   DateTime // lunes 00:00 America/Bogota de la semana medida
  categoria      String // CategoriaConducta
  total          Int // clasificaciones de producción en la ventana
  correcciones   Int // correcciones humanas confirmadas en la ventana
  tasaCorreccion Float // correcciones / total (0 si total = 0)
  accuracyBanco  Float? // recall por categoría del último SimulacionRun COMPLETADA (null = sin baseline)
  brechaPp       Float? // tasaCorreccion − (1 − accuracyBanco), en puntos porcentuales (null = sin baseline)
  alertada       Boolean  @default(false)
  creadoEn       DateTime @default(now())

  @@unique([semanaInicio, categoria])
  @@index([semanaInicio])
}

// SPEC-230 (002-PI-130): expediente que agrupa eventos sobre un identificador
// reportado, visto/desde la perspectiva del padre/tutor.
model Expediente {
  id                              String           @id @default(cuid())
  padreUsuarioId                  String
  identificadorReportado          String
  plataformaId                    String?
  fechaApertura                   DateTime         @db.Timestamptz(6)
  fechaCierre                     DateTime?        @db.Timestamptz(6)
  fechaEscalado                   DateTime?        @db.Timestamptz(6)
  estado                          EstadoExpediente
  // SPEC-340 (A-68 §4): quién creó el expediente. "AUTOMATICO" = los legados de
  // SPEC-323 (la creación al 2º reporte, DEROGADA); "PADRE" = el botón. El
  // default documenta el pasado sin backfill.
  origenCreacion                  String           @default("AUTOMATICO")
  scoreGravedadActual             ScoreGravedad    @default(VERDE)
  categoriasDominantesJson        Json?
  numEventos                      Int              @default(0)
  ultimoEventoEn                  DateTime?        @db.Timestamptz(6)
  autoCerradoPorInactividad       Boolean          @default(false)
  expedienteRelacionadoAnteriorId String?
  patronesDetectadosJson          Json?
  createdAt                       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime         @updatedAt @db.Timestamptz(6)

  padre                  Usuario?              @relation(fields: [padreUsuarioId], references: [id])
  eventos                EventoExpediente[]
  // SPEC-234 (002-PI-134): informes consolidados y patrones N1 del expediente.
  informes               InformeConsolidado[]
  patrones               PatronExpediente[]
  expedienteAnterior     Expediente?           @relation("ExpedienteRelacionado", fields: [expedienteRelacionadoAnteriorId], references: [id])
  expedientesPosteriores Expediente[]          @relation("ExpedienteRelacionado")
  // SPEC-238 (002-PI-mega-cola): aclaración padre-comité (máx. una por expediente).
  aclaracion             AclaracionExpediente?
  // SPEC-239 (002-PI-mega-cola): SLA efectivo y marca de escalamiento a ROJO.
  slaEfectivoHoras       Int?
  fechaEscaladoRojoEn    DateTime?             @db.Timestamptz(6)
  // SPEC-340: historial inmutable de informes del padre.
  informesPadre          InformePadre[]
  // SPEC-341 (A-68 §4.4 capa 2): análisis IA en fila del expediente.
  analisisIa             AnalisisExpediente[]
  // SPEC-388 (A-75 · L1a): solicitudes de cita que compartieron este expediente
  // con un profesional (opcional; el padre lo comparte y puede revocarlo).
  solicitudesCitaCompartidas SolicitudCita[]

  @@index([padreUsuarioId, estado])
  @@index([identificadorReportado])
  @@index([estado, updatedAt(sort: Desc)])
  // SPEC-236 (002-PI-mega-cola): barridos del worker (auto-cierre por inactividad, SLA).
  @@index([estado, ultimoEventoEn])
  // SPEC-239 (002-PI-mega-cola): vigilancia del SLA 12h de expedientes ROJO.
  @@index([scoreGravedadActual, estado, fechaEscaladoRojoEn])
}

// SPEC-230 (002-PI-130): evento dentro de un expediente padre.
model EventoExpediente {
  id                     String   @id @default(cuid())
  expedienteId           String
  ordenSecuencial        Int
  reporteId              String?
  fechaEvento            DateTime @db.Timestamptz(6)
  texto                  String   @db.Text
  categoriaDetectada     String?
  confianzaClasificacion Float?
  plataforma             String?
  adjuntosMetaJson       Json?
  createdAt              DateTime @default(now()) @db.Timestamptz(6)

  expediente Expediente @relation(fields: [expedienteId], references: [id])
  reporte    Reporte?   @relation(fields: [reporteId], references: [id])

  @@unique([expedienteId, ordenSecuencial])
  // SPEC-323: un reporte entra UNA sola vez al expediente. Postgres admite varios
  // NULL en un índice único, así que el alta manual del padre (sin reporteId) no se toca.
  @@unique([expedienteId, reporteId])
  @@index([expedienteId, fechaEvento(sort: Desc)])
}

// SPEC-234 (002-PI-134): informe consolidado de un expediente padre. Resultado
// inmutable de la compilación; cada versión conserva el estado del expediente en
// un momento dado. NUNCA incluye texto original de reportes.
/// SPEC-340 (A-68 §4.3) · el historial INMUTABLE de informes del padre.
///
/// NO es InformeConsolidado: aquel es del flujo de COMITÉ y arrastra score y
/// estado de aprobación — prohibidos para el padre (nada de puntajes). Este
/// registro no tiene campos editables y su servicio solo crea y lista: no
/// existe update ni delete en ninguna capa. "Es parte de la evidencia."
model InformePadre {
  id                 String   @id @default(cuid())
  expedienteId       String
  numeroSecuencial   Int
  pdfHash            String   @unique
  codigoVerificacion String
  generadoEn         DateTime @default(now()) @db.Timestamptz(6)
  generadoPorId      String

  expediente  Expediente @relation(fields: [expedienteId], references: [id])
  generadoPor Usuario    @relation("InformesPadreGenerados", fields: [generadoPorId], references: [id])

  @@unique([expedienteId, numeroSecuencial])
  @@index([expedienteId, generadoEn(sort: Desc)])
}

model InformeConsolidado {
  id                             String             @id @default(cuid())
  expedienteId                   String
  versionSecuencial              Int
  scoreValor                     Float
  scoreGravedad                  ScoreGravedad
  categoriasDetectadasJson       Json
  patronesDetectadosJson         Json?
  senalComunitariaJson           Json?
  resumenTextoGenerado           String             @db.Text
  pdfUrl                         String?
  pdfHash                        String?            @unique
  pdfGeneradoEn                  DateTime?          @db.Timestamptz(6)
  generadoPorId                  String?
  tipoRevision                   TipoRevisionComite @default(CONSOLIDACION_EXPEDIENTE)
  guiaAccionCategoriaIdPrincipal String?
  estadoAprobacion               String             @default("PENDIENTE_COMITE")
  aprobadoPorMiembrosJson        Json?
  correccionesJson               Json?
  nivelConfianza                 Float?
  // SPEC-237 (002-PI-mega-cola): motivo de devolución al área de origen.
  motivoDevolucion               String?            @db.Text
  createdAt                      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime           @updatedAt @db.Timestamptz(6)

  expediente   Expediente             @relation(fields: [expedienteId], references: [id])
  generadoPor  Usuario?               @relation(fields: [generadoPorId], references: [id])
  // SPEC-238 (002-PI-mega-cola): aclaraciones vinculadas a este informe.
  aclaraciones AclaracionExpediente[]

  @@unique([expedienteId, versionSecuencial])
  @@index([expedienteId, createdAt(sort: Desc)])
  @@index([estadoAprobacion])
  @@map("informes_consolidados")
}

// SPEC-234 (002-PI-134): caché de agregados comunitarios por identificador reportado.
// Solo conteos agregados; nunca textos, nombres ni datos re-identificables.
model SenalComunitariaCache {
  identificadorReportado    String   @id
  totalExpedientesActivos   Int      @default(0)
  totalExpedientesCerrados  Int      @default(0)
  totalExpedientesEscalados Int      @default(0)
  categoriasFrecuenciaJson  Json
  primeraAparicionEn        DateTime @db.Timestamptz(6)
  ultimaAparicionEn         DateTime @db.Timestamptz(6)
  paisesJson                Json
  ciudadesJson              Json
  plataformasJson           Json
  invalidado                Boolean  @default(false)
  actualizadoEn             DateTime @updatedAt @db.Timestamptz(6)

  @@index([ultimaAparicionEn(sort: Desc)])
  @@map("senal_comunitaria_cache")
}

// SPEC-234 (002-PI-134): patrón N1 detectado dentro de un expediente padre.
model PatronExpediente {
  id                String               @id @default(cuid())
  expedienteId      String
  tipoPatron        TipoPatronExpediente
  severidad         String // "BAJA" | "MEDIA" | "ALTA"
  nivelConfianza    Float
  descripcionTexto  String               @db.Text
  datosContextoJson Json
  detectadoEn       DateTime             @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)

  expediente Expediente @relation(fields: [expedienteId], references: [id])

  @@index([expedienteId, severidad])
  @@index([expedienteId, tipoPatron])
  @@map("patrones_expediente")
}

// SPEC-235 (002-PI-135): guía de acción parametrizable por categoría de riesgo.
// El contenido es editorial, validado por el comité y publicado de forma atómica.
// La unicidad de una guía ACTIVA por categoría se garantiza con un índice único
// parcial SQL (ver migración aditiva); Prisma no modela índices condicionales.
model GuiaAccionCategoria {
  id                    String           @id @default(cuid())
  categoria             String
  versionSecuencial     Int
  tituloEmocional       String
  subtitulo             String?
  categoriaBadgeTexto   String
  pasosJson             Json
  calloutTitulo         String?
  calloutTexto          String?
  botonesAccionJson     Json
  piePagina             String?
  estado                EstadoGuiaAccion
  aprobadaPorComiteJson Json             @default("[]")
  creadaPorAdminId      String
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  publicadaEn           DateTime?        @db.Timestamptz(6)
  reemplazadaEn         DateTime?        @db.Timestamptz(6)

  creadaPor         Usuario              @relation(fields: [creadaPorAdminId], references: [id])
  // SPEC-341: análisis IA que la resuelven como "Qué puedes hacer ahora".
  analisisQueLaUsan AnalisisExpediente[]

  @@index([categoria, estado])
  @@index([estado])
  @@index([creadaPorAdminId])
  @@map("GuiaAccionCategoria")
}

// ============================================
// MÓDULO DE NOTIFICACIONES (SPEC-201)
// ============================================

enum EstadoNotificacion {
  ENCOLADA
  ENVIANDO
  ENVIADA
  ABIERTA
  CLICADA
  FALLIDA
  REINTENTANDO
  CANCELADA
}

enum CanalNotificacion {
  EMAIL
  IN_APP
}

// SPEC-201 (BRIEF §5.1): cola + auditoría de envíos individuales.
// El campo `proveedorId` es la clave de idempotencia de webhooks (Resend).
model Notificacion {
  id                    String             @id @default(cuid())
  evento                String
  destinatarioUsuarioId String?
  destinatarioEmail     String
  plantillaClave        String
  canal                 CanalNotificacion
  variables             Json
  sujetoTipo            String?
  sujetoId              String?
  enviarEn              DateTime?          @db.Timestamptz(6)
  estado                EstadoNotificacion @default(ENCOLADA)
  intentos              Int                @default(0)
  ultimoError           String?
  proveedorId           String?
  sentAt                DateTime?          @db.Timestamptz(6)
  deliveredAt           DateTime?          @db.Timestamptz(6)
  openedAt              DateTime?          @db.Timestamptz(6)
  clickedAt             DateTime?          @db.Timestamptz(6)
  bouncedAt             DateTime?          @db.Timestamptz(6)
  canceladoEn           DateTime?          @db.Timestamptz(6)
  motivoCancelacion     String?
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)

  @@index([estado, enviarEn])
  @@index([destinatarioUsuarioId, createdAt(sort: Desc)])
  @@index([evento, createdAt(sort: Desc)])
  @@index([proveedorId])
  @@map("notificaciones")
}

// SPEC-201 (BRIEF §5.2): plantillas Markdown por canal.
model NotificacionPlantilla {
  id              String            @id @default(cuid())
  clave           String            @unique
  canal           CanalNotificacion
  asunto          String?
  cuerpoMarkdown  String
  variablesSchema Json              @default("{}")
  version         Int               @default(1)
  activa          Boolean           @default(true)
  creadaPor       String?
  actualizadaPor  String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  actualizadoEn   DateTime          @updatedAt @db.Timestamptz(6)

  @@map("notificacion_plantillas")
}

// SPEC-201 (BRIEF §5.3): reglas programables de disparo.
model NotificacionRegla {
  id             String            @id @default(cuid())
  evento         String
  rol            String
  offset         String
  canal          CanalNotificacion
  plantillaClave String
  obligatoria    Boolean           @default(false)
  activa         Boolean           @default(true)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  actualizadaPor String?
  actualizadaEn  DateTime          @updatedAt @db.Timestamptz(6)

  // SPEC-247 (002-PI-150): dedup de reglas por clave canónica.
  // SPEC-333 (002-PI-233 · I-223): la identidad incluye `rol` — dos roles del mismo
  // (evento, canal, plantillaClave) son reglas distintas (des-colapso multi-rol).
  @@unique([evento, canal, plantillaClave, rol])
  @@index([evento, activa])
  @@map("notificacion_reglas")
}

// SPEC-201 (BRIEF §5.4): preferencias de opt-out del usuario final.
// La clave `eventoRegla` es "evento.canal" (ej: "reporte.resuelto.email").
model NotificacionPreferencia {
  id          String   @id @default(cuid())
  usuarioId   String
  eventoRegla String
  habilitado  Boolean  @default(true)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@unique([usuarioId, eventoRegla])
  @@index([usuarioId])
  @@map("notificacion_preferencias")
}

// SPEC-201 (BRIEF §5.5): destinos con bounces reiterados.
model NotificacionContactoBloqueado {
  id                String    @id @default(cuid())
  email             String    @unique
  bounceCount       Int       @default(1)
  ultimoBounce      DateTime  @db.Timestamptz(6)
  motivo            String
  bloqueadoEn       DateTime  @default(now()) @db.Timestamptz(6)
  notificadoAdminEn DateTime? @db.Timestamptz(6)

  @@index([email])
  @@map("notificacion_contactos_bloqueados")
}

// ─────────────────────────────────────────────────────────────────────────────
// SPEC-220 (002-PI-121): dominio Análisis dinero-vs-valor. Score de valor por
// cliente (snapshot mensual con pesos congelados) + tablas base que consumen
// SPEC-221 (motor de reglas), SPEC-223 (digest) y SPEC-225 (anomalías).
// Sin PII por construcción: conteos, pesos, plantillas y metadatos; nunca texto
// de reportes ni datos de menores.

enum ModoRegla {
  RECOMIENDA
  EJECUTA
}

enum EstadoRecomendacion {
  PENDIENTE
  APLICADA
  IGNORADA
  EXPIRADA
}

// SPEC-220 (FR-001): snapshot mensual del score de valor de una suscripción.
// `periodo` = "YYYY-MM" en mes calendario America/Bogota. Los `peso*` son el
// snapshot de los pesos usados en el cálculo (auditoría del histórico).
model ScoreCliente {
  id                 String   @id @default(cuid())
  suscripcionId      String
  periodo            String // "YYYY-MM" mes calendario America/Bogota
  componenteReportes Int      @default(0)
  componenteCasos    Int      @default(0)
  componenteAlertas  Int      @default(0)
  componenteSesiones Int      @default(0)
  pesoReportes       Float
  pesoCasos          Float
  pesoAlertas        Float
  pesoSesiones       Float
  scoreTotal         Float
  percentilEnCohorte Float?
  calculadoEn        DateTime @default(now()) @db.Timestamptz(6)

  suscripcion Suscripcion @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)

  @@unique([suscripcionId, periodo])
  @@index([periodo, scoreTotal(sort: Desc)])
  @@map("score_clientes")
}

// SPEC-220 (FR-002): definición de una regla de recomendación. La lógica del
// motor corresponde a SPEC-221/224; aquí solo vive la estructura.
model ReglaRecomendacion {
  id                     String    @id @default(cuid())
  clave                  String    @unique // ej: "vencimiento.T_menos_7"
  nombre                 String
  descripcion            String
  categoria              String // "renovacion" | "churn" | "crecimiento" | "anomalia"
  sqlQuery               String
  plantillaRecomendacion String // markdown con {{variables}}
  modo                   ModoRegla @default(RECOMIENDA)
  accionEjecutable       String?
  accionParametros       Json?
  prioridad              Int       @default(50) // 0=baja, 100=alta
  umbralMinimo           Float?
  frecuenciaMin          Int       @default(60)
  activa                 Boolean   @default(true)
  creadaPorAdminId       String
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(6)
  // SPEC-221 (002-PI-122): última corrida del motor; gobierna la cadencia por frecuenciaMin.
  ultimaEvaluacionEn     DateTime? @db.Timestamptz(6)

  creadaPor       Usuario                       @relation(fields: [creadaPorAdminId], references: [id])
  recomendaciones Recomendacion[]
  // SPEC-224 (002-PI-125): versionado auditable; historial de snapshots previos.
  version         Int                           @default(1)
  historial       ReglaRecomendacionHistorial[]

  @@index([activa, prioridad(sort: Desc)])
  @@map("reglas_recomendacion")
}

// SPEC-220 (FR-003): instancia generada de una regla. `sujetoTipo`/`sujetoId`
// son polimórficos sin FK (patrón deliberado del brief §5.4; la integridad la
// garantiza la capa de servicio en las SPECs consumidoras).
model Recomendacion {
  id                  String              @id @default(cuid())
  reglaId             String
  titulo              String
  descripcion         String
  categoria           String
  prioridad           Int
  sujetoTipo          String? // "Suscripcion" | "Colegio" | "Usuario" (polimórfico, sin FK)
  sujetoId            String?
  datosContexto       Json
  accionSugerida      String?
  accionParametros    Json?
  estado              EstadoRecomendacion @default(PENDIENTE)
  generadaEn          DateTime            @default(now()) @db.Timestamptz(6)
  resueltaEn          DateTime?           @db.Timestamptz(6)
  resueltaPorAdminId  String?
  motivoResolucion    String?
  expiraEn            DateTime            @db.Timestamptz(6)
  ejecutadaAutomatica Boolean             @default(false)

  regla       ReglaRecomendacion @relation(fields: [reglaId], references: [id])
  resueltaPor Usuario?           @relation(fields: [resueltaPorAdminId], references: [id])
  // SPEC-226 (002-PI-mega-cola): trazabilidad de acciones ejecutadas (aditivo).
  ejecuciones EjecucionAccion[]

  @@index([estado, prioridad(sort: Desc), generadaEn(sort: Desc)])
  @@index([sujetoId])
  // SPEC-221 (002-PI-122): dedup del motor por (regla, sujeto) en PENDIENTE + barrido de expiración.
  @@index([reglaId, sujetoId, estado])
  @@index([expiraEn])
  @@map("recomendaciones")
}

// SPEC-220 (FR-004): resumen semanal generado para un admin. Lógica en SPEC-223.
model DigestSemanal {
  id             String    @id @default(cuid())
  periodo        String // "2026-W34" ISO week America/Bogota
  destinatarioId String
  generadoEn     DateTime  @default(now()) @db.Timestamptz(6)
  enviadoEn      DateTime? @db.Timestamptz(6)
  top5Decisiones Json
  kpisSemana     Json
  kpisVsPrevia   Json
  enlacePanel    String
  estado         String // "generado" | "enviado" | "fallido" (valores cerrados, patrón AlertaColegio.estado)

  destinatario Usuario @relation(fields: [destinatarioId], references: [id])

  @@unique([periodo, destinatarioId])
  @@map("digest_semanal")
}

// SPEC-220 (FR-005): anomalía detectada por reglas. Lógica en SPEC-225.
model Anomalia {
  id                 String    @id @default(cuid())
  tipo               String // "PAGO_ATRASADO_CLIENTE_HISTORICAMENTE_PUNTUAL" | "CRECIMIENTO_ANOMALO_CIUDAD" | "USO_CAIDO_ABRUPTO" | ...
  sujetoTipo         String?
  sujetoId           String?
  severidad          String // "BAJA" | "MEDIA" | "ALTA" (valores cerrados)
  descripcion        String
  datosContexto      Json
  detectadaEn        DateTime  @default(now()) @db.Timestamptz(6)
  resueltaEn         DateTime? @db.Timestamptz(6)
  resueltaPorAdminId String?

  resueltaPor Usuario? @relation(fields: [resueltaPorAdminId], references: [id])

  @@index([tipo, detectadaEn(sort: Desc)])
  @@index([severidad, detectadaEn(sort: Desc)])
  // SPEC-225: acelera la deduplicación por anomalía abierta (resueltaEn IS NULL).
  @@index([resueltaEn])
  @@map("anomalias")
}

// SPEC-238 (002-PI-mega-cola): aclaración padre-comité (1 iteración máx).
// El padre pide UNA aclaración antes de aprobar; el comité responde y el
// expediente vuelve a EN_APROBACION_PADRE. Si el comité no responde dentro del
// SLA (padre.comite.sla_horas_normal), el worker la cierra forzosamente.
// `estado` es String (no enum) según brief §7.4: PENDIENTE | RESPONDIDA |
// CERRADA_FORZOSAMENTE. NUNCA se loguean solicitudTexto/respuestaTexto.
model AclaracionExpediente {
  id                   String    @id @default(cuid())
  expedienteId         String    @unique
  informeConsolidadoId String
  solicitadaEn         DateTime  @default(now()) @db.Timestamptz(6)
  solicitudTexto       String    @db.Text
  respondidaEn         DateTime? @db.Timestamptz(6)
  respondidaPor        String?
  respuestaTexto       String?   @db.Text
  estado               String
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)

  expediente           Expediente         @relation(fields: [expedienteId], references: [id])
  informeConsolidado   InformeConsolidado @relation(fields: [informeConsolidadoId], references: [id])
  respondidaPorUsuario Usuario?           @relation(fields: [respondidaPor], references: [id])

  @@index([expedienteId])
  @@index([informeConsolidadoId])
  @@index([estado])
  @@index([solicitadaEn])
  @@map("aclaracion_expediente")
}

// SPEC-239 (002-PI-mega-cola): relación del contacto de emergencia con el menor.
enum RelacionContactoEmergencia {
  MADRE
  PADRE
  TUTOR
  HERMANO
  OTRO
}

// SPEC-239 (002-PI-mega-cola): contacto de emergencia administrado por el padre.
// El comité solo los lee (activos, por prioridad) para disparar la notificación
// urgente al activar la emergencia de un expediente ROJO. Baja lógica (`activo`)
// para conservar trazabilidad de activaciones históricas (D3). `telefono` se
// valida E.164 en la capa API (Zod). NUNCA se loguea en AuditLog.
model ContactoEmergencia {
  id             String                     @id @default(cuid())
  padreUsuarioId String
  nombre         String
  relacion       RelacionContactoEmergencia
  telefono       String
  email          String?
  prioridad      Int
  activo         Boolean                    @default(true)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                   @updatedAt @db.Timestamptz(6)

  padre Usuario @relation(fields: [padreUsuarioId], references: [id])

  @@index([padreUsuarioId, prioridad])
  @@map("contactos_emergencia")
}

// SPEC-224 (002-PI-125): versionado auditable de reglas de recomendación.
// Snapshot JSON completo del estado ANTERIOR de la regla; se inserta en la
// misma transacción que el update (atomicidad). Solo configuración de reglas
// (SQL, plantillas, umbrales): nunca datos de reportes ni de personas.
model ReglaRecomendacionHistorial {
  id                 String   @id @default(cuid())
  reglaId            String
  version            Int
  snapshot           Json
  motivo             String
  cambiadoPorAdminId String
  creadoEn           DateTime @default(now()) @db.Timestamptz(6)

  regla       ReglaRecomendacion @relation(fields: [reglaId], references: [id])
  cambiadoPor Usuario            @relation(fields: [cambiadoPorAdminId], references: [id])

  @@unique([reglaId, version])
  @@index([reglaId, creadoEn(sort: Desc)])
  @@map("regla_recomendacion_historial")
}

// ── SPEC-226 (002-PI-mega-cola): ejecución de acciones automáticas ──
// Trazabilidad y rollback de cada acción disparada por una regla en modo
// EJECUTA (o aplicada manualmente por un admin). `parametros` es snapshot
// deliberado: si la regla se edita después, la ejecución histórica conserva
// con qué parámetros actuó. `resultado` guarda solo ids de dominio (bono,
// notificaciones programadas, operador): nunca textos de reportes ni PII.
enum TipoAccionEjecutable {
  CREAR_BONO
  ENVIAR_NOTIFICACION
  ASIGNAR_OPERADOR
  CREAR_ALERTA
}

enum EstadoEjecucion {
  EJECUTADA
  REVERTIDA
  FALLIDA
}

enum OrigenEjecucion {
  AUTOMATICA
  MANUAL_ADMIN
}

model EjecucionAccion {
  id                  String               @id @default(cuid())
  recomendacionId     String
  reglaId             String
  tipoAccion          TipoAccionEjecutable
  parametros          Json
  estado              EstadoEjecucion
  resultado           Json?
  motivoFallo         String?
  origenEjecucion     OrigenEjecucion
  ejecutadaPorAdminId String?
  ejecutadaEn         DateTime             @default(now()) @db.Timestamptz(6)
  revertidaEn         DateTime?            @db.Timestamptz(6)
  revertidaPorAdminId String?
  motivoReversion     String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)

  recomendacion Recomendacion @relation(fields: [recomendacionId], references: [id])

  @@index([recomendacionId])
  @@index([reglaId, ejecutadaEn])
  @@index([estado, ejecutadaEn])
  @@map("ejecuciones_accion")
}

// SPEC-341 (A-68 §4.4 capa 2): análisis IA en fila del expediente.
// Uno vigente PUBLICADO por expediente + histórico inmutable (auditoría
// permanente). Se dispara al abrir el expediente si el hash de la cadena
// cambió; se atiende de a uno vía pg-boss con prioridad menor que la
// clasificación de reportes. Ver specs/341-inteligencia-expediente/.
model AnalisisExpediente {
  id                 String             @id @default(cuid())
  // SPEC-350 (A-69 C3): el análisis puede ser de un expediente del PADRE o de
  // un caso del COLEGIO. XOR: exactamente uno de expedienteId/seguimientoCasoId
  // — CHECK constraint crudo en la migración (Prisma no lo expresa) + guard en
  // el DAL. expedienteId era NOT NULL; pasa a nullable por esta razón.
  expedienteId       String?
  seguimientoCasoId  String?
  versionSecuencial  Int
  alcance            AlcanceAnalisis
  hashCadena         String
  corteN             Int
  texto              String             @db.Text
  categoriaDominante CategoriaConducta?
  guiaAccionId       String?
  modeloUsado        String
  promptSistemaHash  String
  latenciaMs         Int
  estado             EstadoAnalisis     @default(GENERANDO)
  motivoFallo        String?
  generadoEn         DateTime           @default(now()) @db.Timestamptz(6)
  publicadoEn        DateTime?          @db.Timestamptz(6)

  expediente      Expediente?          @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  seguimientoCaso SeguimientoCaso?     @relation(fields: [seguimientoCasoId], references: [id], onDelete: Cascade)
  guiaAccion      GuiaAccionCategoria? @relation(fields: [guiaAccionId], references: [id])

  @@unique([expedienteId, versionSecuencial])
  @@unique([seguimientoCasoId, versionSecuencial])
  @@index([expedienteId, estado])
  @@index([expedienteId, hashCadena, estado])
  @@index([expedienteId, versionSecuencial(sort: Desc)])
  @@index([seguimientoCasoId, estado])
  @@index([seguimientoCasoId, hashCadena, estado])
  @@index([estado, generadoEn])
}

enum AlcanceAnalisis {
  PADRE_COMPLETO
  COLEGIO_BLINDADO
}

enum EstadoAnalisis {
  GENERANDO
  PUBLICADO
  FALLIDO
}

// SPEC-351 (A-69 · C5): informe firmado del rector — PDF membreteado del caso.
// INMUTABLE: sin update ni delete en ninguna capa (regla A-68); si el rector
// se equivoca, genera otro. Correlativo INF-AAAA-NNNN por caso y por año
// (Bogotá), serializado con pg_advisory_xact_lock (patrón I-208).
model InformeCaso {
  id                  String   @id @default(cuid())
  casoId              String
  numeroCorrelativo   Int
  anio                Int
  pdfHash             String   @unique
  codigoVerificacion  String   @unique
  firmadoPorNombre    String
  firmadoPorDocumento String
  firmadoPorId        String
  escudoAssetKey      String?
  seccionesJson       Json
  generadoEn          DateTime @default(now()) @db.Timestamptz(6)

  // Audit #221 · ajuste 3 (decisión CEO): SIN Cascade — un informe es evidencia
  // y no se arrastra en silencio (alineado con InformePadre). Los scripts de
  // limpieza lo borran explícito ANTES del caso.
  caso       SeguimientoCaso @relation(fields: [casoId], references: [id])
  firmadoPor Usuario         @relation("InformesCasoFirmados", fields: [firmadoPorId], references: [id])

  @@unique([casoId, anio, numeroCorrelativo])
  @@index([casoId, generadoEn(sort: Desc)])
}

// ── SPEC-388 (A-75 · L1a) · Red de Profesionales ──────────────────────────
// Séptimo actor. El modelo entero se define acá para que los lotes L1b/L2/L3
// arranquen en paralelo sin bloquearse. Ningún endpoint ni UI se toca en L1a
// — este archivo y la migración son todo lo que trae ese PR.
//
// Reutilización deliberada con `Usuario` (candado del CEO 03-09 04:32):
//  · `fechaNacimiento`, `documentoTipo`, `documentoNumero` YA viven en Usuario
//    (SPEC-334/339) y se reusan tal cual — «interno» se cumple en la capa DTO
//    (nunca serializar), no duplicando la tabla.
// Estados y candados que vienen del brief §2/§3:
//  · `EstadoPerfilProfesional.BORRADOR` — inicial, entre «creó la cuenta» y
//    «subió la autorización» (aviso del CEO: sin esto la cola de IDC se llena
//    de fichas vacías). Solo pasa a EN_REVISION cuando el perfil está completo
//    Y hay una `VerificacionProfesional` con autorización subida.
//  · `venceEn` de la verificación = `revisadoEn + 4 meses` (Ley 2375/2024 —
//    no es anual; L2 hará el recordatorio con 30 días de anticipación).
//  · Solicitudes: `venceEn` = creado + 48 h (§3 «devuelve todo al padre»).
//  · Autorización: `autorizacionArchivoId` guarda el ID OPACO del archivo en un storage
//    PROTEGIDO (no `escudo-storage`, que es público). El servicio de storage
//    lo implementa L1b siguiendo el patrón de informes/apelaciones.

enum EstadoPerfilProfesional {
  BORRADOR
  EN_REVISION
  ACTIVO
  RECHAZADO
  VENCIDO
  SUSPENDIDO
}

enum ResultadoVerificacion {
  APROBADO
  RECHAZADO
  MAS_INFORMACION
}

enum ModalidadCita {
  VIRTUAL
  PRESENCIAL
}

enum UrgenciaSolicitud {
  ESTA_SEMANA
  SIN_APURO
}

enum EstadoSolicitudCita {
  PAGADA_PENDIENTE
  CONFIRMADA
  CUMPLIDA
  NO_ASISTIO_PADRE
  NO_ASISTIO_PROFESIONAL
  VENCIDA_SIN_RESPUESTA
  REEMBOLSADA
  SIN_CONFIRMAR
  // SPEC-388a · brief v1.3 (aviso Calidad): una reprogramación es FILA NUEVA
  // que HEREDA el pago, no una transición. La solicitud original queda como
  // REPROGRAMADA (terminal) y el rastro del primer intento se conserva.
  REPROGRAMADA
}

model PerfilProfesional {
  id                       String                   @id @default(cuid())
  usuarioId                String                   @unique
  nombreVisible            String
  fotoUrl                  String?
  tituloProfesional        String
  // `String[]` en Postgres se guarda como text[] — L3 filtra por especialidad
  // con `has` de Prisma sin necesitar una tabla puente.
  especialidades           String[]
  ciudadId                 String
  atiendeVirtual           Boolean                  @default(false)
  atiendePresencial        Boolean                  @default(false)
  aniosExperiencia         Int
  presentacion             String                   @db.Text
  tarifaConsultaCOP        Int
  duracionMinutos          Int
  emiteFactura             Boolean                  @default(false)
  estado                   EstadoPerfilProfesional  @default(BORRADOR)
  // Internos, NUNCA públicos (candado del brief §2). fechaNacimiento y
  // documento se reusan de Usuario; acá van los que NO viven allá.
  numeroTarjetaProfesional String?
  datosFacturacion         Json?
  // SPEC-391 (L1b · veredicto CEO 08:40): la autorización firmada por el
  // profesional (Ley 2375/2024 — previa, expresa, escrita y archivada) es
  // del profesional, no de una revisión. Cada VerificacionProfesional
  // referencia la que estaba vigente al momento. `autorizacionSubidaEn`
  // se compara con `VerificacionProfesional.revisadoEn` para demostrar que
  // la autorización fue PREVIA a la consulta de antecedentes — sin fecha
  // no se puede probar. Ambos INTERNOS: nunca por API pública.
  autorizacionArchivoId    String?
  autorizacionSubidaEn     DateTime?                @db.Timestamptz(6)
  creadoEn                 DateTime                 @default(now()) @db.Timestamptz(6)
  actualizadoEn            DateTime                 @updatedAt @db.Timestamptz(6)

  usuario        Usuario                   @relation(fields: [usuarioId], references: [id])
  ciudad         Ciudad                    @relation(fields: [ciudadId], references: [id])
  verificaciones VerificacionProfesional[]
  franjas        FranjaDisponible[]
  solicitudes    SolicitudCita[]
  documentos     DocumentoProfesional[]

  // L3 filtra el directorio abierto por estado ACTIVO + ciudad; el índice
  // compuesto sirve al listado. La búsqueda por especialidad no lo necesita
  // (usa `has` sobre el array).
  @@index([estado, ciudadId])
}

// SPEC-436 (I-304) · los documentos que el profesional carga para que el
// Verificador pueda decidir con criterio (brief A-75 §5-bis).
//
// `requisitoClave` NO es un enum: es la clave del requisito tal como vive en el
// parámetro `verificacion.requisitos`. Si mañana Jelkin agrega un quinto
// requisito, esta tabla lo acepta sin migración — que es exactamente lo que el
// parámetro vino a permitir.
//
// El archivo NO se guarda acá: se cifra en el storage protegido y de él solo
// queda el `archivoId` opaco (mismo tratamiento que la autorización firmada).
// `sha256` es del texto EN CLARO, para verificar integridad sin descifrar todo.
model DocumentoProfesional {
  id                  String   @id @default(cuid())
  perfilProfesionalId String
  requisitoClave      String
  archivoId           String
  // pdf | png | jpg — informativo para la pantalla. El `Content-Type` con el
  // que se sirve se deduce del contenido descifrado, no de esta columna: un
  // dato guardado puede mentir, el número mágico del archivo no.
  extension           String
  sha256              String
  subidoEn            DateTime @default(now()) @db.Timestamptz(6)

  perfil PerfilProfesional @relation(fields: [perfilProfesionalId], references: [id], onDelete: Cascade)

  // Uno por requisito: reemplazar es actualizar la fila, no acumular basura.
  @@unique([perfilProfesionalId, requisitoClave])
  @@index([perfilProfesionalId])
}

// N por profesional — el HISTORIAL importa: si venció y hay una nueva
// aprobación, la anterior queda para auditoría. `venceEn` se calcula al
// insertar (revisadoEn + 4 meses) y el worker de L2 avisa un mes antes.
model VerificacionProfesional {
  id                     String                 @id @default(cuid())
  perfilProfesionalId    String
  revisadoPorId          String
  revisadoEn             DateTime               @default(now()) @db.Timestamptz(6)
  checklist              Json
  resultado              ResultadoVerificacion
  // Ruta a la autorización firmada por el profesional (Ley 2375/2024 exige
  // documento archivado). Storage PROTEGIDO — se sirve tras auth + módulo de
  // admin, nunca por URL adivinable. El servicio de storage lo trae L1b.
  autorizacionArchivoId  String
  venceEn                DateTime               @db.Timestamptz(6)
  creadoEn               DateTime               @default(now()) @db.Timestamptz(6)

  // SPEC-388 (aviso 05:26): idempotencia del recordatorio 30-días-antes que
  // implementa L2. NULL = todavía no se avisó; el worker marca la fecha
  // cuando envía, para no repetir en la siguiente vuelta (mismo patrón que
  // I-280 en SPAM_ALERTA_REVISION_ENVIADA).
  avisoVencimientoEnviadoEn DateTime?             @db.Timestamptz(6)
  // SPEC-388 (aviso 05:26): motivo del rechazo o qué falta en MAS_INFORMACION.
  // CANDADO DE RESERVA: NUNCA sale por API pública (agregar a la lista de
  // campos prohibidos del test cuando L1b/L2 los agreguen).
  notaInterna               String?               @db.Text

  perfilProfesional PerfilProfesional @relation(fields: [perfilProfesionalId], references: [id])
  revisadoPor       Usuario           @relation("VerificacionesRevisadasPor", fields: [revisadoPorId], references: [id])

  // L2 lista las verificaciones vigentes por profesional en orden descendente
  // y consulta la próxima que vence para el aviso de 30 días.
  @@index([perfilProfesionalId, revisadoEn(sort: Desc)])
  @@index([venceEn])
}

model FranjaDisponible {
  id             String        @id @default(cuid())
  profesionalId  String
  inicio         DateTime      @db.Timestamptz(6)
  fin            DateTime      @db.Timestamptz(6)
  modalidad      ModalidadCita
  tomada         Boolean       @default(false)
  creadoEn       DateTime      @default(now()) @db.Timestamptz(6)

  profesional PerfilProfesional @relation(fields: [profesionalId], references: [id])
  // 1:0..1 — al confirmar una solicitud se marca `tomada = true` y se guarda
  // la solicitud; si se libera (48 h sin confirmar), la franja vuelve a
  // `tomada = false` y la solicitud queda VENCIDA_SIN_RESPUESTA.
  solicitud   SolicitudCita?

  // L3 lista franjas libres del profesional ordenadas por inicio.
  @@index([profesionalId, tomada, inicio])
}

model SolicitudCita {
  id                     String              @id @default(cuid())
  padreUsuarioId         String
  profesionalId          String
  franjaId               String              @unique
  presentacion           String              @db.Text
  urgencia               UrgenciaSolicitud
  estado                 EstadoSolicitudCita @default(SIN_CONFIRMAR)
  // SPEC-395 (L4 · veredicto CEO 09:50):
  //   · `venceEn` es el PLAZO DEL PADRE para completar el pago manual
  //     (72 h por default). Si vence sin aprobación, la solicitud EXPIRA
  //     y la franja se libera para que otro padre la tome.
  //   · `pagoAprobadoEn` (aditivo) es el momento en que el admin activó
  //     el pago. **A partir de acá arranca el reloj de 48 h del profesional**:
  //     el worker calcula `pagoAprobadoEn + 48h` en tiempo real. Antes de
  //     este PR no había fecha porque el brief no decía que el pago era
  //     manual; §4 v1.3 lo dejó explícito.
  venceEn                DateTime            @db.Timestamptz(6)
  pagoAprobadoEn         DateTime?           @db.Timestamptz(6)
  expedienteCompartidoId String?
  // SPEC-388a · brief v1.3: reprogramación como FILA NUEVA (no transición) —
  // conserva el historial del primer intento. La nueva fila apunta a la
  // solicitud anterior y hereda el pago de otra: los dos campos son opcionales
  // porque la mayoría de las solicitudes son la PRIMERA (sin previa) y pagan
  // de cero (sin herencia). Se auto-referencian.
  solicitudPreviaId      String?
  pagoHeredadoDeId       String?
  // Denormalizado en pesos colombianos al momento de la solicitud (la tarifa
  // del profesional o el porcentaje pueden cambiar después; la cita se cobra
  // con el número que vio el padre cuando aceptó).
  montoConsulta          Int
  montoServicio          Int
  montoTotal             Int
  porcentajeServicio     Int
  creadoEn               DateTime            @default(now()) @db.Timestamptz(6)
  actualizadoEn          DateTime            @updatedAt @db.Timestamptz(6)

  padreUsuario         Usuario                @relation("SolicitudesCitaPadre", fields: [padreUsuarioId], references: [id])
  profesional          PerfilProfesional      @relation(fields: [profesionalId], references: [id])
  franja               FranjaDisponible       @relation(fields: [franjaId], references: [id])
  expedienteCompartido Expediente?            @relation(fields: [expedienteCompartidoId], references: [id])
  solicitudPrevia      SolicitudCita?         @relation("SolicitudReprogramada", fields: [solicitudPreviaId], references: [id])
  reprogramaciones     SolicitudCita[]        @relation("SolicitudReprogramada")
  pagoHeredadoDe       SolicitudCita?         @relation("PagoHeredado", fields: [pagoHeredadoDeId], references: [id])
  pagosQueHereda       SolicitudCita[]        @relation("PagoHeredado")
  encuesta             EncuestaPrimeraCita?

  // L4/L5: bandeja del profesional (sus solicitudes por estado) y del padre.
  @@index([profesionalId, estado, creadoEn(sort: Desc)])
  @@index([padreUsuarioId, estado, creadoEn(sort: Desc)])
  // L6: worker que devuelve al padre a las 48 h y autocierra a los 5 días.
  @@index([estado, venceEn])
}

model EncuestaPrimeraCita {
  id           String   @id @default(cuid())
  solicitudId  String   @unique
  seDioLaCita  Boolean
  // 1..5 — se valida en la capa de aplicación (Zod), Postgres no restringe.
  puntaje      Int
  volveria     Boolean
  comentario   String?  @db.Text
  respondidaEn DateTime @db.Timestamptz(6)

  solicitud SolicitudCita @relation(fields: [solicitudId], references: [id])
}
