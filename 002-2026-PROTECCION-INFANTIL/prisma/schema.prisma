generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Spec 097: imagen Docker Alpine (musl + OpenSSL 3) además del nativo (macOS/Linux glibc).
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum RolUsuario {
  ADMIN
  SCHOOL_ADMIN
  PARENT
  OPERADOR
  COMITE_VALIDACION
  COMITE_CONVIVENCIA
  // SPEC-388 (A-75): séptimo actor · psicólogo verificado. Registro por la
  // misma puerta que Familia/Colegio; visible en el directorio abierto solo
  // con `PerfilProfesional.estado = ACTIVO`. Los internos (tarjeta profesional,
  // documento, facturación, fecha de nacimiento) se REUSAN de `Usuario` para
  // los que ya viven ahí; nunca salen por API pública.
  PROFESIONAL
  // SPEC-408 (A-75 · brief §9): rol INTERNO dedicado a admitir profesionales y
  // atender incidentes de citas. Perfil equivalente al Operador — no ve
  // denuncias ni bandeja ni casos del comité. Sus módulos son
  // `admin_verificacion_profesionales` y `admin_verificacion_incidentes`.
  VERIFICADOR
}

enum EstadoUsuario {
  activo
  inactivo
  bloqueado
}

