model Usuario {
  id                  String        @id @default(cuid())
  email               String        @unique
  nombre              String?
  passwordHash        String
  rol                 RolUsuario
  estado              EstadoUsuario @default(activo)
  debeCambiarPassword Boolean       @default(false)
  intentosFallidos    Int           @default(0)
  bloqueadoHasta      DateTime?
  ultimaSesion        DateTime?
  tenantId            String?
  colegioId           String?       @unique
  // SPEC-168: cuenta compartida del Comité de Convivencia del colegio (una por colegio).
  comiteColegioId     String?       @unique
  // SPEC-119: ventana de servicio del cliente padre (PARENT). null = sin vigencia
  // definida = acceso permitido. Para SCHOOL_ADMIN la ventana es la del Colegio.
  inicioServicio      DateTime?
  finServicio         DateTime?
  creadoEn            DateTime      @default(now())
  actualizadoEn       DateTime      @updatedAt

  tenant                       Tenant?                    @relation(fields: [tenantId], references: [id])
  colegio                      Colegio?                   @relation(fields: [colegioId], references: [id])
  comiteConvivenciaColegio     Colegio?                   @relation(name: "ComiteConvivenciaColegio", fields: [comiteColegioId], references: [id])
  parametros                   ParametroSistema[]
  auditLogs                    AuditLog[]
  permisosModuloActualizados   PermisoModulo[]
  codigos                      CodigoVerificacion[]
  tokensRecuperacion           TokenRecuperacion[]
  reportes                     Reporte[]
  reportesDadosDeBaja          Reporte[]                  @relation("ReportesDadosDeBaja")
  correcciones                 CorreccionAdmin[]
  alertasSuscripcion           AlertaSuscripcion[]
  simulaciones                 SimulacionRun[]
  casosAsignados               Reporte[]                  @relation("CasosOperador")
  casosComiteAsignados         Reporte[]                  @relation("CasosComite")
  anonimizacionesValidadas     Reporte[]                  @relation("AnonimizacionesValidadas")
  perfilOperador               PerfilOperador?
  operadoresCreados            PerfilOperador[]           @relation("OperadoresCreados")
  contactosConfianza           ContactoConfianza[]
  notificacionesCirculo        Boolean                    @default(true)
  ultimaNotificacionCirculoEn  DateTime?
  ultimaNotificacionColegioEn  DateTime?
  transicionesReporte          TransicionReporte[]
  solicitudesComite            SolicitudComite[]          @relation("SolicitudesComite")
  solicitudesEscaladas         SolicitudComite[]          @relation("SolicitudesEscaladas")
  solicitudesComiteCreadas     SolicitudComite[]          @relation("SolicitudesCreadasPorColegio")
  notasSeguimiento             NotaSeguimiento[]
  integrantesComite            IntegranteComite[]         @relation("IntegrantesComite")
  integrantesComiteCreados     IntegranteComite[]         @relation("IntegrantesComiteCreados")
  integrantesComiteModificados IntegranteComite[]         @relation("IntegrantesComiteModificados")
  apelaciones                  Apelacion[]                @relation("ApelacionesUsuario")
  apelacionesAsignadas         Apelacion[]                @relation("ApelacionesAsignadasComite")
  apelacionesResueltas         Apelacion[]                @relation("ApelacionesResueltas")
  accesosDocumentoApelacion    AccesoDocumentoApelacion[]
  alertasAsignadas             AlertaColegio[]
  notificacionesInApp          NotificacionInApp[]
  // SPEC-184 (002-PI-079): blocklist y simulador de abusos.
  bloqueosCreados              BlockList[]
  simulacionesAbuso            SimulacionAbusoRun[]
  // SPEC-230 (002-PI-130): expedientes del padre.
  expedientes                  Expediente[]
  // SPEC-206 (002-PI-120): sesiones activas del usuario.
  sesionesLog                  SesionLog[]
  // SPEC-234 (002-PI-134): informes consolidados generados por el usuario/worker.
  informesConsolidados         InformeConsolidado[]
  // SPEC-210 (002-PI-110): módulo de pagos.
  suscripciones                Suscripcion[]
  planesCreados                Plan[]                     @relation("PlanesCreados")
  bonosCreados                 BonoPromocional[]          @relation("BonosCreados")
  pagosAutorizados             Pago[]                     @relation("PagosAutorizados")
  referidosRevisados           CodigoReferidoUso[]        @relation("ReferidosRevisados")
  tasasIngresadas              TasaCambio[]               @relation("TasasIngresadas")

  @@index([email])
  @@index([rol])
  @@index([estado])
  @@index([tenantId])
}

model PerfilOperador {
  id                        String    @id @default(cuid())
  usuarioId                 String    @unique
  cupoMaximo                Int?
  esRevisorDeApelaciones    Boolean   @default(false)
  esComite                  Boolean   @default(false)
  notasInternas             String?
  ultimoEmailNotificacionEn DateTime?
  creadoPorId               String
  creadoEn                  DateTime  @default(now())
  actualizadoEn             DateTime  @updatedAt

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadoPor Usuario @relation(fields: [creadoPorId], references: [id], name: "OperadoresCreados")

  @@index([usuarioId])
  @@index([creadoPorId])
  @@index([esComite])
}

model IntegranteComite {
  id                   String                       @id @default(cuid())
  comiteId             String
  nombres              String
  apellidos            String
  tipoIdentificacion   TipoIdentificacionIntegrante
  numeroIdentificacion String
  hashIdentificacion   String
  email                String
  cargo                String?
  fechaInicio          DateTime                     @default(now())
  fechaFin             DateTime?
  estado               EstadoIntegranteComite       @default(ACTIVO)
  creadoPorId          String
  modificadoPorId      String?
  creadoEn             DateTime                     @default(now())
  actualizadoEn        DateTime                     @updatedAt

  comite        Usuario  @relation(fields: [comiteId], references: [id], name: "IntegrantesComite", onDelete: Cascade)
  creadoPor     Usuario  @relation(fields: [creadoPorId], references: [id], name: "IntegrantesComiteCreados")
  modificadoPor Usuario? @relation(fields: [modificadoPorId], references: [id], name: "IntegrantesComiteModificados")

  @@unique([comiteId, hashIdentificacion])
  @@index([comiteId])
  @@index([estado])
  @@index([tipoIdentificacion])
}

model CodigoVerificacion {
  id               String   @id @default(cuid())
  email            String
  codigoHash       String
  expiraEn         DateTime
  intentosFallidos Int      @default(0)
  usado            Boolean  @default(false)
  creadoEn         DateTime @default(now())

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([email])
  @@index([creadoEn])
}

model TokenRecuperacion {
  id            String   @id @default(cuid())
  email         String
  tokenHash     String
  expiraEn      DateTime
  usado         Boolean  @default(false)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([email])
  @@index([tokenHash])
  @@index([expiraEn])
}

model ParametroSistema {
  id               String             @id @default(cuid())
  clave            String             @unique
  valor            String
  tipo             TipoParametro
  categoria        CategoriaParametro
  esPublico        Boolean            @default(false)
  esSecreto        Boolean            @default(false)
  descripcion      String?
  reglasValidacion String?
  creadoEn         DateTime           @default(now())
  actualizadoEn    DateTime           @updatedAt
  actualizadoPorId String?

  actualizadoPor Usuario?   @relation(fields: [actualizadoPorId], references: [id])
  auditLogs      AuditLog[]

  @@index([clave])
  @@index([categoria])
}

model AuditLog {
  id            String      @id @default(cuid())
  accion        AccionAudit
  tipoRecurso   String
  recursoId     String?
  usuarioId     String?
  parametroId   String?
  colegioId     String?
  valorAnterior String?
  valorNuevo    String?
  ipAddress     String
  userAgent     String
  metadatos     Json?
  creadoEn      DateTime    @default(now())

  usuario   Usuario?          @relation(fields: [usuarioId], references: [id])
  parametro ParametroSistema? @relation(fields: [parametroId], references: [id])
  colegio   Colegio?          @relation(fields: [colegioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([parametroId])
  @@index([colegioId])
  @@index([accion])
  @@index([creadoEn])
}

// SPEC-206 (002-PI-120): bitácora de sesiones activas para instrumentación de uso.
model SesionLog {
  id                String             @id @default(cuid())
  usuarioId         String
  tenantId          String?
  rol               RolUsuario
  iniciadaEn        DateTime           @db.Timestamptz(6)
  ultimaActividadEn DateTime           @db.Timestamptz(6)
  cerradaEn         DateTime?          @db.Timestamptz(6)
  motivoCierre      MotivoCierreSesion?
  duracionMin       Int?
  ipHash            String
  userAgent         String?
  creadoEn          DateTime           @default(now())
  actualizadoEn     DateTime           @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, iniciadaEn(sort: Desc)])
  @@index([tenantId, iniciadaEn(sort: Desc)])
  @@index([cerradaEn, ultimaActividadEn])
  @@index([creadoEn])
  @@map("sesiones_log")
}

model Tenant {
  id       String   @id @default(cuid())
  nombre   String
  estado   String   @default("activo")
  creadoEn DateTime @default(now())

  usuarios Usuario[]
  reportes Reporte[]
  colegio  Colegio?
}

// SPEC-210 (002-PI-110): Plan enriquecido. El campo `precio` es legacy del
// placeholder original; la lógica nueva usa `precioBaseUSD`.
model Plan {
  id                String       @id @default(cuid())
  nombre            String
  tipoTitular       TipoTitular
  duracion          DuracionPlan
  anio              Int
  precioBaseUSD     Float
  descuentoAnualPct Float?
  activo            Boolean      @default(true)
  descripcion       String?
  precio            Float? // legacy placeholder; no usar en lógica nueva
  creadoPorAdminId  String
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  creadoPor     Usuario       @relation(fields: [creadoPorAdminId], references: [id], name: "PlanesCreados")
  suscripciones Suscripcion[]

  @@unique([tipoTitular, duracion, anio])
  @@index([activo, anio])
}

model Subscription {
  id        String    @id @default(cuid())
  tenantId  String
  planId    String
  estado    String    @default("activo")
  iniciaEn  DateTime
  terminaEn DateTime?
  creadoEn  DateTime  @default(now())
}

model BillingCycle {
  id             String   @id @default(cuid())
  subscriptionId String
  monto          Float
  estado         String   @default("pendiente")
  periodoInicio  DateTime
  periodoFin     DateTime
  creadoEn       DateTime @default(now())
}

// ============================================
// MÓDULO DE PAGOS (SPEC-210 · 002-PI-110)
// ============================================

model Suscripcion {
  id                   String            @id @default(cuid())
  tipoTitular          TipoTitular
  colegioId            String?
  usuarioId            String?
  estado               EstadoSuscripcion
  planActualId         String
  contratoPDFUrl       String?
  fechaInicio          DateTime          @db.Timestamptz(6)
  fechaFin             DateTime          @db.Timestamptz(6)
  fechaCorteProgramado DateTime?         @db.Timestamptz(6)
  esFreemium           Boolean           @default(false)
  freemiumFechaFin     DateTime?         @db.Timestamptz(6)
  codigoReferidoPropio String            @unique
  codigoReferidoUsado  String?
  monedaLocal          String            @default("COP")
  paisCliente          String            @default("CO")
  suspendidaEn         DateTime?         @db.Timestamptz(6)
  canceladaEn          DateTime?         @db.Timestamptz(6)
  canceladaPorUsuario  Boolean?
  motivoCancelacion    String?
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)

  colegio               Colegio?            @relation(fields: [colegioId], references: [id])
  usuario               Usuario?            @relation(fields: [usuarioId], references: [id])
  planActual            Plan                @relation(fields: [planActualId], references: [id])
  pagos                 Pago[]
  bonosAplicados        BonoAplicado[]
  referidosCodigoPropio CodigoReferidoUso[] @relation("CodigoPropio")
  referidosUsados       CodigoReferidoUso[] @relation("Referida")

  @@index([estado, fechaFin])
  @@index([tipoTitular, estado])
}

model Pago {
  id                    String       @id @default(cuid())
  suscripcionId         String
  duracionCubierta      DuracionPlan
  montoBaseUSD          Float
  descuentoAplicadoUSD  Float        @default(0)
  montoNetoUSD          Float
  tasaCambioAplicada    Float
  montoLocalPagado      Float
  monedaLocal           String
  metodoDeclarado       MetodoPago
  comprobanteAdjuntoUrl String
  comprobanteMimeType   String
  comprobanteHashSha256 String
  fechaReporte          DateTime     @db.Timestamptz(6)
  fechaAutorizacion     DateTime?    @db.Timestamptz(6)
  estado                EstadoPago
  motivoRechazo         String?
  autorizadoPorAdminId  String?
  codigoReferidoUsado   String?
  // SPEC-212 (002-PI-112): campos aditivos de reembolso.
  montoReembolsoUSD     Float?
  motivoReembolso       String?
  referenciaReembolso   String?
  createdAt             DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(6)

  suscripcion    Suscripcion    @relation(fields: [suscripcionId], references: [id])
  autorizadoPor  Usuario?       @relation(fields: [autorizadoPorAdminId], references: [id], name: "PagosAutorizados")
  bonosAplicados BonoAplicado[]

  @@index([suscripcionId, createdAt])
  @@index([estado, fechaReporte])
}

model BonoPromocional {
  id                          String       @id @default(cuid())
  nombre                      String       @unique
  tipo                        TipoBono
  valor                       Float
  vigenciaInicio              DateTime     @db.Timestamptz(6)
  vigenciaFin                 DateTime     @db.Timestamptz(6)
  usosMaximosTotales          Int?
  usosMaximosPorCliente       Int          @default(1)
  aplicaANuevos               Boolean      @default(true)
  aplicaARenovaciones         Boolean      @default(false)
  aplicaSoloA                 TipoTitular?
  combinableConCodigoPersonal Boolean      @default(false)
  activo                      Boolean      @default(true)
  descripcion                 String?
  creadoPorAdminId            String
  createdAt                   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime     @updatedAt @db.Timestamptz(6)

  creadoPor Usuario        @relation(fields: [creadoPorAdminId], references: [id], name: "BonosCreados")
  usos      BonoAplicado[]

  @@index([activo, vigenciaInicio, vigenciaFin])
}

model BonoAplicado {
  id            String   @id @default(cuid())
  bonoId        String
  suscripcionId String
  pagoId        String?
  aplicadoEn    DateTime @default(now()) @db.Timestamptz(6)
  descuentoUSD  Float

  bono        BonoPromocional @relation(fields: [bonoId], references: [id])
  suscripcion Suscripcion     @relation(fields: [suscripcionId], references: [id])
  pago        Pago?           @relation(fields: [pagoId], references: [id])

  @@index([bonoId, aplicadoEn])
}

model CodigoReferidoUso {
  id                      String    @id @default(cuid())
  codigoReferidoUsuarioId String
  suscripcionReferidaId   String
  fechaRegistro           DateTime  @default(now()) @db.Timestamptz(6)
  fechaActivacion         DateTime? @db.Timestamptz(6)
  recompensaOtorgada      Boolean   @default(false)
  recompensaOtorgadaEn    DateTime? @db.Timestamptz(6)
  tipoRecompensa          String?
  anio                    Int
  requiereRevisionAdmin   Boolean   @default(false)
  revisadaPorAdminId      String?
  revisionOK              Boolean?

  referidor   Suscripcion @relation(fields: [codigoReferidoUsuarioId], references: [id], name: "CodigoPropio")
  referida    Suscripcion @relation(fields: [suscripcionReferidaId], references: [id], name: "Referida")
  revisadaPor Usuario?    @relation(fields: [revisadaPorAdminId], references: [id], name: "ReferidosRevisados")

  @@unique([codigoReferidoUsuarioId, suscripcionReferidaId])
  @@index([codigoReferidoUsuarioId, anio])
}

model TasaCambio {
  id                  String     @id @default(cuid())
  monedaOrigen        String
  monedaDestino       String
  tasa                Float
  fecha               DateTime   @db.Timestamptz(6)
  fuente              FuenteTasa
  apiUrl              String?
  ingresadoPorAdminId String?
  motivoManual        String?
  createdAt           DateTime   @default(now()) @db.Timestamptz(6)

  ingresadoPor Usuario? @relation(fields: [ingresadoPorAdminId], references: [id], name: "TasasIngresadas")

  @@index([monedaDestino, fecha])
}

model Colegio {
  id                               String              @id @default(cuid())
  nombre                           String
  paisId                           String
  departamentoId                   String?
  ciudadId                         String
  direccion                        String?
  representanteLegalNombre         String
  representanteLegalIdentificacion String
  representanteLegalEmail          String
  representanteLegalTelefono       String?
  inicioServicio                   DateTime
  finServicio                      DateTime?
  tipoPeriodo                      TipoPeriodoServicio
  estado                           String              @default("activo")
  tenantId                         String              @unique
  creadoEn                         DateTime            @default(now())
  actualizadoEn                    DateTime            @updatedAt

  pais                     Pais                       @relation(fields: [paisId], references: [id])
  departamento             Departamento?              @relation(fields: [departamentoId], references: [id])
  ciudad                   Ciudad                     @relation(fields: [ciudadId], references: [id])
  tenant                   Tenant                     @relation(fields: [tenantId], references: [id])
  admin                    Usuario?
  comiteConvivencia        Usuario?                   @relation(name: "ComiteConvivenciaColegio")
  cursos                   Curso[]
  estudiantes              Estudiante[]
  profesores               Profesor[]
  alertas                  AlertaColegio[]
  solicitudesComite        SolicitudComite[]
  patrones                 PatronInstitucional[]
  preferenciasAvisos       PreferenciaAlertaColegio[]
  registrosAvisos          RegistroAvisoColegio[]
  seguimientosCaso         SeguimientoCaso[]
  notasSeguimiento         NotaSeguimiento[]
  auditLogs                AuditLog[]
  sesionesCarga            CargaRosterSesion[]
  Materia                  Materia[]
  CursoMateria             CursoMateria[]
  identificadoresAcudiente IdentificadorAcudiente[]
  identificadoresProfesor  IdentificadorProfesor[]
  onboarding               OnboardingColegio?
  notificacionesInApp      NotificacionInApp[]
  // SPEC-210 (002-PI-110): módulo de pagos.
  suscripciones            Suscripcion[]

  @@index([paisId])
  @@index([departamentoId])
  @@index([ciudadId])
  @@index([estado])
}

// SPEC-169 (Fase G): onboarding "Activa tu protección" — fila única por colegio.
// El progreso real se calcula sobre cursos, estudiantes, profesores, acudientes e
// identificadores activos; aquí solo se guarda estado, paso visible y timestamp.
model OnboardingColegio {
  id            String    @id @default(cuid())
  colegioId     String    @unique
  estado        String    @default("activo") // activo | omitido | completado
  pasoActual    Int       @default(1)
  completadoEn  DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  colegio Colegio @relation(fields: [colegioId], references: [id])

  @@index([estado])
}

// SPEC-169 (Fase G): notificaciones in-app dirigidas al SCHOOL_ADMIN del colegio.
// Estados implícitos por leidaEn / archivadaEn; nunca almacena texto del reporte.
model NotificacionInApp {
  id            String    @id @default(cuid())
  colegioId     String
  usuarioId     String
  tipo          String // ALERTA_NUEVA | ALERTA_GESTIONADA | ALERTA_ESCALADA | SISTEMA
  titulo        String
  mensaje       String
  entidadId     String?
  leidaEn       DateTime?
  archivadaEn   DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  colegio Colegio @relation(fields: [colegioId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([colegioId, usuarioId, archivadaEn, leidaEn, creadoEn])
  @@index([colegioId, usuarioId, archivadaEn, creadoEn])
  @@index([colegioId, entidadId, tipo])
}

model Curso {
  id                String   @id @default(cuid())
  colegioId         String
  nombre            String
  grado             String?
  anioLectivo       String?
  estado            String   @default("activo")
  profesorTitularId String? // SPEC-145: aditivo; existentes quedan NULL (no se retro-asigna)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  colegio         Colegio        @relation(fields: [colegioId], references: [id])
  profesorTitular Profesor?      @relation(fields: [profesorTitularId], references: [id])
  estudiantes     Estudiante[]
  CursoMateria    CursoMateria[]

  @@unique([colegioId, nombre, grado, anioLectivo])
  @@index([colegioId, estado])
}

// SPEC-145 (brief §7.2): modelo Profesor mínimo — nombre, apellidos, email?,
// teléfono?, estado. Baja = soft delete (estado "inactivo"), nunca borrado físico.
model Profesor {
  id        String   @id @default(cuid())
  colegioId String
  nombre    String
  apellidos String
  email     String?
  telefono  String?
  estado    String   @default("activo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colegio             Colegio                 @relation(fields: [colegioId], references: [id])
  cursos              Curso[]
  CursoMateria        CursoMateria[]
  identificadoresProf IdentificadorProfesor[]

  @@index([colegioId, estado])
}

// SPEC-162: catálogo de materias configurable por colegio.
model Materia {
  id            String   @id @default(cuid())
  colegioId     String
  nombre        String
  estado        String   @default("activo")
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  colegio      Colegio        @relation(fields: [colegioId], references: [id])
  CursoMateria CursoMateria[]

  @@unique([colegioId, nombre])
  @@index([colegioId, estado])
}

// SPEC-162: vínculo Curso × Materia × Profesor. Resuelve materia configurable
// y profesor multi-curso sin tocar Curso ni Estudiante.cursoId.
model CursoMateria {
  id            String   @id @default(cuid())
  colegioId     String
  cursoId       String
  materiaId     String
  profesorId    String?
  estado        String   @default("activo")
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  colegio  Colegio   @relation(fields: [colegioId], references: [id])
  curso    Curso     @relation(fields: [cursoId], references: [id])
  materia  Materia   @relation(fields: [materiaId], references: [id])
  profesor Profesor? @relation(fields: [profesorId], references: [id])

  @@unique([cursoId, materiaId])
  @@index([colegioId, estado])
  @@index([cursoId, estado])
  @@index([profesorId])
}

// SPEC-144: modelo Estudiante (antes Alumno; tabla física "Alumno" conservada).
// Obligatorios al alta (validación API, no BD): nombre + apellidos. El default ""
// de apellidos existe SOLO para el backfill de históricos (D4).
model Estudiante {
  id              String   @id @default(cuid())
  cursoId         String
  colegioId       String
  nombre          String
  apellidos       String   @default("")
  documentoTipo   String? // set cerrado en Zod (D3): RC|TI|CC|CE|PASAPORTE|OTRO
  documentoNumero String?
  estado          String   @default("activo")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  curso           Curso                     @relation(fields: [cursoId], references: [id])
  colegio         Colegio                   @relation(fields: [colegioId], references: [id])
  identificadores IdentificadorEstudiante[]
  acudientes      AcudienteEstudiante[]
  observaciones   EstudianteObservacion[]

  @@index([cursoId, estado])
  @@index([colegioId, estado])
  @@map("Alumno")
}

// SPEC-144 (D1) / SPEC-163: acudiente del estudiante — tabla hija, máximo 2 por
// estudiante (orden 1|2). PII de un tercero: NUNCA se consulta por id suelto;
// siempre a través del estudiante ya acotado por colegioId (patrón E-1/SPEC-134).
// SPEC-163: estado (activo/inactivo) como baja lógica aditiva.
model AcudienteEstudiante {
  id           String   @id @default(cuid())
  estudianteId String
  orden        Int // 1 = principal, 2 = secundario
  nombre       String
  relacion     String // "madre" | "padre" | "tía" | … (texto libre corto)
  telefono     String?
  email        String?
  estado       String   @default("activo") // activo | inactivo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  estudiante      Estudiante               @relation(fields: [estudianteId], references: [id])
  identificadores IdentificadorAcudiente[]

  @@unique([estudianteId, orden, estado])
  @@index([estudianteId, estado])
}

// SPEC-163 (FR-001): identificadores tipados de un acudiente para matching de
// alertas (Fase C). colegioId denormalizado para validación de tenant y queries
// rápidas (patrón E-1/SPEC-134). Baja lógica por estado.
model IdentificadorAcudiente {
  id           String   @id @default(cuid())
  acudienteId  String
  colegioId    String
  tipo         String
  valor        String
  plataformaId String?
  estado       String   @default("activo") // activo | inactivo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  acudiente  AcudienteEstudiante @relation(fields: [acudienteId], references: [id])
  colegio    Colegio             @relation(fields: [colegioId], references: [id])
  plataforma Plataforma?         @relation(fields: [plataformaId], references: [id])
  alertas    AlertaColegio[]

  @@unique([acudienteId, tipo, valor, plataformaId])
  @@index([colegioId, estado])
  @@index([acudienteId, estado])
  @@index([valor])
}

// SPEC-164: identificadores tipados de un profesor (teléfono, email, nick/usuario
// en plataforma). Soft delete por estado; no borrado físico.
model IdentificadorProfesor {
  id           String   @id @default(cuid())
  profesorId   String
  colegioId    String
  tipo         String
  valor        String
  plataformaId String?
  estado       String   @default("activo") // activo | inactivo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profesor   Profesor        @relation(fields: [profesorId], references: [id])
  colegio    Colegio         @relation(fields: [colegioId], references: [id])
  plataforma Plataforma?     @relation(fields: [plataformaId], references: [id])
  alertas    AlertaColegio[]

  @@unique([profesorId, tipo, valor, plataformaId])
  @@index([colegioId, estado])
  @@index([profesorId, estado])
  @@index([valor])
}

// SPEC-150 (FR-001): observación especial del estudiante — la marca auditable
// (Ley 1581). Soft delete estilo Reporte: desmarcar CONSERVA la fila con
// quién/cuándo (activa=false + desactivadaEn/desactivadaPorId), nunca borra el
// histórico. colegioId denormalizado para acotar SIEMPRE por tenant (patrón
// E-1/SPEC-134); creadaPorId/desactivadaPorId son ids de Usuario sin FK (el
// actor puede desactivarse después sin romper el respaldo).
model EstudianteObservacion {
  id               String    @id @default(cuid())
  estudianteId     String
  colegioId        String
  activa           Boolean   @default(true)
  motivo           String?
  creadaPorId      String
  desactivadaEn    DateTime?
  desactivadaPorId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])

  @@index([estudianteId, activa])
}

model IdentificadorEstudiante {
  id               String                     @id @default(cuid())
  estudianteId     String                     @map("alumnoId")
  tipo             String
  valor            String
  plataformaId     String?
  etiquetaRelacion EtiquetaRelacionEstudiante @default(ESTUDIANTE)
  estado           String                     @default("activo")
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  estudiante Estudiante      @relation(fields: [estudianteId], references: [id])
  plataforma Plataforma?     @relation(fields: [plataformaId], references: [id])
  alertas    AlertaColegio[]

  @@unique([estudianteId, valor, tipo, plataformaId])
  @@index([estudianteId, estado])
  @@map("IdentificadorAlumno")
}

// SPEC-165: alerta extendida a estudiante/profesor/acudiente. Una sola FK
// poblada según tipoSujeto; constraint única por tipo evita duplicados.
model AlertaColegio {
  id                        String   @id @default(cuid())
  colegioId                 String
  reporteId                 String
  identificadorEstudianteId String?  @map("identificadorAlumnoId")
  identificadorProfesorId   String?
  identificadorAcudienteId  String?
  tipoSujeto                String   @default("ESTUDIANTE") // ESTUDIANTE | PROFESOR | ACUDIENTE
  estado                    String   @default("nueva") // nueva | vista | gestionada | escalada | cerrada
  prioridad                 String   @default("media") // alta | media | baja
  vencimientoSla            DateTime @db.Timestamptz(6)
  asignadoAId               String?
  // SPEC-142 (F6): fila agregada que ESTA alerta aportó (idempotencia + reversa
  // exacta en baja). Nullable: las alertas previas a F6 no aportan al agregado.
  patronInstitucionalId     String?
  creadoEn                  DateTime @default(now()) @db.Timestamptz(6)
  actualizadoEn             DateTime @updatedAt @db.Timestamptz(6)

  colegio                 Colegio                  @relation(fields: [colegioId], references: [id])
  reporte                 Reporte                  @relation(fields: [reporteId], references: [id])
  identificadorEstudiante IdentificadorEstudiante? @relation(fields: [identificadorEstudianteId], references: [id])
  identificadorProfesor   IdentificadorProfesor?   @relation(fields: [identificadorProfesorId], references: [id])
  identificadorAcudiente  IdentificadorAcudiente?  @relation(fields: [identificadorAcudienteId], references: [id])
  patronInstitucional     PatronInstitucional?     @relation(fields: [patronInstitucionalId], references: [id])
  asignadoA               Usuario?                 @relation(fields: [asignadoAId], references: [id])
  seguimiento             SeguimientoCaso?
  // SPEC-168: una alerta escalada genera una única solicitud al Comité de Convivencia.
  solicitudComite         SolicitudComite?

  @@unique([colegioId, reporteId, identificadorEstudianteId])
  @@unique([colegioId, reporteId, identificadorProfesorId])
  @@unique([colegioId, reporteId, identificadorAcudienteId])
  @@index([colegioId, estado])
  @@index([colegioId, prioridad, vencimientoSla])
  @@index([colegioId, asignadoAId])
  @@index([reporteId])
  @@index([tipoSujeto])
}

// SPEC-142 (F6): patrón institucional agregado por (colegio, grado, conducta,
// plataforma, trimestre). SIN PII por construcción (FR-002): nunca identificador,
// reporteId, alumnoId, nombres ni textos — solo conteos por dimensiones.
// El k-anonimato (k=3) se aplica en LECTURA, no aquí.
model PatronInstitucional {
  id            String            @id @default(cuid())
  colegioId     String
  periodo       String // trimestre calendario de Reporte.creadoEn: "2026-Q3"
  grado         String // snapshot de Curso.grado; sentinel "Sin grado registrado"
  conducta      CategoriaConducta
  plataformaId  String
  conteo        Int               @default(0)
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  colegio    Colegio         @relation(fields: [colegioId], references: [id])
  plataforma Plataforma      @relation(fields: [plataformaId], references: [id])
  alertas    AlertaColegio[]

  @@unique([colegioId, periodo, grado, conducta, plataformaId])
  @@index([colegioId, periodo])
  @@map("patrones_institucionales")
}

// SPEC-149 (FR-001): preferencias de avisos por email del colegio. UNA fila por
// (colegio, tipoEvento); sin fila rigen los defaults del pipeline (todo
// habilitado, destino = email del SCHOOL_ADMIN, N=3/7d curso, M=2/30d
// estudiante, resumen habilitado). tipoEvento es String con valores cerrados
// (mismo patrón que AlertaColegio.estado): REPORTE_NUEVO | UMBRAL_CURSO |
// ESTUDIANTE_REPETIDO | RESUMEN_SEMANAL. `umbral` y `ventanaDias` solo aplican
// a UMBRAL_CURSO y ESTUDIANTE_REPETIDO.
model PreferenciaAlertaColegio {
  id            String   @id @default(cuid())
  colegioId     String
  tipoEvento    String // REPORTE_NUEVO | UMBRAL_CURSO | ESTUDIANTE_REPETIDO | RESUMEN_SEMANAL
  habilitado    Boolean  @default(true)
  emailDestino  String?
  umbral        Int?
  ventanaDias   Int?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  colegio Colegio @relation(fields: [colegioId], references: [id])

  @@unique([colegioId, tipoEvento])
}

// SPEC-149 (FR-001): bitácora de avisos del colegio — LA idempotencia por
// constraint: @@unique([colegioId, tipoEvento, entidadId, dia]). Un mismo
// evento/entidad/día = UNA fila = UN email como máximo; el duplicado es no-op.
// ENVIADO solo se marca tras el 200 del proveedor (un FALLIDO no consume la
// idempotencia y pg-boss puede reintentar). estado es String con valores
// cerrados: ENVIADO | OMITIDO | PENDIENTE_DIGEST | FALLIDO. `entidadId` es el
// id de la entidad del evento (reporteId, cursoId, estudianteId) o "semanal"
// para el resumen. `dia` es la fecha del evento en día calendario (DATE).
model RegistroAvisoColegio {
  id            String   @id @default(cuid())
  colegioId     String
  tipoEvento    String // REPORTE_NUEVO | UMBRAL_CURSO | ESTUDIANTE_REPETIDO | RESUMEN_SEMANAL
  entidadId     String
  dia           DateTime @db.Date
  estado        String // ENVIADO | OMITIDO | PENDIENTE_DIGEST | FALLIDO
  detalle       String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  colegio Colegio @relation(fields: [colegioId], references: [id])

  @@unique([colegioId, tipoEvento, entidadId, dia])
  @@index([colegioId, estado])
}

// SPEC-159 (FR-001): seguimiento del caso del colegio — 1:1 con la alerta
// (alertaId único), nace LAZY con la primera nota de la bitácora (spec,
// Assumptions). estado es String con valores cerrados (mismo patrón que
// AlertaColegio.estado): en_seguimiento | cerrado. En esta versión no hay
// flujo de cierre manual: queda derivado de la alerta gestionada.
model SeguimientoCaso {
  id            String   @id @default(cuid())
  colegioId     String
  alertaId      String   @unique
  estado        String   @default("en_seguimiento") // en_seguimiento | cerrado
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  colegio Colegio           @relation(fields: [colegioId], references: [id])
  alerta  AlertaColegio     @relation(fields: [alertaId], references: [id])
  notas   NotaSeguimiento[]

  @@index([colegioId, estado])
}

// SPEC-159 (FR-001): nota de la bitácora — "lo actuado", INMUTABLE por
// construcción (no existe PATCH ni DELETE: respaldo forense, Ley 1581). Texto
// plano 1..1000 chars (Zod en el endpoint; React escapa al renderizar).
// colegioId denormalizado del seguimiento: tenant obligatorio por
// construcción (E-1) sin pasar por el join.
model NotaSeguimiento {
  id            String   @id @default(cuid())
  seguimientoId String
  colegioId     String
  texto         String
  autorId       String
  creadoEn      DateTime @default(now())

  seguimiento SeguimientoCaso @relation(fields: [seguimientoId], references: [id])
  colegio     Colegio         @relation(fields: [colegioId], references: [id])
  autor       Usuario         @relation(fields: [autorId], references: [id])

  @@index([seguimientoId, creadoEn])
}

// ============================================
// MÓDULO DE REPORTES COMUNITARIOS (FASE 2)
// ============================================

model Plataforma {
  id        String   @id @default(cuid())
  clave     String   @unique
  nombre    String
  categoria String   @default("otro")
  esActiva  Boolean  @default(true)
  creadoEn  DateTime @default(now())

  reportes                  Reporte[]
  identificadores           IdentificadorReportado[]
  alertasSuscripcion        AlertaSuscripcion[]
  identificadoresContacto   IdentificadorContacto[]
  identificadoresEstudiante IdentificadorEstudiante[]
  identificadoresAcudiente  IdentificadorAcudiente[]
  identificadoresProfesor   IdentificadorProfesor[]
  apelaciones               Apelacion[]
  patronesInstitucionales   PatronInstitucional[]

  @@index([clave])
  @@index([esActiva])
}

model Pais {
  id       String   @id @default(cuid())
  codigo   String   @unique
  nombre   String
  esActivo Boolean  @default(true)
  creadoEn DateTime @default(now())

  ciudades      Ciudad[]
  departamentos Departamento[]
  colegios      Colegio[]
  reportes      Reporte[]

  @@index([codigo])
  @@index([esActivo])
}

model Departamento {
  id            String   @id @default(cuid())
  codigo        String?  @unique
  nombre        String
  paisId        String
  esActivo      Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pais     Pais      @relation(fields: [paisId], references: [id])
  ciudades Ciudad[]
  colegios Colegio[]

  @@unique([nombre, paisId])
  @@index([paisId])
  @@index([esActivo])
}

model Ciudad {
  id                String   @id @default(cuid())
  nombre            String
  paisId            String
  departamentoId    String?
  lat               Float?
  lng               Float?
  esActivo          Boolean  @default(true)
  creadoEn          DateTime @default(now())
  // SPEC-115 (catálogo geográfico GeoNames): clave estable del UPSERT y apoyo a la
  // búsqueda en servidor. nombreNormalizado = NFD sin diacríticos, minúsculas
  // (src/lib/normalizar.ts); poblacion ordena los resultados del buscador.
  geonameId         Int?     @unique
  nombreNormalizado String   @default("")
  poblacion         Int?

  pais         Pais          @relation(fields: [paisId], references: [id])
  departamento Departamento? @relation(fields: [departamentoId], references: [id])
  colegios     Colegio[]
  reportes     Reporte[]

  @@unique([nombre, paisId])
  @@index([paisId])
  @@index([departamentoId])
  @@index([esActivo])
  @@index([paisId, nombreNormalizado])
}

model Reporte {
  id                         String             @id @default(cuid())
  identificador              String
  plataformaId               String
  texto                      String             @db.Text
  textoOriginal              String?            @db.Text
  fechaIncidente             DateTime
  ciudad                     String
  pais                       String
  paisId                     String?
  ciudadId                   String?
  otraPlataforma             String?
  estado                     EstadoReporte      @default(PENDIENTE)
  esAnonimo                  Boolean            @default(true)
  edadVictima                Int?
  usuarioId                  String?
  operadorId                 String?
  comiteId                   String?
  reporteOrigenId            String?
  numeroSeguimiento          String?            @unique
  tenantId                   String?
  processingError            String?            @db.Text
  prioridadAlta              Boolean            @default(false)
  keywordsDetectadas         String[]
  esRafaga                   Boolean            @default(false)
  fuenteConfianza            Float?
  eliminado                  Boolean            @default(false)
  motivoBaja                 MotivoBajaReporte?
  notaBaja                   String?            @db.Text
  eliminadoEn                DateTime?
  eliminadoPorId             String?
  anonimizacionValidadaPorId String?
  anonimizacionValidadaEn    DateTime?
  creadoEn                   DateTime           @default(now())
  actualizadoEn              DateTime           @updatedAt

  plataforma               Plataforma          @relation(fields: [plataformaId], references: [id])
  usuario                  Usuario?            @relation(fields: [usuarioId], references: [id])
  eliminadoPor             Usuario?            @relation(fields: [eliminadoPorId], references: [id], name: "ReportesDadosDeBaja")
  operador                 Usuario?            @relation(fields: [operadorId], references: [id], name: "CasosOperador")
  comite                   Usuario?            @relation(fields: [comiteId], references: [id], name: "CasosComite")
  anonimizacionValidadaPor Usuario?            @relation(fields: [anonimizacionValidadaPorId], references: [id], name: "AnonimizacionesValidadas")
  reporteOrigen            Reporte?            @relation("ReporteDuplicado", fields: [reporteOrigenId], references: [id])
  duplicados               Reporte[]           @relation("ReporteDuplicado")
  clasificacion            ClasificacionIA?
  embedding                EmbeddingReporte?
  fuente                   FuenteReporte?
  tenant                   Tenant?             @relation(fields: [tenantId], references: [id])
  paisRel                  Pais?               @relation(fields: [paisId], references: [id])
  ciudadRel                Ciudad?             @relation(fields: [ciudadId], references: [id])
  transiciones             TransicionReporte[]
  reintentos               ReintentoReporte[]
  pasosProcesamiento       PasoProcesamiento[]
  solicitudComite          SolicitudComite?
  alertasColegio           AlertaColegio[]
  eventoMatchDisparado     EventoMatch?
  // SPEC-230 (002-PI-130): relación inversa para EventoExpediente.
  // Autorizado por ZEUS: no modifica columnas de la tabla reportes.
  eventos                  EventoExpediente[]

  @@index([identificador, plataformaId])
  @@index([estado])
  @@index([usuarioId, identificador])
  @@index([creadoEn])
  @@index([numeroSeguimiento])
  @@index([paisId])
  @@index([ciudadId])
  @@index([eliminado])
  @@index([eliminadoPorId])
  @@index([operadorId])
  @@index([comiteId])
  @@index([anonimizacionValidadaPorId])
}

model SolicitudComite {
  id              String    @id @default(cuid())
  reporteId       String    @unique
  numero          String    @unique
  estado          String    @default("PENDIENTE")
  comiteId        String?
  operadorId      String?
  // SPEC-168: escalamiento colegio-scoped al Comité de Convivencia.
  colegioId       String?
  alertaColegioId String?   @unique
  creadoPorId     String?
  motivo          String    @db.Text
  resolucion      String?   @db.Text
  creadoEn        DateTime  @default(now())
  resueltoEn      DateTime?

  reporte   Reporte        @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  comite    Usuario?       @relation(fields: [comiteId], references: [id], name: "SolicitudesComite")
  operador  Usuario?       @relation(fields: [operadorId], references: [id], name: "SolicitudesEscaladas")
  colegio   Colegio?       @relation(fields: [colegioId], references: [id])
  alerta    AlertaColegio? @relation(fields: [alertaColegioId], references: [id])
  creadoPor Usuario?       @relation(fields: [creadoPorId], references: [id], name: "SolicitudesCreadasPorColegio")

  @@index([estado])
  @@index([comiteId])
  @@index([operadorId])
  @@index([colegioId])
  @@index([alertaColegioId])
  @@index([creadoPorId])
  @@index([creadoEn])
}

model TransicionReporte {
  id              String                @id @default(cuid())
  reporteId       String
  estadoAnterior  EstadoReporte
  estadoNuevo     EstadoReporte
  responsableTipo ResponsableTransicion
  responsableId   String?
  motivo          String?               @db.Text
  metadatos       Json?
  creadoEn        DateTime              @default(now())

  reporte            Reporte  @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  responsableUsuario Usuario? @relation(fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([reporteId])
  @@index([responsableTipo])
  @@index([responsableId])
  @@index([creadoEn])
}

model ReintentoReporte {
  id        String   @id @default(cuid())
  reporteId String
  intento   Int
  exitoso   Boolean  @default(false)
  error     String?  @db.Text
  creadoEn  DateTime @default(now())

  reporte Reporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  @@index([reporteId])
  @@index([creadoEn])
}

// Spec 096-US3: traza de pasos del pipeline (guardas, deduplicación, RAG, métricas).
// Escritura best-effort; onDelete Cascade para no dejar pasos huérfanos (disputas Ley 1581).
model PasoProcesamiento {
  id         String   @id @default(cuid())
  reporteId  String
  etapa      String
  veredicto  String?
  detalle    Json?
  latenciaMs Int?
  creadoEn   DateTime @default(now())

  reporte Reporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  @@index([reporteId, creadoEn])
  @@map("pasos_procesamiento")
}

model FuenteReporte {
  id                   String   @id @default(cuid())
  reporteId            String   @unique
  ipHash               String?
  fingerprintHash      String?
  cuentaDiasAntiguedad Int?
  reportesPrevios      Int      @default(0)
  reportesConfirmados  Int      @default(0)
  reportesDescartados  Int      @default(0)
  pesoAplicado         Float
  creadoEn             DateTime @default(now())

  reporte Reporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  @@index([ipHash])
  @@index([fingerprintHash])
  @@index([creadoEn])
}

model IdentificadorReportado {
  id                    String    @id @default(cuid())
  identificador         String
  plataformaId          String
  totalReportes         Int       @default(0)
  reportesAutenticados  Int       @default(0)
  reportesAnonimos      Int       @default(0)
  // SPEC-131 (BL-5): contadores APROBADOS (predicado único spec 089/D-08), base de la
  // decisión de visibilidad pública. Escritor único: recalcularYGuardarScore.
  reportesAprobados     Int       @default(0)
  autenticadosAprobados Int       @default(0)
  esVisiblePublicamente Boolean   @default(false)
  ocultoPorComiteEn     DateTime?
  score                 Int       @default(0)
  scoreAnonimo          Int       @default(0)
  scoreAutenticado      Int       @default(0)
  scoreAjustado         Int       @default(0)
  nivelRiesgo           String?
  ultimoReporteEn       DateTime?
  creadoEn              DateTime  @default(now())
  actualizadoEn         DateTime  @updatedAt

  plataforma   Plataforma    @relation(fields: [plataformaId], references: [id])
  eventosMatch EventoMatch[]

  @@unique([identificador, plataformaId])
  @@index([esVisiblePublicamente])
  @@index([totalReportes])
  @@index([score])
}

// SPEC-139 (F5): evento de match — un reporte APROBADO (D-08) sobre un identificador
// que ya tenía ≥1 aprobado de OTRO denunciante (huella S-1 o usuarioId).
// Solo metadatos agregados: NUNCA usuarioId, huellas ni textos (FR-009).
// Entidad global (sin tenant): el match cruza tenants como la consulta pública.
model EventoMatch {
  id                    String   @id @default(cuid())
  identificadorId       String
  reporteNuevoId        String   @unique
  conteoAcumulado       Int
  ciudades              String[]
  conductasCoincidentes String[]
  interCiudad           Boolean  @default(false)
  creadoEn              DateTime @default(now())

  identificador IdentificadorReportado @relation(fields: [identificadorId], references: [id])
  reporteNuevo  Reporte                @relation(fields: [reporteNuevoId], references: [id])

  @@index([identificadorId])
  @@index([interCiudad])
  @@index([creadoEn])
  @@map("eventos_match")
}

// SPEC-110: apelación del identificador reportado (reemplazo del módulo eliminado en SPEC-109).
// Flujo: apelante autenticado -> bandeja del comité -> resolución humana motivada.
// Reglas duras: apelar NO cambia visibilidad; el apelante NO ve contenido de reportes.
model Apelacion {
  id                   String          @id @default(cuid())
  numero               String          @unique
  usuarioId            String
  identificador        String
  plataformaId         String
  motivo               String          @db.Text
  esRepresentante      Boolean         @default(false)
  acreditacion         String?         @db.Text
  estado               EstadoApelacion @default(RECIBIDA)
  comiteId             String?
  asignadoEn           DateTime?
  plazoRespuestaEn     DateTime
  decision             String?
  motivacionResolucion String?         @db.Text
  quitoVisibilidad     Boolean         @default(false)
  resueltoPorId        String?
  resueltoEn           DateTime?
  creadoEn             DateTime        @default(now())
  actualizadoEn        DateTime        @updatedAt

  usuario     Usuario              @relation("ApelacionesUsuario", fields: [usuarioId], references: [id])
  plataforma  Plataforma           @relation(fields: [plataformaId], references: [id])
  comite      Usuario?             @relation("ApelacionesAsignadasComite", fields: [comiteId], references: [id])
  resueltoPor Usuario?             @relation("ApelacionesResueltas", fields: [resueltoPorId], references: [id])
  documentos  DocumentoApelacion[]

  @@index([usuarioId])
  @@index([estado])
  @@index([identificador, plataformaId])
  @@index([creadoEn])
  @@index([resueltoEn])
}

model DocumentoApelacion {
  id             String    @id @default(cuid())
  apelacionId    String
  nombreOriginal String
  rutaArchivo    String
  hashSha256     String
  tamanoBytes    Int
  mimeType       String
  eliminadoEn    DateTime?
  creadoEn       DateTime  @default(now())

  apelacion Apelacion                  @relation(fields: [apelacionId], references: [id], onDelete: Cascade)
  accesos   AccesoDocumentoApelacion[]

  @@index([apelacionId])
  @@index([eliminadoEn])
}

model AccesoDocumentoApelacion {
  id          String   @id @default(cuid())
  documentoId String
  usuarioId   String
  ipAddress   String
  userAgent   String
  accedidoEn  DateTime @default(now())

  documento DocumentoApelacion @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  usuario   Usuario            @relation(fields: [usuarioId], references: [id])

  @@index([documentoId])
  @@index([usuarioId])
}

model ContactoConfianza {
  id            String   @id @default(cuid())
  usuarioId     String
  etiqueta      String?  @db.VarChar(100)
  nota          String?  @db.Text
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuario         Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  identificadores IdentificadorContacto[]

  @@index([usuarioId, activo])
  @@index([usuarioId, creadoEn])
}

model IdentificadorContacto {
  id            String   @id @default(cuid())
  contactoId    String
  valor         String
  tipo          String?
  plataformaId  String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  contacto   ContactoConfianza @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  plataforma Plataforma?       @relation(fields: [plataformaId], references: [id])

  @@unique([contactoId, valor, plataformaId])
  @@index([valor])
  @@index([contactoId, activo])
  @@index([plataformaId])
}

model AlertaSuscripcion {
  id            String    @id @default(cuid())
  usuarioId     String
  identificador String
  plataformaId  String
  activa        Boolean   @default(true)
  ultimoEmailEn DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  plataforma Plataforma @relation(fields: [plataformaId], references: [id])

  @@unique([usuarioId, identificador, plataformaId])
  @@index([usuarioId])
  @@index([identificador, plataformaId])
  @@index([activa])
}

model ClasificacionIA {
  id                    String            @id @default(cuid())
  reporteId             String            @unique
  categoria             CategoriaConducta
  confianza             Float
  contienePii           Boolean           @default(false)
  piiDetectada          String[]
  modeloUsado           String
  latenciaMs            Int
  promptTokens          Int?
  responseTokens        Int?
  rawResponse           String?           @db.Text
  categoriasSecundarias Json?
  votos                 Json?
  usoCascada            Boolean           @default(false)
  modeloCascada         String?
  posibleAgresorPar     Boolean           @default(false)
  creadoEn              DateTime          @default(now())

  reporte      Reporte                    @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  correccion   CorreccionAdmin?
  rubricaVotos ClasificacionRubricaVoto[]

  @@index([categoria])
  @@index([confianza])
}

model CorreccionAdmin {
  id                 String            @id @default(cuid())
  clasificacionId    String            @unique
  categoriaOriginal  CategoriaConducta
  categoriaCorregida CategoriaConducta
  adminId            String
  motivo             String?           @db.Text
  confirmada         Boolean           @default(false)
  creadoEn           DateTime          @default(now())

  clasificacion    ClasificacionIA        @relation(fields: [clasificacionId], references: [id], onDelete: Cascade)
  admin            Usuario                @relation(fields: [adminId], references: [id])
  datasetRegistros DatasetEntrenamiento[]

  @@index([adminId])
}

model DatasetEntrenamiento {
  id                     String            @id @default(cuid())
  texto                  String            @db.Text
  clasificacionCorrecta  CategoriaConducta
  fuente                 String
  correccionId           String?
  usadoParaEntrenamiento Boolean           @default(false)
  textoAnonimizado       Boolean           @default(false)
  creadoEn               DateTime          @default(now())

  correccion CorreccionAdmin?  @relation(fields: [correccionId], references: [id])
  embedding  EmbeddingDataset?

  @@index([usadoParaEntrenamiento])
}

model EmbeddingDataset {
  id          String                     @id @default(cuid())
  datasetId   String                     @unique
  // Índice hnsw sobre vector creado por migración SQL manual (20260717002004_add_pgvector_hnsw_indexes).
  // Prisma no lo gestiona; verificar que exista tras cada migrate deploy.
  vector      Unsupported("vector(768)")
  modeloUsado String
  creadoEn    DateTime                   @default(now())

  dataset DatasetEntrenamiento @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model EmbeddingReporte {
  id          String                     @id @default(cuid())
  reporteId   String                     @unique
  // Índice hnsw sobre vector creado por migración SQL manual (20260717002004_add_pgvector_hnsw_indexes).
  // Prisma no lo gestiona; verificar que exista tras cada migrate deploy.
  vector      Unsupported("vector(768)")
  modeloUsado String
  creadoEn    DateTime                   @default(now())

  reporte Reporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)
}

model RateLimit {
  key           String   @id
  scope         String
  identifier    String
  windowStart   DateTime
  count         Int      @default(0)
  createdAt     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([scope, identifier, windowStart])
}

model SimulacionRun {
  id           String              @id @default(cuid())
  modelo       String
  totalCasos   Int                 @default(0)
  progreso     Int                 @default(0)
  estado       String              @default("PENDIENTE") // PENDIENTE | EN_PROGRESO | COMPLETADA | FALLIDA | CANCELADA
  fechaInicio  DateTime            @default(now())
  fechaFin     DateTime?
  metricasJson Json?
  casosJson    Json? // Set de casos cargado (persistido para reejecución / comparación)
  creadoPorId  String
  creadoPor    Usuario             @relation(fields: [creadoPorId], references: [id])
  casos        SimulacionReporte[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([estado])
  @@index([creadoPorId])
  @@map("simulacion_runs")
}

model SimulacionReporte {
  id                 String        @id @default(cuid())
  simulacionRunId    String
  simulacionRun      SimulacionRun @relation(fields: [simulacionRunId], references: [id], onDelete: Cascade)
  reporteId          String        @unique
  indice             Int
  categoriaEsperada  String?
  secundariaEsperada String?
  createdAt          DateTime      @default(now())

  @@index([simulacionRunId])
  @@index([indice])
  @@index([reporteId])
  @@map("simulacion_reportes")
}

// SPEC-184 (002-PI-079): bloqueo persistente de IPs por ipHash.
model BlockList {
  id            String    @id @default(cuid())
  ipHash        String    @unique @map("ipHash")
  ipOriginal    String?   @map("ipOriginal")
  motivo        String    @map("motivo")
  expiraEn      DateTime? @map("expiraEn")
  creadoPorId   String    @map("creadoPorId")
  creadoEn      DateTime  @default(now()) @map("creadoEn")
  actualizadoEn DateTime  @updatedAt @map("actualizadoEn")

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])

  @@index([ipHash])
  @@map("block_list")
}

// SPEC-184 (002-PI-079): corrida del simulador de abusos (reportes reales).
model SimulacionAbusoRun {
  id             String   @id @default(cuid())
  escenario      String
  totalReportes  Int
  progreso       Int      @default(0)
  estado         String   @default("PENDIENTE") // PENDIENTE | EN_PROGRESO | COMPLETADA | CANCELADA | FALLIDA
  configJson     Json?
  resultadosJson Json?
  nota           String?  @db.VarChar(200)
  creadoPorId    String
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])

  @@index([estado])
  @@index([creadoPorId])
  @@map("simulacion_abuso_runs")
}

model ModuloPermisible {
  id            String   @id @default(cuid())
  clave         String   @unique
  nombre        String
  descripcion   String?
  padreId       String?
  categoria     String
  esCritico     Boolean  @default(false)
  orden         Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  padre      ModuloPermisible?  @relation("JerarquiaModulos", fields: [padreId], references: [id], onDelete: Restrict)
  submodulos ModuloPermisible[] @relation("JerarquiaModulos")
  permisos   PermisoModulo[]

  @@index([padreId])
}

model PermisoModulo {
  id               String   @id @default(cuid())
  rol              String
  moduloId         String
  activo           Boolean  @default(false)
  actualizadoPorId String?
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  modulo         ModuloPermisible @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  actualizadoPor Usuario?         @relation(fields: [actualizadoPorId], references: [id])

  @@unique([rol, moduloId])
  @@index([rol])
}

model ClasificacionRubricaVoto {
  id                String          @id @default(cuid())
  clasificacionIAId String
  clasificacionIA   ClasificacionIA @relation(fields: [clasificacionIAId], references: [id], onDelete: Cascade)
  modelo            String
  categoria         String
  cumple            Boolean
  preguntasJson     Json
  creadoEn          DateTime        @default(now())

  @@index([clasificacionIAId])
  @@map("clasificacion_rubrica_votos")
}

// SPEC-132 (S-4): sesión de carga masiva — el roster de alumnos vive server-side
// con TTL; el token de confirmación firma SOLO el id de esta sesión (sin PII).
model CargaRosterSesion {
  id        String   @id @default(cuid())
  colegioId String
  filas     Json
  creadoEn  DateTime @default(now())
  expiraEn  DateTime

  colegio Colegio @relation(fields: [colegioId], references: [id], onDelete: Cascade)

  @@index([expiraEn])
}

// SPEC-160 (002-PI-059): marcado quirúrgico de entidades demo para purga idempotente.
// La purga borra EXCLUSIVAMENTE por registros de esta tabla (por id); los prefijos
// DEMO-/RPT-DEMO- y los emails @innovadataco.com son defensa en profundidad.
model DemoMarcado {
  id        String   @id @default(cuid())
  entidad   String // nombre de la tabla Prisma/BD: Colegio, Curso, Estudiante, Usuario, Reporte, AuditLog, ...
  entidadId String
  metadata  Json? // { corrida: string, script: string, notas?: string }
  creadoEn  DateTime @default(now())

  @@unique([entidad, entidadId])
  @@index([entidad])
  @@index([entidadId])
  @@map("demo_marcado")
}

// SPEC-171 (Pilar B, I-51): probes de salud de infraestructura (append-only,
// retención corta; los escribe scripts/monitor-probes.mjs).
// SPEC-186 (002-PI-081): añade metodo para distinguir PING / PIGGYBACK / SMOKE.
model HealthProbe {
  id         String   @id @default(cuid())
  senal      String // app | worker | bd | ollama_ping | ollama_smoke | tailscale
  ok         Boolean
  latenciaMs Int      @default(0)
  detalle    String?
  metodo     String?  @default("SMOKE") // PING | PIGGYBACK | SMOKE
  creadoEn   DateTime @default(now())

  @@index([senal, creadoEn])
}

// SPEC-171: incidente de infraestructura abierto tras doble rojo (re-probe).
// Se resuelve solo cuando el probe vuelve a verde. Email con throttle por senal.
model IncidenteInfra {
  id            String    @id @default(cuid())
  senal         String // misma nomenclatura que HealthProbe.senal
  estado        String    @default("ABIERTO") // ABIERTO | RESUELTO
  inicio        DateTime  @default(now())
  fin           DateTime?
  detalle       String?
  ultimoEmailEn DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@index([senal, estado])
}

// SPEC-193 (Fase 1): bitácora de logs de workers y servicios.
// No almacena PII ni texto de reportes; retención acotada por purga explícita.
model WorkerLog {
  id           String   @id @default(cuid())
  servicio     String
  nivel        NivelLog
  mensaje      String   @db.VarChar(500)
  contextoJson Json?
  creadoEn     DateTime @default(now()) @db.Timestamptz(3)

  @@index([servicio, creadoEn(sort: Desc)], name: "idx_worker_logs_servicio_creado")
  @@index([nivel, creadoEn(sort: Desc)], name: "idx_worker_logs_nivel_creado")
  @@index([creadoEn(sort: Desc)], name: "idx_worker_logs_creado")
  @@map("worker_logs")
}

// SPEC-172 (Pilar D.5): snapshot semanal de la deriva del motor en producción
// por categoría (tasa de corrección humana confirmada vs accuracy del banco
// curado). Lo escribe el job semanal y el recálculo bajo demanda; el tablero
// solo lee (cero groupBys pesados por carga).
model DerivaMotorSnapshot {
  id             String   @id @default(cuid())
  semanaInicio   DateTime // lunes 00:00 America/Bogota de la semana medida
  categoria      String // CategoriaConducta
  total          Int // clasificaciones de producción en la ventana
  correcciones   Int // correcciones humanas confirmadas en la ventana
  tasaCorreccion Float // correcciones / total (0 si total = 0)
  accuracyBanco  Float? // recall por categoría del último SimulacionRun COMPLETADA (null = sin baseline)
  brechaPp       Float? // tasaCorreccion − (1 − accuracyBanco), en puntos porcentuales (null = sin baseline)
  alertada       Boolean  @default(false)
  creadoEn       DateTime @default(now())

  @@unique([semanaInicio, categoria])
  @@index([semanaInicio])
}

// SPEC-230 (002-PI-130): expediente que agrupa eventos sobre un identificador
// reportado, visto/desde la perspectiva del padre/tutor.
model Expediente {
  id                              String           @id @default(cuid())
  padreUsuarioId                  String
  identificadorReportado          String
  plataformaId                    String?
  fechaApertura                   DateTime         @db.Timestamptz(6)
  fechaCierre                     DateTime?        @db.Timestamptz(6)
  fechaEscalado                   DateTime?        @db.Timestamptz(6)
  estado                          EstadoExpediente
  scoreGravedadActual             ScoreGravedad    @default(VERDE)
  categoriasDominantesJson        Json?
  numEventos                      Int              @default(0)
  ultimoEventoEn                  DateTime?        @db.Timestamptz(6)
  autoCerradoPorInactividad       Boolean          @default(false)
  expedienteRelacionadoAnteriorId String?
  patronesDetectadosJson          Json?
  createdAt                       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime         @updatedAt @db.Timestamptz(6)

  padre                  Usuario?             @relation(fields: [padreUsuarioId], references: [id])
  eventos                EventoExpediente[]
  // SPEC-234 (002-PI-134): informes consolidados y patrones N1 del expediente.
  informes               InformeConsolidado[]
  patrones               PatronExpediente[]
  expedienteAnterior     Expediente?          @relation("ExpedienteRelacionado", fields: [expedienteRelacionadoAnteriorId], references: [id])
  expedientesPosteriores Expediente[]         @relation("ExpedienteRelacionado")

  @@index([padreUsuarioId, estado])
  @@index([identificadorReportado])
  @@index([estado, updatedAt(sort: Desc)])
}

// SPEC-230 (002-PI-130): evento dentro de un expediente padre.
model EventoExpediente {
  id                     String   @id @default(cuid())
  expedienteId           String
  ordenSecuencial        Int
  reporteId              String?
  fechaEvento            DateTime @db.Timestamptz(6)
  texto                  String   @db.Text
  categoriaDetectada     String?
  confianzaClasificacion Float?
  plataforma             String?
  adjuntosMetaJson       Json?
  createdAt              DateTime @default(now()) @db.Timestamptz(6)

  expediente Expediente @relation(fields: [expedienteId], references: [id])
  reporte    Reporte?   @relation(fields: [reporteId], references: [id])

  @@unique([expedienteId, ordenSecuencial])
  @@index([expedienteId, fechaEvento(sort: Desc)])
}

// SPEC-234 (002-PI-134): informe consolidado de un expediente padre. Resultado
// inmutable de la compilación; cada versión conserva el estado del expediente en
// un momento dado. NUNCA incluye texto original de reportes.
model InformeConsolidado {
  id                             String             @id @default(cuid())
  expedienteId                   String
  versionSecuencial              Int
  scoreValor                     Float
  scoreGravedad                  ScoreGravedad
  categoriasDetectadasJson       Json
  patronesDetectadosJson         Json?
  senalComunitariaJson           Json?
  resumenTextoGenerado           String             @db.Text
  pdfUrl                         String?
  pdfHash                        String?            @unique
  pdfGeneradoEn                  DateTime?          @db.Timestamptz(6)
  generadoPorId                  String?
  tipoRevision                   TipoRevisionComite @default(CONSOLIDACION_EXPEDIENTE)
  guiaAccionCategoriaIdPrincipal String?
  estadoAprobacion               String             @default("PENDIENTE_COMITE")
  aprobadoPorMiembrosJson        Json?
  correccionesJson               Json?
  nivelConfianza                 Float?
  createdAt                      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime           @updatedAt @db.Timestamptz(6)

  expediente  Expediente @relation(fields: [expedienteId], references: [id])
  generadoPor Usuario?   @relation(fields: [generadoPorId], references: [id])

  @@unique([expedienteId, versionSecuencial])
  @@index([expedienteId, createdAt(sort: Desc)])
  @@map("informes_consolidados")
}

// SPEC-234 (002-PI-134): caché de agregados comunitarios por identificador reportado.
// Solo conteos agregados; nunca textos, nombres ni datos re-identificables.
model SenalComunitariaCache {
  identificadorReportado    String   @id
  totalExpedientesActivos   Int      @default(0)
  totalExpedientesCerrados  Int      @default(0)
  totalExpedientesEscalados Int      @default(0)
  categoriasFrecuenciaJson  Json
  primeraAparicionEn        DateTime @db.Timestamptz(6)
  ultimaAparicionEn         DateTime @db.Timestamptz(6)
  paisesJson                Json
  ciudadesJson              Json
  plataformasJson           Json
  invalidado                Boolean  @default(false)
  actualizadoEn             DateTime @updatedAt @db.Timestamptz(6)

  @@index([ultimaAparicionEn(sort: Desc)])
  @@map("senal_comunitaria_cache")
}

// SPEC-234 (002-PI-134): patrón N1 detectado dentro de un expediente padre.
model PatronExpediente {
  id                String               @id @default(cuid())
  expedienteId      String
  tipoPatron        TipoPatronExpediente
  severidad         String // "BAJA" | "MEDIA" | "ALTA"
  nivelConfianza    Float
  descripcionTexto  String               @db.Text
  datosContextoJson Json
  detectadoEn       DateTime             @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)

  expediente Expediente @relation(fields: [expedienteId], references: [id])

  @@index([expedienteId, severidad])
  @@index([expedienteId, tipoPatron])
  @@map("patrones_expediente")
}
