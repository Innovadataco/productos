# BI · .env.bi.example
# Template SIN secretos. Copiar a .env.bi.production en VPS y completar con valores reales.
# Ver INVENTARIO-DE-SECRETOS.md para lista de variables sensibles.
# NUNCA commitear .env.bi.production

# ── JWT compartido con PI (mismo valor que en .env.production de PI) ──────────
# SPEC-029 · imprescindible que coincida exacto con el JWT_SECRET de PI, si no
# el puente de sesión (/api/auth/link) falla la verificación del JWT ephemeral
# emitido por PI (/api/auth/link-bi).
JWT_SECRET=REEMPLAZAR_CON_MISMO_JWT_SECRET_DE_PI

# ── URLs de servicios ──────────────────────────────────────────────────────────
PI_BASE_URL=https://pi.innovadataco.com
# SPEC-029 · BI_BASE_URL lo usa PI (/api/auth/link-bi) para saber a dónde
# rebotar el JWT ephemeral, y BI (/api/auth/link) para armar redirects
# absolutos y validar el host de returnTo.
# En prod: https://bi.innovadataco.com · en dev local: http://localhost:3001
BI_BASE_URL=https://bi.innovadataco.com
VANNA_API_URL=http://bi-vanna:8001
# Ollama en Mac Studio vía Tailscale · puerto 11435 (launchd KEEP_ALIVE=24h)
OLLAMA_HOST=http://100.91.87.86:11435
LLM_MODEL_SQL=qwen2.5:14b
EMBED_MODEL=nomic-embed-text

# ── Superset DB (metadata interna de Superset · no es la réplica PI) ──────────
SUPERSET_DB_HOST=bi-superset-db
SUPERSET_DB_PORT=5432
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_SUPERSET_DB
SUPERSET_DB_NAME=superset

# ── Superset admin ─────────────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=REEMPLAZAR_CON_SECRET_KEY_32_CHARS_MIN
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=REEMPLAZAR_CON_ADMIN_PASSWORD
SUPERSET_ADMIN_EMAIL=gerencia@innovadataco.com

# ── Réplica BI (bi-db-replica · read-only · pg_logical desde pi-db) ──────────
REPLICA_DB_HOST=bi-db-replica
REPLICA_DB_PORT=5432
REPLICA_DB_USER=bi_reader
REPLICA_DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_BI_READER
REPLICA_DB_NAME=proteccion_infantil

# ── bi_admin (escritura sobre tablas bi_catalogo_* · SPEC-007) ─────────────────
# NO tiene permisos sobre tablas replicadas de PI (solo bi_catalogo_*).
# Usado por Prisma migrate/seed y scripts/catalogo-cli.mjs.
BI_ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_BI_ADMIN
DATABASE_URL=postgresql://bi_admin:REEMPLAZAR_CON_PASSWORD_BI_ADMIN@bi-db-replica:5432/proteccion_infantil?schema=public
BI_ADMIN_DATABASE_URL=postgresql://bi_admin:REEMPLAZAR_CON_PASSWORD_BI_ADMIN@bi-db-replica:5432/proteccion_infantil?schema=public

# ── Usuario replicación en pi-db (Fase A COMPLETA · 2026-08-28) ────────────────
# PI_REPLICA_USER y PI_REPLICA_PASSWORD ya están seteados en el .env.bi.production
# del VPS: /opt/proteccion-infantil/bi-repo/.env.bi.production (permisos 600).
# Fábrica BI-2 completó Fase A el 2026-08-28 (ver REPORTE-017).
# Si necesitas el password: gestor de contraseñas IDC · nombre "BI · bi_replica · pi-db · 2026-08-28".

# ── Telegram bot ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REEMPLAZAR_CON_TOKEN_BOTFATHER
# chat_id de Jelkin · múltiples separados por coma: 123456789,987654321
TELEGRAM_AUTHORIZED_CHATS=REEMPLAZAR_CON_CHAT_ID_JELKIN

# ── Red Docker PI (verificado por Fábrica en VPS 2026-08-28) ─────────────────
PI_NET_NAME=002-2026-proteccion-infantil_default

# ── Next.js ────────────────────────────────────────────────────────────────────
NODE_ENV=production
ENABLE_HTTPS_HEADERS=true
NEXT_TELEMETRY_DISABLED=1
