# ==========================================================================
# BI v2 (006) · Plantilla de variables — SOLO NOMBRES, sin valores.
# El archivo real `.env.bi.production` lo crea Jelkin (permisos 600, fuera de
# git) en el clon /opt/proteccion-infantil/bi-repo/ del VPS. Jamás se commitea.
# ==========================================================================

# --- Sesión propia del 006 (NO se comparte nada con PI) ---
# Secreto de firma de la cookie de sesión (cadena aleatoria larga)
BI_AUTH_SECRET=
# Bootstrap del administrador (se verifica con bcrypt; rotar tras primer login)
BI_ADMIN_EMAIL=
BI_ADMIN_PASSWORD=

# --- URL pública del producto ---
NEXT_PUBLIC_APP_URL=https://bi.innovadataco.com

# --- Ollama en Mac Studio vía Tailscale (Fase 2 · motor NL→SQL) ---
OLLAMA_BASE_URL=http://100.91.87.86:11435
LLM_MODEL_SQL=qwen2.5:14b

# --- Endpoints internos (refresh de MVs, tareas programadas) ---
CRON_SECRET=

# --- Zona horaria obligatoria en contenedores (D-69 PI) ---
TZ=America/Bogota
