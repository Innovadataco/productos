# ==========================================================================
# BI v2 (006) · Plantilla de variables — SOLO NOMBRES, sin valores.
# El archivo real `.env.bi.production` lo crea Jelkin (permisos 600, fuera de
# git) en el clon /opt/proteccion-infantil/bi-repo/ del VPS. Jamás se commitea.
# REGLA B3: NADA queda quemado en el código — todo valor configurable
# (límites, umbrales, duraciones, puertos) vive como variable aquí.
# ==========================================================================

# --- Sesión propia del 006 (NO se comparte nada con PI) ---
# Secreto de firma de la cookie de sesión (cadena aleatoria larga)
BI_AUTH_SECRET=
# Bootstrap del administrador (se verifica con bcrypt; rotar tras primer login)
BI_ADMIN_EMAIL=
BI_ADMIN_PASSWORD=
# Duración de la sesión en minutos (720 = 12 h)
BI_SESION_DURACION_MIN=720
# Costo del hash bcrypt del admin de bootstrap
BI_BCRYPT_RONDAS=10

# --- Base de datos propia del 006 (contenedor bi-db · PostgreSQL 16 + pgvector) ---
# Credenciales del Postgres (las consume la imagen al crear el clúster)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# URLs que usan la app y prisma. El host es el nombre del servicio (red interna
# bi-net; bi-db NO publica puerto al host).
# Formato: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@bi-db:5432/<POSTGRES_DB>?schema=public
DATABASE_URL=
# Conexión directa sin pooler (la usa prisma migrate); mismo formato que DATABASE_URL
DIRECT_URL=

# --- Réplica read-only de PI (pg_logical · Fase 1b) ---
# Los VALORES los asigna Jelkin (canal seguro; ver INVENTARIO-DE-SECRETOS.md).
# Origen: Postgres de PI, donde YA EXISTE la publicación bi_replica con la
# lista explícita de tablas operativas. PROHIBIDO replicar tablas con PII
# (Usuario/Password/Session) — Ley 1581.
REPLICA_PI_HOST=
REPLICA_PI_PORT=
REPLICA_PI_DB=
REPLICA_PI_USER=
REPLICA_PI_PASSWORD=

# --- URL pública del producto (OBLIGATORIA: el middleware falla si falta) ---
NEXT_PUBLIC_APP_URL=https://bi.innovadataco.com

# --- Puerto local donde el proxy de bi.innovadataco.com entrega tráfico ---
BI_PORT=3001

# --- Ollama en Mac Studio vía Tailscale (Fase 2 · motor NL→SQL) ---
OLLAMA_BASE_URL=http://100.91.87.86:11435
LLM_MODEL_SQL=qwen2.5:14b

# --- Endpoints internos (refresh de MVs, tareas programadas) ---
CRON_SECRET=

# --- Zona horaria obligatoria en contenedores (D-69 PI) ---
TZ=America/Bogota
