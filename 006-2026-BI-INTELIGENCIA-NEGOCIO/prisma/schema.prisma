// schema.prisma · Catálogo BI + traza + cache semántico
// Producto 006 · BI v2 · SPEC-006 · F3C 2026-09-01
// Portado 1:1 de 005 (BI v1, referencia SOLO LECTURA) — mismos modelos y tipos.
// Los 6 modelos viven en schema `public` con prefijo `bi_` (D-21).
// Aislamiento por prefijo · sin multiSchema (preview inestable en Prisma 6).
// Las vistas materializadas `mv_fact_*` NO van aquí: referencian tablas
// replicadas de PI y romperían la CI en BD vacía (T4). Las crea el script
// de activación de réplica (scripts/replica-setup).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Alpine (node:22-alpine) usa OpenSSL 3: sin este target el engine musl
  // por defecto enlaza contra libssl.so.1.1 y falla en runtime (I-02).
  // "native" cubre CI/desarrollo (glibc).
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ────────────────────────────────────────────────────────────────────────────
// BICatalogoTabla · tablas expuestas al LLM (candado 8)
// ────────────────────────────────────────────────────────────────────────────
model BICatalogoTabla {
  id              String   @id @default(cuid())
  nombreFuente    String   @unique
  nombreLegible   String
  descripcion     String   @default("")
  rolesPermitidos String[]
  activo          Boolean  @default(true)
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  columnas BICatalogoColumna[]
  metricas BICatalogoMetrica[]
  ejemplos BICatalogoEjemplo[]

  @@map("bi_catalogo_tabla")
}

// ────────────────────────────────────────────────────────────────────────────
// BICatalogoColumna · columnas por tabla · sinónimos · roles
// ────────────────────────────────────────────────────────────────────────────
model BICatalogoColumna {
  id            String   @id @default(cuid())
  tablaId       String
  nombreFuente  String
  nombreLegible String
  descripcion   String   @default("")
  tipo          String
  sinonimos     String[] @default([])
  excluida      Boolean  @default(false)
  creadoEn      DateTime @default(now())

  tabla BICatalogoTabla @relation(fields: [tablaId], references: [id], onDelete: Cascade)

  @@unique([tablaId, nombreFuente])
  @@map("bi_catalogo_columna")
}

// ────────────────────────────────────────────────────────────────────────────
// BICatalogoMetrica · métricas de negocio pre-definidas
// ────────────────────────────────────────────────────────────────────────────
model BICatalogoMetrica {
  id            String   @id @default(cuid())
  tablaId       String?
  nombre        String   @unique
  nombreLegible String
  descripcion   String   @default("")
  formulaSQL    String
  categoria     String   @default("general")
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now())

  tabla BICatalogoTabla? @relation(fields: [tablaId], references: [id])

  @@map("bi_catalogo_metrica")
}

// ────────────────────────────────────────────────────────────────────────────
// BICatalogoEjemplo · ejemplos NL→SQL curados
// ────────────────────────────────────────────────────────────────────────────
model BICatalogoEjemplo {
  id                String   @id @default(cuid())
  tablaId           String?
  preguntaNL        String   @unique
  sql               String
  categoriaConsulta String   @default("general")
  verificado        Boolean  @default(true)
  creadoEn          DateTime @default(now())

  tabla BICatalogoTabla? @relation(fields: [tablaId], references: [id])

  @@map("bi_catalogo_ejemplo")
}

// ────────────────────────────────────────────────────────────────────────────
// BIConsultaLog · traza por consulta (candado 12)
// ────────────────────────────────────────────────────────────────────────────
model BIConsultaLog {
  id          String   @id @default(cuid())
  usuarioId   String
  preguntaNL  String
  sqlGenerado String?
  planJson    String?  // plan del LLM (índices, filtros, valores) — candado 12: traza completa
  estado      String   @default("pendiente")
  latenciaMs  Int?
  fuenteCache Boolean  @default(false)
  error       String?
  creadoEn    DateTime @default(now())

  cacheEntrada BICacheSemantico?

  @@index([usuarioId, creadoEn])
  @@map("bi_consulta_log")
}

// ────────────────────────────────────────────────────────────────────────────
// BICacheSemantico · veredictos humanos NL→SQL (candado 7)
// ────────────────────────────────────────────────────────────────────────────
model BICacheSemantico {
  id                String   @id @default(cuid())
  preguntaNL        String   @unique
  sqlAprobado       String
  aprobadoPor       String   @default("human")
  consultaLogId     String?  @unique
  embeddingPregunta Unsupported("vector(768)")?
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  consultaLog BIConsultaLog? @relation(fields: [consultaLogId], references: [id])

  @@map("bi_cache_semantico")
}

// ────────────────────────────────────────────────────────────────────────────
// BIConfig · parámetros de configuración en BD (B3 · Admin IA)
// Clave/valor editable sin despliegue: modelos Ollama, timeouts, umbrales.
// El seed los crea con update:{} — NUNCA pisa lo que el operador editó a mano.
// ────────────────────────────────────────────────────────────────────────────
model BIConfig {
  id            String   @id @default(cuid())
  clave         String   @unique
  valor         String
  descripcion   String   @default("")
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("bi_config")
}
