  "cards": [
    {
      "dot": "cyan",
      "title": "Capas de la app",
      "items": [
        "UI: src/app + src/components (Server Components)",
        "API: un route.ts por endpoint, validación Zod",
        "Servicios: src/lib (auth, proxy, queue, rate-limit, ai/)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Seguridad",
      "items": [
        "JWT httpOnly SameSite (cookie __Host-token)",
        "Texto del reporte: AES-256-GCM DEK por denuncia + KEK",
        "Rate limit en PostgreSQL (fail-open), CSP + HSTS"
      ]
    },
    {
      "dot": "rose",
      "title": "Datos",
      "items": [
        "pgvector: embeddings HNSW + dedup semántica",
        "Cola pg-boss en la misma BD; worker único (advisory lock)",
        "Texto cifrado: ContenidoReporte + LlaveReporte (bi_replica sin acceso)"
      ]
    }
  ]
