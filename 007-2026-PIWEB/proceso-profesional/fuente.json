  "edges": [
    { "id": "e1", "from": "registrar", "to": "verificar", "label": "solicitud de alta" },
    { "id": "e2", "from": "verificar", "to": "completar", "label": "cuenta activa" },
    { "id": "e3", "from": "completar", "to": "directorio", "label": "perfil publicado" },
    { "id": "e4", "from": "directorio", "to": "solicitar", "label": "visible al padre" },
    { "id": "e5", "from": "solicitar", "to": "confirmar", "label": "solicitud recibida" },
    { "id": "e6", "from": "confirmar", "to": "agenda", "label": "cita confirmada", "variant": "emphasis" },
    { "id": "e7", "from": "agenda", "to": "evolucion", "label": "tras la sesión" },
    { "id": "e8", "from": "evolucion", "to": "auditoria", "label": "toda acción", "variant": "security", "role": "branch" }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "Perfil profesional",
      "items": [
        "Registro con correo, especialidad, enfoque y ciudad",
        "Presentación, modalidad virtual o presencial y disponibilidad",
        "Visible en el directorio «Encontrar psicólogo» del área del padre"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cita confirmada",
      "items": [
        "El padre solicita y el profesional confirma o propone otra fecha",
        "La cita queda en la agenda de ambos con recordatorios por correo"
      ]
    },
    {
      "dot": "rose",
      "title": "Evidencia y privacidad",
      "items": [
        "La evolución se registra sin modificar el texto original del reporte",
        "Toda interacción queda auditada",
        "Solo ve los datos estrictamente necesarios del expediente asociado a sus citas"
      ]
    }
  ]
}
