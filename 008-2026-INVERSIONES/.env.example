# Copie este archivo a .env (nunca se versiona). Valores de desarrollo local, no secretos.
# Base del docker-compose.yml de 008 (puerto 5438).
DATABASE_URL="postgresql://inversiones:inversiones_dev@localhost:5438/inversiones?schema=public"
# Base de pruebas de integración (la crea prisma/init/01-base-de-pruebas.sql).
DATABASE_URL_TEST="postgresql://inversiones:inversiones_dev@localhost:5438/inversiones_test?schema=public"
# Login (D-014). Secreto que firma la sesión: 32 bytes o más, sin él la app no arranca (no hay bypass).
# Generar el suyo con `openssl rand -base64 32`; este valor es solo un EJEMPLO de desarrollo, nunca de producción.
# En producción va AUTH_SECRET en el .env.production del servidor (o AUTH_SECRET_FILE con la ruta de un archivo, no las dos).
AUTH_SECRET="ejemplo-de-desarrollo-cambielo-0123456789abcdef"
# Origen público de la app: obligatorio con NODE_ENV=production (CSRF por Origin y enlace de definir clave).
# En local no hace falta: se aceptan http(s)://127.0.0.1:5008 y http(s)://localhost:5008.
# APP_ORIGEN="https://inversiones.innovadataco.com"
# Cifrado (frente «cifrado»): generar con `openssl rand -base64 32`; la copia maestra va en el gestor de Jelk.
CIFRADO_CLAVE_ACTIVA=v1
CIFRADO_CLAVE_V1=
