# Inversiones · plantilla del ÚNICO archivo de producción, SIN VALORES.
# En el VPS va en /opt/inversiones-008/.env.inversiones.production: dueño root, permisos 600, fuera de git.
# (En el repo se llama así y no .env.*: el candado de datos reales rechaza cualquier .env versionado.)
#
# Se usa SOLO como --env-file de Compose para la interpolación: ningún servicio lo carga con env_file y cada
# servicio declara en environment: solo sus variables (ver docker-compose.prod.yml).
# Reglas de los valores: sin comillas, sin espacios y sin «$» (Compose interpolaría lo que siga).
# Cómo generar cada clave sin que quede en el historial: docs/despliegue/produccion.md, paso 2.

# Superusuario de PostgreSQL. Solo lo usa la imagen de la base al crearse.   openssl rand -hex 32
INV_POSTGRES_CLAVE=

# Rol inv_dueno: migrador, comandos de carga y acceso inicial.   clave: openssl rand -hex 32
# (solo letras y números: va dentro de la URL sin codificar)
INV_DUENO_DATABASE_URL=postgresql://inv_dueno:<clave>@inv-008-db:5432/inversiones?schema=public&connection_limit=3

# Rol inv_app: la app. Clave DISTINTA de la de inv_dueno.   openssl rand -hex 32
INV_APP_DATABASE_URL=postgresql://inv_app:<clave>@inv-008-db:5432/inversiones?schema=public&connection_limit=5

# Secreto de sesión del login, 32 bytes o más.   openssl rand -base64 48 | tr -d '\n'
INV_AUTH_SECRET=

# Cifrado (contrato del frente cifrado): la clave activa y la clave v1 (32 bytes en base64:
# openssl rand -base64 32). El formato de CIFRADO_CLAVE_ACTIVA lo fija ese frente (por confirmar).
INV_CIFRADO_CLAVE_ACTIVA=
INV_CIFRADO_CLAVE_V1=

# Origen público: lo usa el login para la verificación CSRF.
APP_ORIGEN=https://inversiones.innovadataco.com

# Clave PÚBLICA de age (empieza por age1). La privada vive en el gestor de contraseñas de Jelk, nunca aquí.
INV_AGE_PUBLICA=

# Vigía de convivencia (inv-008-vigia): el MISMO bot y chat de las tareas programadas (decisión de Jelk).
# Los pone Jelk (o un script suyo) sin pasar por el chat ni por un log. Si se rota el token: Mac y VPS.
INV_TELEGRAM_BOT_TOKEN=
INV_TELEGRAM_CHAT_ID=

# Opcionales del vigía (valores por defecto en el compose).
# INV_VIGIA_UMBRAL_MEMAVAILABLE_MIB=1024
# INV_VIGIA_INTERVALO_S=60

# Respaldo diario: gid NUMÉRICO del grupo «respaldo» del VPS (getent group respaldo), dueño de lectura de
# /var/backups/idc/. Lo lee el coordinador en el VPS al desplegar.
INV_RESPALDO_GID=

# Opcional: hora del respaldo diario (HHMM, COT).
# INV_RESPALDO_HORA=0230
