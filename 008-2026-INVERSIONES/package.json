{
  "name": "008-2026-inversiones",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 5008",
    "dev:https": "next dev --experimental-https -H 127.0.0.1 -p 5008",
    "build": "next build",
    "build:precios": "esbuild scripts/servicio-precios.ts --bundle --platform=node --format=esm --target=node22 --external:@prisma/client --outfile=.next/precios/servicio-precios.mjs",
    "start": "next start -H 127.0.0.1 -p 5008",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integracion": "node scripts/integracion.mjs",
    "test:e2e": "playwright test",
    "test:cobertura": "npm run test:cobertura:unida",
    "test:cobertura:unida": "npm run test:cobertura:unidad && npm run test:cobertura:integracion && npm run test:cobertura:unir",
    "test:cobertura:unidad": "rm -rf node_modules/.cache/cobertura-blobs && vitest run --config vitest.config.ts --coverage --reporter=default --reporter=blob --outputFile.blob=node_modules/.cache/cobertura-blobs/unidad.json",
    "test:cobertura:integracion": "node scripts/integracion.mjs --coverage --reporter=default --reporter=blob --outputFile.blob=node_modules/.cache/cobertura-blobs/integracion.json",
    "test:cobertura:unir": "vitest run --config vitest.cobertura.config.ts --merge-reports=node_modules/.cache/cobertura-blobs",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "importar:trii": "tsx scripts/importar-trii.ts",
    "escision:registrar": "tsx scripts/registrar-escision.ts",
    "lotes:construir": "tsx scripts/construir-lotes.ts",
    "lote:escision": "tsx scripts/lote-escision.ts",
    "precios:actualizar": "tsx scripts/actualizar-precios.ts",
    "precios:depurar": "tsx scripts/depurar-precios.ts",
    "precios:exportar": "tsx scripts/exportar-precios.ts",
    "precios:importar": "tsx scripts/importar-precios.ts",
    "fondo:exportar": "tsx scripts/exportar-valores-fondo.ts",
    "fondo:importar": "tsx scripts/importar-valores-fondo.ts",
    "ia:evaluar": "tsx scripts/ia-evaluar.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "3.0.3",
    "jose": "6.2.3",
    "next": "16.4.6",
    "qrcode-generator": "2.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.15.17",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.5",
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "prisma": "5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "3.2.7",
    "yaml": "^2.8.0"
  }
}
