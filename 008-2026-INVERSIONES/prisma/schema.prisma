// 008 · INVERSIONES · esquema de la Fase 1 (núcleo).
// Fuente: gestión de 008, MODELO-DATOS-FASE-1.md v0.5 (§2b «núcleo» + catálogo).
// Quedan para después: ValorPosicionDiario, PortafolioDiario (caché), ReporteEnviado
// (hito 5) y AjusteCostoLote (se sigue al portal de A&V).
//
// Reglas: dinero en Decimal (nunca Float), cantidades de acciones en BigInt, fechas de
// negocio en @db.Date (hora de Colombia). Lo que Prisma no expresa (CHECK, índices
// parciales, exclusión de vigencias, disparadores) va en SQL dentro de las migraciones.
// Toda relación es onDelete: Restrict, onUpdate: Restrict, y toda FK tiene su índice.
// scripts/verificar-esquema.sql (el guardián del migrador) exige todo eso y los índices
// únicos en la base real; las pruebas de integración verifican que exista y muerda.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, btree_gist]
}

// ───────────── Enums ─────────────
enum RolUsuario {
  DUENO
  FAMILIA
}

enum TipoFuente {
  TRII_CAJA
  TRII_ORDENES
  TRII_DIVIDENDOS
  AV_CERTIFICACION
  AV_LOTES
  REGISTRO_DECRETOS // CSV del dueño con los decretos de dividendos (fase C, C4a)
  REGISTRO_RENDIMIENTOS_FIC // CSV del dueño con los rendimientos del FIC pagados en efectivo y su retención
}

enum EstadoCarga {
  VALIDANDO
  CARGADO
  RECHAZADO
  REVERTIDO
}

enum TipoInstrumento {
  ACCION
  FIC
}

enum Moneda {
  COP
}

enum TipoMovimientoCaja {
  DEPOSITO
  RETIRO
}

enum EstadoMovimiento {
  APROBADO
  RECHAZADO
}

enum LadoOrden {
  COMPRA
  VENTA
}

enum EstadoOrden {
  APROBADO
  CANCELADO
}

enum TipoDividendo {
  ORDINARIO
  EXTRAORDINARIO
  FRACCION_ESCISION // no es dividendo: va a ganancia realizada (costo 0)
}

enum CategoriaAjusteCaja {
  APORTE_FIC
  FRACCION_ESCISION
  GMF
  RETENCION
  INTERES
  CUSTODIA
  OTRO
  RENDIMIENTO_FIC // rendimiento del fondo pagado en efectivo (+, entra a la caja); no es un aporte
}

enum FuenteAjuste {
  MANUAL
  EXTRACTO
  CERTIFICACION
  INFERIDO
}

enum OrigenLote {
  COMPRA
  ESCISION
}

enum FuenteCosto {
  TRII_ORDEN
  AV_PORTAL
}

enum MetodoAsignacion {
  FIFO
  ESPECIFICA
}

enum TipoEventoCorporativo {
  ESCISION
}

enum TipoMovimientoFondo {
  CONSTITUCION
  APORTE
  RETIRO
  AJUSTE
}

/// Lo que dice el encargo del fondo: el pago del rendimiento («PAGO DE RDTOS») y su retención en la fuente («RTE/FTE»).
enum TipoRendimientoFondo {
  RENDIMIENTO
  RETENCION
}

enum EstadoPrecio {
  VERIFICADO
  NO_VERIFICADO
}

enum ResultadoConciliacion {
  CUADRA
  NO_CUADRA
  PARCIAL
}

enum TipoControl {
  FRACCION
  CANTIDAD
  VALOR
  EFECTIVO
  FONDO
  PRECIO
  COSTO_LOTE
}

enum ResultadoControl {
  CUADRA
  NO_CUADRA
  PENDIENTE_LIQUIDACION
}

enum AccionPlan {
  COMPRAR
  VENDER
  NO_ACTUAR // «mantener hasta…»: también se registra y se mide
}

enum CondicionRegla {
  NINGUNA // postura sin condición («mantener hasta el dividendo», «vender N»)
  CIERRE_BAJO // se toca si el cierre queda por debajo del nivel
  CIERRE_SOBRE // se toca si el cierre queda por encima del nivel
  MONTO_ORDEN_BAJO // de portafolio: no operar por debajo de un monto por orden
  LIBRE // texto sin nivel calculable («siempre orden límite»)
}

// ───────────── Usuarios ─────────────
model Usuario {
  id                  String                @id @default(cuid())
  email               String                @unique @db.Citext
  rol                 RolUsuario
  telegramChatId      BigInt?
  activo              Boolean               @default(true)
  creadoEn            DateTime              @default(now()) @db.Timestamptz(6)
  // Login (D-014). Hash bcrypt de costo 12; null = la cuenta no puede entrar.
  claveHash           String?
  // Va en el JWT: subirla cierra todas las sesiones abiertas (cambio de clave, «cerrar todas»).
  // El disparador usuario_transiciones (SQL) impide bajarla y exige subirla al cambiar o quitar la
  // clave y al apagar el TOTP; también impide bajar totpUltimoPaso con el TOTP activo.
  sesionVersion       Int                   @default(1)
  // 5 fallos de clave en 15 min bloquean la cuenta 15 min; los del segundo paso, cada vez el doble (hasta 24 h).
  bloqueadoHasta      DateTime?             @db.Timestamptz(6)
  // TOTP del dueño. Sobre AES-256-GCM del secreto (src/cifrado, AAD «usuario.totp» + id); null = sin secreto.
  // Con secreto y sin activar, el secreto está pendiente de confirmar en el enrolamiento.
  totpSecreto         Json?
  totpActivadoEn      DateTime?             @db.Timestamptz(6)
  // Antireplay: el último paso de 30 s aceptado; uno menor o igual ya no entra.
  totpUltimoPaso      Int?
  // sha256 del `jti` de la pre-sesión vigente: solo vale la más reciente y se borra al pasar el segundo paso.
  presesionHash       String?               @db.Char(64)
  cargas              CargaArchivo[]
  ajustesCaja         AjusteCaja[]
  planesAprobados     PlanVersion[]
  decisiones          Decision[]
  enlaces             EnlaceDecisionOrden[]
  intentos            IntentoIngreso[]
  tokensAcceso        TokenAcceso[]
  codigosRecuperacion CodigoRecuperacion[]
  configsIa           ConfigIa[]
  tarifasComision     TarifaComision[]

  @@map("usuario")
}

enum ResultadoIngreso {
  EXITO // la clave es correcta (primer paso): con TOTP abre la pre-sesión, no la sesión
  CLAVE_INCORRECTA
  USUARIO_INEXISTENTE
  SIN_CLAVE
  CUENTA_BLOQUEADA
  CUENTA_INACTIVA
  ROL_NO_PERMITIDO
  CLAVE_DEFINIDA // la clave se fijó con un enlace de un solo uso
  TOKEN_INVALIDO // enlace inexistente, vencido, ya usado o reemplazado
  // Segundo paso (TOTP). Los fallos cuentan para el bloqueo de la cuenta y para el tope por IP.
  TOTP_EXITO // código TOTP correcto: se abre la sesión
  TOTP_INCORRECTO
  TOTP_REPETIDO // código de un paso ya usado (antireplay)
  RECUPERACION_USADA // código de recuperación correcto (se gasta)
  RECUPERACION_INVALIDA
  TOTP_ENROLADO // el dueño confirmó el secreto nuevo
  TOTP_REINICIADO // `crear-acceso-inicial --reiniciar-totp` (lo corre Jelk)
  CODIGOS_REGENERADOS
  BLOQUEO_SEGUNDO_PASO // marca de un bloqueo por fallos del segundo paso (si sigue a otro, dura el doble)
  TOTP_PENDIENTE // se generó un secreto pendiente de enrolar (uno por ventana de enrolamiento)
}

enum PropositoToken {
  INICIAL
  RECUPERACION
}

/// Intentos de inicio de sesión y de definir clave (D-014). Solo inserción (disparador en la migración).
/// No guarda el correo tecleado ni la contraseña: si el correo no existe, usuarioId queda vacío.
/// Índices parciales (en SQL, Prisma no los expresa): fallos por IP y último éxito por cuenta.
/// Purga (pendiente, deuda aceptada): borrar lo de más de 30 días solo por una vía explícita, con el rol
/// dueño y `SET LOCAL inv.reversion = 'on'` dentro de su transacción (la salida del disparador).
model IntentoIngreso {
  id         String           @id @default(cuid())
  usuarioId  String?
  usuario    Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ip         String?          @db.Inet
  resultado  ResultadoIngreso
  ocurridoEn DateTime         @default(now()) @db.Timestamptz(6)

  @@index([usuarioId, ocurridoEn])
  @@map("intento_ingreso")
}

/// Enlace de un solo uso para definir la clave (D-014: no hay contraseña inicial). Guarda solo el
/// sha256 del token; el token va en el fragmento de la URL y nunca toca la base ni los logs.
/// Vence a los 30 min, se invalida al usarse y emitir uno nuevo deja sin valor los anteriores (solo vale
/// el más reciente del usuario). Un disparador admite un único UPDATE: marcar `usadoEn` una vez.
model TokenAcceso {
  id        String         @id @default(cuid())
  usuarioId String
  usuario   Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash String         @unique @db.Char(64)
  proposito PropositoToken
  venceEn   DateTime       @db.Timestamptz(6)
  usadoEn   DateTime?      @db.Timestamptz(6)
  creadoEn  DateTime       @default(now()) @db.Timestamptz(6)

  @@index([usuarioId, creadoEn])
  @@map("token_acceso")
}

/// Códigos de recuperación del TOTP: 10 por generación, de 80 bits; se muestran una vez y aquí va solo
/// su sha256. Un disparador admite un único UPDATE por fila: marcar `usadoEn` (se gastó) o `anuladoEn` (se
/// regeneraron o se reinició el TOTP). No se borran. Vigente = sin las dos marcas (índice parcial en SQL).
model CodigoRecuperacion {
  id         String    @id @default(cuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  codigoHash String    @unique @db.Char(64)
  creadoEn   DateTime  @default(now()) @db.Timestamptz(6)
  usadoEn    DateTime? @db.Timestamptz(6)
  anuladoEn  DateTime? @db.Timestamptz(6)

  @@index([usuarioId])
  @@map("codigo_recuperacion")
}

// ───────────── Importación y trazabilidad ─────────────
model CargaArchivo {
  id             String         @id @default(cuid())
  tipoFuente     TipoFuente
  nombreArchivo  String
  sha256         String         @db.Char(64)
  fechaCorte     DateTime?      @db.Date
  estado         EstadoCarga
  filasTotal     Int?
  filasNuevas    Int?
  filasRepetidas Int?
  errores        Json? // solo códigos y números de fila, nunca valores reales
  // El archivo original NO se guarda (decisión del CEO): solo su sha256 y las filas.
  cargadoPorId   String
  cargadoPor     Usuario        @relation(fields: [cargadoPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cargadoEn      DateTime       @default(now()) @db.Timestamptz(6)
  revertidaPorId String? // solo DUENO (Jelkin autoriza); con revertidaEn, solo junto con REVERTIDO (disparador)
  revertidaEn    DateTime?      @db.Timestamptz(6)
  filasNacidas   FilaFuente[]
  filas          FilaDeCarga[]
  filasLoteAv    FilaLoteAv[]
  certificacion  Certificacion?

  @@index([tipoFuente, sha256])
  @@index([cargadoPorId])
  @@map("carga_archivo")
}

/// Fila cruda de un archivo. Clave natural = sha256 de los campos canónicos SIN estado ni
/// comisión, + `ocurrencia` (n-ésima fila idéntica del archivo) para no fusionar filas legítimas.
model FilaFuente {
  id             String              @id @default(cuid())
  tipoFuente     TipoFuente
  claveNatural   String              @db.Char(64)
  ocurrencia     Int                 @db.SmallInt
  primeraCargaId String
  primeraCarga   CargaArchivo        @relation(fields: [primeraCargaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  primeraFilaNo  Int
  crudo          Json
  vistaEn        FilaDeCarga[]
  movimientoCaja MovimientoCaja?
  orden          Orden?
  dividendo      Dividendo?
  filaLoteAv     FilaLoteAv?
  decreto        DividendoDecretado?
  rendimiento    RendimientoFondo?

  @@unique([tipoFuente, claveNatural, ocurrencia])
  @@index([primeraCargaId])
  @@map("fila_fuente")
}

/// Qué carga vio qué fila: reimportar no duplica, pero deja registro.
model FilaDeCarga {
  cargaId      String
  filaNo       Int
  filaFuenteId String
  carga        CargaArchivo @relation(fields: [cargaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  filaFuente   FilaFuente   @relation(fields: [filaFuenteId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([cargaId, filaNo])
  @@index([filaFuenteId])
  @@map("fila_de_carga")
}

// ───────────── Catálogo ─────────────
model Instrumento {
  id                   String                  @id @default(cuid())
  tipo                 TipoInstrumento
  nemotecnico          String?                 @unique // BVC (acciones)
  simboloTrii          String?                 @unique // si difiere del nemotécnico
  codigoFic            String?                 @unique // codigo_negocio de la SFC (fondo)
  nombre               String
  moneda               Moneda                  @default(COP)
  activo               Boolean                 @default(true)
  notaCosto            String? // «costo según Acciones & Valores, sin ajuste por escisión»
  nitFondo             String?                 @unique // NIT del fondo en la certificación de A&V (solo FIC): así se reconoce su fila
  simbolos             SimboloPrecio[]
  ordenes              Orden[]
  dividendos           Dividendo[]
  dividendosDecretados DividendoDecretado[]
  lotes                Lote[]
  filasLoteAv          FilaLoteAv[]
  posCert              CertificacionPosicion[]
  fondosCert           CertificacionFondo[]
  movsFondo            MovimientoFondo[]
  rendimientosFondo    RendimientoFondo[]
  valoresUnidad        ValorUnidadFondo[]
  precios              PrecioCierre[]
  controles            ControlConciliacion[]
  eventosOrigen        EventoCorporativo[]     @relation("EventoOrigen")
  eventosDestino       EventoCorporativo[]     @relation("EventoDestino")
  reglasPlan           ReglaPlan[]
  decisiones           Decision[]

  @@map("instrumento")
}

/// Nemotécnico BVC → símbolo del proveedor (Yahoo `.CL`), con vigencia y verificación.
model SimboloPrecio {
  id               String      @id @default(cuid())
  instrumentoId    String
  instrumento      Instrumento @relation(fields: [instrumentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  proveedor        String      @default("yahoo")
  simbolo          String
  vigenteDesde     DateTime    @db.Date
  vigenteHasta     DateTime?   @db.Date
  verificadoEn     DateTime?   @db.Date
  verificadoContra String?

  @@index([instrumentoId, proveedor])
  @@map("simbolo_precio")
}

/// Días hábiles y festivos de la BVC: se siembra, no se deriva.
model CalendarioBvc {
  dia     DateTime @id @db.Date
  esHabil Boolean
  nota    String?

  @@map("calendario_bvc")
}

// ───────────── Hechos de Trii (solo inserción) ─────────────
model MovimientoCaja {
  id           String             @id @default(cuid())
  filaFuenteId String             @unique
  filaFuente   FilaFuente         @relation(fields: [filaFuenteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ocurridoEn   DateTime           @db.Timestamptz(6)
  fecha        DateTime           @db.Date
  tipo         TipoMovimientoCaja
  estado       EstadoMovimiento
  monto        Decimal            @db.Decimal(20, 4)
  moneda       Moneda             @default(COP)

  @@index([fecha])
  @@map("movimiento_caja")
}

model Orden {
  id                 String                @id @default(cuid())
  filaFuenteId       String                @unique
  filaFuente         FilaFuente            @relation(fields: [filaFuenteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ejecutadaEn        DateTime              @db.Timestamptz(6)
  fechaOperacion     DateTime              @db.Date
  fechaLiquidacion   DateTime              @db.Date // T+2 hábiles según CalendarioBvc
  instrumentoId      String
  instrumento        Instrumento           @relation(fields: [instrumentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lado               LadoOrden
  estado             EstadoOrden
  cantidadCompletada BigInt
  cantidadSolicitada BigInt?
  cantidadPendiente  BigInt                @default(0)
  precioUnitario     Decimal               @db.Decimal(20, 6)
  totalInvertido     Decimal               @db.Decimal(20, 4) // SIN comisión
  comision           Decimal               @db.Decimal(20, 4)
  totalEstimado      Decimal               @db.Decimal(20, 4) // compra: + comisión · venta: − comisión. La caja usa este
  moneda             Moneda                @default(COP)
  lote               Lote?
  asignaciones       AsignacionVenta[]
  enlacesDecision    EnlaceDecisionOrden[]

  @@index([instrumentoId, fechaOperacion])
  @@map("orden")
}

/// Dividendo recibido. El CSV de Trii trae el NETO; bruto = decreto × acciones. El enlace con el decreto no se guarda
/// (la tabla es de solo inserción): el cruce se calculará al leer (fase C, C5b).
model Dividendo {
  id            String              @id @default(cuid())
  filaFuenteId  String              @unique
  filaFuente    FilaFuente          @relation(fields: [filaFuenteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fechaPago     DateTime            @db.Date
  instrumentoId String
  instrumento   Instrumento         @relation(fields: [instrumentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tipo          TipoDividendo       @default(ORDINARIO)
  montoNeto     Decimal             @db.Decimal(20, 4)
  // Obsoletas desde la fase C (migración *_datos_oficiales): siempre nulas (dividendo_viejas_nulas_chk) y nadie las
  // escribe (tests/unit/datos-oficiales/columnas-viejas.test.ts). Se borran en una migración posterior de «contrato».
  montoBruto    Decimal?            @db.Decimal(20, 4)
  retencion     Decimal?            @db.Decimal(20, 4)
  tasaRetencion Decimal?            @db.Decimal(9, 6)
  decretadoId   String?
  decretado     DividendoDecretado? @relation(fields: [decretadoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  eventoId      String? // FRACCION_ESCISION: evento cuya fracción pagó esta fila
  evento        EventoCorporativo?  @relation(fields: [eventoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  moneda        Moneda              @default(COP)

  @@index([instrumentoId, fechaPago])
  @@index([decretadoId])
  @@index([eventoId])
  @@map("dividendo")
}

/// Lo que anunció el emisor (fuente del bruto), una fila por cuota, tal como lo publica la fuente oficial (la fecha ex
/// no se calcula). Lo registra el dueño (vía B, REGISTRO_DECRETOS); solo inserción y retiro (inv_solo_retiro): un
/// cambio es la versión v+1, que retira a la v, y un decreto mal registrado se anula con una versión nueva `anulada`
/// (la base exige una vigente por clave y versiones sin repetir; la cadena v → v+1 la cuida el camino de escritura).
/// Vigente = reemplazadoEn nulo; quien lee toma solo las vigentes y no anuladas. Solo en pesos y en dinero (P11).
model DividendoDecretado {
  id                String        @id @default(cuid())
  filaFuenteId      String        @unique
  filaFuente        FilaFuente    @relation(fields: [filaFuenteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  instrumentoId     String
  instrumento       Instrumento   @relation(fields: [instrumentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tipo              TipoDividendo // nunca FRACCION_ESCISION
  valorPorAccion    Decimal       @db.Decimal(20, 6)
  fechaAnuncio      DateTime      @db.Date
  cuota             Int           @db.SmallInt // 1 a 12
  fechaEx           DateTime      @db.Date
  fechaPago         DateTime      @db.Date
  moneda            Moneda        @default(COP)
  // https de la SFC o de la BVC, o sfc:<radicado> (dividendo_decretado_referencia_chk)
  referenciaOficial String
  nota              String?
  version           Int           @default(1)
  anulada           Boolean       @default(false)
  registradoEn      DateTime      @default(now()) @db.Timestamptz(6) // la pone la base (inv_solo_retiro)
  reemplazadoEn     DateTime?     @db.Timestamptz(6)
  recibidos         Dividendo[] // obsoleta: dividendo."decretadoId" es siempre nulo

  @@unique([instrumentoId, fechaAnuncio, tipo, cuota, version], map: "dividendo_decretado_version_key")
  @@index([instrumentoId, fechaPago])
  @@index([instrumentoId, fechaEx])
  @@map("dividendo_decretado")
}

/// Partidas de caja que ningún CSV trae. Signo: + entra, − sale.
model AjusteCaja {
  id                  String              @id @default(cuid())
  fecha               DateTime            @db.Date
  monto               Decimal             @db.Decimal(20, 4)
  categoria           CategoriaAjusteCaja
  fuente              FuenteAjuste
  motivo              String
  referenciaEvidencia String?
  creadoPorId         String
  creadoPor           Usuario             @relation(fields: [creadoPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creadoEn            DateTime            @default(now()) @db.Timestamptz(6)
  moneda              Moneda              @default(COP)
  movimientoFondo     MovimientoFondo?
  rendimientoFondo    RendimientoFondo?
  eventoId            String?
  evento              EventoCorporativo?  @relation(fields: [eventoId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([fecha])
  @@index([creadoPorId])
  @@index([eventoId])
  @@map("ajuste_caja")
}

// ───────────── Lotes, escisión y ventas ─────────────
model EventoCorporativo {
  id                String                @id @default(cuid())
  tipo              TipoEventoCorporativo
  fecha             DateTime              @db.Date
  origenId          String
  origen            Instrumento           @relation("EventoOrigen", fields: [origenId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  destinoId         String
  destino           Instrumento           @relation("EventoDestino", fields: [destinoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  razon             Decimal?              @db.Decimal(20, 10)
  fechaPagoFraccion DateTime?             @db.Date
  montoFraccion     Decimal?              @db.Decimal(20, 4)
  nota              String?
  lotes             Lote[]
  ajustesCaja       AjusteCaja[]
  dividendos        Dividendo[]

  @@unique([tipo, origenId, destinoId, fecha])
  @@index([origenId])
  @@map("evento_corporativo")
}

/// Lote de compra (sale de una orden) o de escisión (sale de un evento). Costo SIN comisión.
model Lote {
  id               String             @id @default(cuid())
  instrumentoId    String
  instrumento      Instrumento        @relation(fields: [instrumentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  origen           OrigenLote
  ordenId          String?            @unique
  orden            Orden?             @relation(fields: [ordenId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  eventoId         String?
  evento           EventoCorporativo? @relation(fields: [eventoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  loteOrigenId     String?
  loteOrigen       Lote?              @relation("CadenaEscision", fields: [loteOrigenId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lotesDerivados   Lote[]             @relation("CadenaEscision")
  fechaCompra      DateTime           @db.Date
  fechaLiquidacion DateTime           @db.Date
  cantidad         BigInt
  costoUnitario    Decimal            @db.Decimal(20, 6)
  costoTotal       Decimal            @db.Decimal(20, 4)
  comision         Decimal            @default(0) @db.Decimal(20, 4)
  fuenteCosto      FuenteCosto
  filasAv          FilaLoteAv[]
  asignaciones     AsignacionVenta[]

  @@index([instrumentoId, fechaCompra, id])
  @@index([loteOrigenId])
  @@map("lote")
}

model AsignacionVenta {
  id           String           @id @default(cuid())
  ordenVentaId String
  ordenVenta   Orden            @relation(fields: [ordenVentaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  loteId       String
  lote         Lote             @relation(fields: [loteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cantidad     BigInt
  costoBase    Decimal          @db.Decimal(20, 4)
  metodo       MetodoAsignacion @default(FIFO)
  bloqueada    Boolean          @default(false)

  @@unique([ordenVentaId, loteId])
  @@index([loteId])
  @@map("asignacion_venta")
}

// ───────────── Acciones & Valores ─────────────
model FilaLoteAv {
  id               String       @id @default(cuid())
  cargaId          String
  carga            CargaArchivo @relation(fields: [cargaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  filaFuenteId     String       @unique
  filaFuente       FilaFuente   @relation(fields: [filaFuenteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fechaCorte       DateTime     @db.Date
  instrumentoId    String
  instrumento      Instrumento  @relation(fields: [instrumentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fechaCompra      DateTime     @db.Date
  cantidad         BigInt
  precioCompra     Decimal      @db.Decimal(20, 6)
  precioValoracion Decimal?     @db.Decimal(20, 6)
  valorMercado     Decimal?     @db.Decimal(20, 4)
  loteId           String?
  lote             Lote?        @relation(fields: [loteId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([fechaCorte, instrumentoId])
  @@index([cargaId])
  @@index([instrumentoId])
  @@index([loteId])
  @@map("fila_lote_av")
}

model Certificacion {
  id                 String                  @id @default(cuid())
  cargaId            String                  @unique
  carga              CargaArchivo            @relation(fields: [cargaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fechaCorte         DateTime                @unique @db.Date
  saldoEfectivo      Decimal                 @db.Decimal(20, 4)
  referenciaEfectivo String? // de qué fila del PDF salió el saldo («p2:f17»)
  /// Retiro (corte equivocado): la reemplaza otra certificación vigente del MISMO archivo con su corte real. Una sola
  /// vez y sin tocar nada más (disparador); lo retirado y sus conciliaciones quedan como historia. Lo hace solo
  /// src/importacion/av/corregir.ts. Una retirada no admite conciliaciones, posiciones ni fondos nuevos.
  retiradaEn         DateTime?               @db.Timestamptz(6)
  reemplazadaPorId   String?                 @unique
  reemplazadaPor     Certificacion?          @relation("ReemplazoDeCertificacion", fields: [reemplazadaPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reemplazaA         Certificacion?          @relation("ReemplazoDeCertificacion")
  posiciones         CertificacionPosicion[]
  fondos             CertificacionFondo[]
  conciliaciones     Conciliacion[]

  @@unique([id, fechaCorte]) // destino de la FK compuesta de Conciliacion
  @@map("certificacion")
}

model CertificacionPosicion {
  certificacionId  String
  certificacion    Certificacion @relation(fields: [certificacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  instrumentoId    String
  instrumento      Instrumento   @relation(fields: [instrumentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cantidad         BigInt
  precioValoracion Decimal       @db.Decimal(20, 6)
  valorMercado     Decimal       @db.Decimal(20, 4)
  referenciaPdf    String? // filas del PDF que se sumaron («p1:f2,p1:f3»)

  @@id([certificacionId, instrumentoId])
  @@index([instrumentoId])
  @@map("certificacion_posicion")
}

model CertificacionFondo {
  certificacionId String
  certificacion   Certificacion @relation(fields: [certificacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  instrumentoId   String
  instrumento     Instrumento   @relation(fields: [instrumentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  encargo         String
  saldo           Decimal       @db.Decimal(20, 4)
  unidades        Decimal?      @db.Decimal(24, 8)
  referenciaPdf   String? // de qué fila del PDF salió («p1:f1»)

  @@id([certificacionId, instrumentoId])
  @@index([instrumentoId])
  @@map("certificacion_fondo")
}

// ───────────── Fondo (FIC) ─────────────
/// Unidades del fondo, de solo inserción. En SQL (migración movimiento_fondo_reglas): unidades > 0 (un AJUSTE, ≠ 0),
/// monto nulo o > 0; una CONSTITUCION o un APORTE exigen su AjusteCaja APORTE_FIC de la MISMA fecha, con −monto; a lo
/// sumo una CONSTITUCION por fondo. La escribe solo src/fondo/movimiento.ts.
model MovimientoFondo {
  id           String              @id @default(cuid())
  fondoId      String
  fondo        Instrumento         @relation(fields: [fondoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fecha        DateTime            @db.Date
  unidades     Decimal             @db.Decimal(24, 8)
  monto        Decimal?            @db.Decimal(20, 4)
  tipo         TipoMovimientoFondo
  fuente       FuenteAjuste
  ajusteCajaId String?             @unique
  ajusteCaja   AjusteCaja?         @relation(fields: [ajusteCajaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([fondoId, fecha])
  @@map("movimiento_fondo")
}

/// Rendimientos del fondo pagados en efectivo y su retención, de solo inserción (frente fondo-rendimientos). Un hecho por
/// fila del CSV del dueño (fila cruda cifrada) y uno por (fondo, fecha, tipo). El PAGO llega NETO a la caja: solo el
/// RENDIMIENTO se enlaza a su AjusteCaja RENDIMIENTO_FIC (+valor, la misma fecha); la RETENCION queda como hecho del fondo
/// y no mueve la caja (restarla otra vez descontaría dos veces). En SQL (migración rendimientos_fondo): valor > 0 sin NaN,
/// fecha finita, el enlace por tipo, la coherencia con el ajuste y que el fondo sea un FIC. La escribe solo
/// src/fondo/rendimientos/guardar.ts.
model RendimientoFondo {
  id           String               @id @default(cuid())
  filaFuenteId String               @unique
  filaFuente   FilaFuente           @relation(fields: [filaFuenteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fondoId      String
  fondo        Instrumento          @relation(fields: [fondoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fecha        DateTime             @db.Date
  tipo         TipoRendimientoFondo
  valor        Decimal              @db.Decimal(20, 4)
  ajusteCajaId String?              @unique
  ajusteCaja   AjusteCaja?          @relation(fields: [ajusteCajaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([fondoId, fecha, tipo])
  @@map("rendimiento_fondo")
}

model ValorUnidadFondo {
  id            String      @id @default(cuid())
  fondoId       String
  fondo         Instrumento @relation(fields: [fondoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fechaValor    DateTime    @db.Date
  valorUnidad   Decimal     @db.Decimal(20, 8)
  valorFondo    Decimal?    @db.Decimal(24, 4)
  fuente        String      @default("sfc:qhpu-8ixx")
  traidoEn      DateTime    @default(now()) @db.Timestamptz(6)
  reemplazadoEn DateTime?   @db.Timestamptz(6)

  @@index([fondoId, fechaValor])
  @@map("valor_unidad_fondo")
}

// ───────────── Datos oficiales ─────────────
/// Lo que publica la fuente oficial (TRM de la SFC, tasas del Banco de la República, IPC del DANE), sin convertir: una
/// vigencia por fila (TPM un día, TRM su vigencia, IPC un mes). La serie y su unidad, escala y rango viven en el catálogo
/// del código (fase C, C2a). Solo inserción y retiro (inv_solo_retiro); vigentes sin solapes por serie.
model ValorSerieOficial {
  id            String    @id @default(cuid())
  serie         String
  desde         DateTime  @db.Date
  hasta         DateTime  @db.Date
  valor         Decimal   @db.Decimal(20, 8)
  fuente        String // sfc:…, banrep:… o dane:…
  traidoEn      DateTime  @default(now()) @db.Timestamptz(6) // la pone la base (inv_solo_retiro)
  reemplazadoEn DateTime? @db.Timestamptz(6)

  @@map("valor_serie_oficial")
}

// ───────────── Precios ─────────────
model PrecioCierre {
  id               String       @id @default(cuid())
  instrumentoId    String
  instrumento      Instrumento  @relation(fields: [instrumentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fecha            DateTime     @db.Date
  precio           Decimal      @db.Decimal(20, 6) // cierre SIN ajustar
  fuente           String
  estado           EstadoPrecio
  fuenteReferencia String?
  precioReferencia Decimal?     @db.Decimal(20, 6)
  desviacionPct    Decimal?     @db.Decimal(9, 6)
  traidoEn         DateTime     @default(now()) @db.Timestamptz(6)
  reemplazadoEn    DateTime?    @db.Timestamptz(6)
  moneda           Moneda       @default(COP)

  @@index([instrumentoId, fecha])
  @@map("precio_cierre")
}

// ───────────── Conciliación ─────────────
model Conciliacion {
  id              String                @id @default(cuid())
  certificacionId String
  // Compuesta: la fecha de corte de la conciliación es, por la base, la de su certificación.
  certificacion   Certificacion         @relation(fields: [certificacionId, fechaCorte], references: [id, fechaCorte], onDelete: Restrict, onUpdate: Restrict)
  fechaCorte      DateTime              @db.Date
  calculadaEn     DateTime              @default(now()) @db.Timestamptz(6)
  versionCalculo  String
  resultado       ResultadoConciliacion
  controles       ControlConciliacion[]

  @@index([fechaCorte])
  @@index([certificacionId, fechaCorte])
  @@map("conciliacion")
}

model ControlConciliacion {
  id             String           @id @default(cuid())
  conciliacionId String
  conciliacion   Conciliacion     @relation(fields: [conciliacionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tipo           TipoControl
  instrumentoId  String?
  instrumento    Instrumento?     @relation(fields: [instrumentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  esperado       Decimal?         @db.Decimal(24, 6)
  real           Decimal?         @db.Decimal(24, 6)
  diferencia     Decimal?         @db.Decimal(24, 6)
  tolerancia     Decimal?         @db.Decimal(9, 6)
  resultado      ResultadoControl
  codigoMotivo   String?
  detalle        Json?

  @@index([conciliacionId])
  @@index([instrumentoId])
  @@map("control_conciliacion")
}

// ───────────── Plan, reglas y decisiones (fase B) ─────────────
// Cadena: versión del plan → regla → decisión → orden de Trii → resultado a 30 y 90 días.
// Nada se edita ni se borra (disparadores de solo inserción en la migración): un cambio del plan
// es una versión nueva; una decisión o un enlace equivocados se corrigen con otro que los reemplaza.
// La coherencia de la cadena va en FK compuestas; los CHECK y el índice parcial, en el SQL.

/// Foto completa del plan en una fecha (reemplaza entera a la anterior). Vigente en una fecha:
/// la de mayor `version` con `vigenteDesde` ≤ esa fecha; `vigenteDesde` nunca retrocede.
model PlanVersion {
  id            String      @id @default(cuid())
  version       Int         @unique
  vigenteDesde  DateTime    @db.Date
  motivo        String
  aprobadaPorId String
  aprobadaPor   Usuario     @relation(fields: [aprobadaPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creadaEn      DateTime    @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6) // la pone la base (inv_plan_version_instante)
  reglas        ReglaPlan[]
  decisiones    Decision[]

  @@index([aprobadaPorId])
  @@map("plan_version")
}

/// Una fila de la foto: postura o regla de una especie, o del portafolio si `instrumentoId` es nulo.
model ReglaPlan {
  id            String         @id @default(cuid())
  planVersionId String
  planVersion   PlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  instrumentoId String?
  instrumento   Instrumento?   @relation(fields: [instrumentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  condicion     CondicionRegla
  nivel         Decimal?       @db.Decimal(20, 6) // precio (cierre) o pesos (monto por orden)
  accion        AccionPlan
  cantidad      BigInt?
  plazoHasta    DateTime?      @db.Date
  detalle       String
  decisiones    Decision[]

  @@unique([id, planVersionId])
  @@index([planVersionId])
  @@index([instrumentoId])
  @@map("regla_plan")
}

/// Qué se decidió, por qué, quién y cuándo, bajo la versión vigente ese día. «No actuar» también.
model Decision {
  id             String                @id @default(cuid())
  planVersionId  String
  planVersion    PlanVersion           @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reglaId        String?
  regla          ReglaPlan?            @relation(fields: [reglaId, planVersionId], references: [id, planVersionId], onDelete: Restrict, onUpdate: Restrict)
  instrumentoId  String
  instrumento    Instrumento           @relation(fields: [instrumentoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accion         AccionPlan
  cantidad       BigInt? // obligatoria en NO_ACTUAR (lo que se mide); en compra/venta mide la orden
  excepcion      Boolean               @default(false) // se aparta de la regla citada, con motivo
  motivo         String
  decididaPorId  String
  decididaPor    Usuario               @relation(fields: [decididaPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fechaDecision  DateTime              @db.Date
  registradaEn   DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6) // la pone la base (inv_decision_instante)
  reemplazaId    String?               @unique
  reemplaza      Decision?             @relation("CorreccionDecision", fields: [reemplazaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reemplazadaPor Decision?             @relation("CorreccionDecision")
  enlaces        EnlaceDecisionOrden[]

  @@index([instrumentoId, fechaDecision])
  @@index([planVersionId])
  @@index([reglaId, planVersionId])
  @@index([decididaPorId])
  @@map("decision")
}

/// Orden importada → decisión que la originó. Cadena lineal por orden: un solo enlace raíz (índice
/// parcial) y cada corrección reemplaza a uno solo de la MISMA orden (FK compuesta). Vigente = el
/// que nadie reemplaza. Una orden APROBADO sin enlaces es «sin decisión registrada».
model EnlaceDecisionOrden {
  id             String               @id @default(cuid())
  ordenId        String
  orden          Orden                @relation(fields: [ordenId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decisionId     String
  decision       Decision             @relation(fields: [decisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reemplazaId    String?
  reemplaza      EnlaceDecisionOrden? @relation("CorreccionEnlace", fields: [reemplazaId, ordenId], references: [id, ordenId], onDelete: Restrict, onUpdate: Restrict)
  reemplazadoPor EnlaceDecisionOrden? @relation("CorreccionEnlace")
  motivo         String? // obligatorio en una corrección
  creadoPorId    String
  creadoPor      Usuario              @relation(fields: [creadoPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creadoEn       DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6) // la pone la base (inv_enlace_decision_orden_instante)

  @@unique([id, ordenId])
  @@unique([reemplazaId, ordenId])
  @@index([ordenId])
  @@index([decisionId])
  @@index([creadoPorId])
  @@map("enlace_decision_orden")
}

// ───────────── Resúmenes con IA (fase E) ─────────────

/// Los tres resúmenes (src/ia/contrato.ts, TIPOS_RESUMEN).
enum TipoResumenIa {
  DIARIO
  REGLAS
  ESCENARIOS
}

/// PUBLICADO: pasó el validador y tiene texto. RECHAZADO: el modelo respondió y el validador lo rechazó. FALLIDO: no
/// hubo salida del modelo (puerta caída, tiempo, tope, puerta apagada o la guarda de la vista ciega).
enum EstadoResumenIa {
  PUBLICADO
  RECHAZADO
  FALLIDO
}

/// Las dos puertas (src/ia/generador.ts, PUERTAS), con los mismos valores del contrato.
enum PuertaIa {
  local
  nube
}

/// Registro de cada corrida de un resumen con IA, de SOLO INSERCIÓN (inv_solo_insercion) y escrito por inv_ia. Una fila
/// por intento de puerta. tipo, fechaNegocio, hechos, hechosHash y hechosVersion salen del paquete construido
/// (src/ia/registro/fila.ts), y la base exige que cuadren (resumen_ia_hechos_chk). A lo sumo un PUBLICADO por (tipo,
/// fechaNegocio, hechosHash, promptHash, modeloDigest): índice único parcial resumen_ia_publicado_key, escrito a mano en
/// la migración (Prisma 5.22 no modela índices parciales). Los CHECK, los disparadores y la función del instante también
/// van a mano en la migración *_resumen_ia, y el guardián del esquema los vigila.
model ResumenIa {
  id               String          @id @default(cuid())
  tipo             TipoResumenIa
  fechaNegocio     DateTime        @db.Date // el `hoy` del paquete
  estado           EstadoResumenIa
  puerta           PuertaIa? // nula solo en un FALLIDO por VISTA_NO_CIEGA (no se llamó a ningún generador)
  texto            String? // el texto renderizado: no nulo si y solo si PUBLICADO
  salidaModelo     String? // la salida cruda del modelo: no nula si y solo si no es FALLIDO
  hechos           Json // el paquete completo (leerPaquete lo reconstruye)
  hechosHash       String
  hechosVersion    String
  modelo           String?
  modeloDigest     String?
  opciones         Json // las opciones del pedido al modelo (temperatura, semilla…)
  promptVersion    String
  promptHash       String
  validadorVersion String
  motivos          String[] // códigos: vacía en un PUBLICADO; en un FALLIDO, el motivo de fallo primero y sus detalles
  latenciaMs       Int?
  tokensEntrada    Int?
  tokensSalida     Int?
  generadoEn       DateTime        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6) // la pone la base (inv_resumen_ia_instante)

  @@index([puerta, generadoEn], map: "resumen_ia_gasto_idx")
  @@map("resumen_ia")
}

/// Configuración de la IA (fase E, E8): la edita el dueño en /edicion/ia. Versionada y de SOLO INSERCIÓN (disparador
/// inv_solo_insercion): cada cambio es una versión nueva con su autor, su motivo y la hora que pone la base
/// (inv_config_ia_instante). La vigente es la de mayor versión; sin ninguna, la IA está apagada. Las listas cerradas y
/// los límites van como CHECK a mano en la migración *_config_ia (espejo de src/ia/config/parametros.ts, puertas.ts y
/// nube/peticion.ts) y el guardián del esquema los vigila. Lo escribe inv_app (INSERT por columna sin creadaEn) y lo lee
/// inv_ia sin el motivo ni el autor (docker/migrador/privilegios.sql). Nunca guarda la llave de la nube.
model ConfigIa {
  id               String   @id @default(cuid())
  version          Int      @unique
  modo             String // apagado, local, nube o local-luego-nube (MODOS_PUERTAS)
  ollamaHost       String? // la IPv4 de la tailnet del Ollama del Mac (formato del destino; el control está en la red de PI)
  ollamaPuerto     Int?
  temperaturaLocal Decimal  @db.Decimal(3, 2) // de 0 a 1; 0 por omisión (la semilla queda fija)
  tareas           Json // por tarea (tipo de resumen): { "DIARIO": { "activo": true, "modeloLocal": "…" | null }, … }
  modeloNube       String // MODELOS_NUBE; por omisión claude-opus-5-5
  topeMensualUsd   Decimal? @db.Decimal(6, 2) // obligatorio si el modo usa la nube; de 1 a 50 USD
  horaResumen      String // HORAS_RESUMEN, hora de Colombia
  limiteSegundos   Int // la app acepta de 10 a 60; la CHECK de la base sigue en 10 a 120 (versiones viejas) y el lector acota a 60
  analisisDemanda  Boolean  @default(false) // el botón «Analizar con IA»: apagado por omisión (falla cerrada)
  esfuerzoNube     String // low o medium
  motivo           String
  autorId          String
  autor            Usuario  @relation(fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creadaEn         DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6) // la pone la base (inv_config_ia_instante)

  @@index([autorId])
  @@map("config_ia")
}

/// Tarifa de comisión de una casa de bolsa (fase E, O5): la carga el dueño en /edicion/tarifas, por comisionista (TRII o
/// AV) y por lado (compra o venta). Versionada y de SOLO INSERCIÓN (inv_solo_insercion): cada cambio es una versión nueva
/// (número único en toda la tabla) con su autor, su motivo y la hora que pone la base (inv_tarifa_comision_instante).
/// La vigente de un comisionista y un lado en un día es la de mayor versión con vigenteDesde hasta ese día. La comisión:
/// max(valor × porcentaje / 100, mínimo) + fijo; el IVA (%) sobre esa comisión; los otros cargos (% sobre el valor o un
/// fijo) aparte (src/operar/simulador/tarifa.ts). Las listas y los límites van como CHECK a mano en la migración
/// *_tarifa_comision (espejo de src/operar/tarifa/parametros.ts). La escribe inv_app (INSERT por columna sin creadaEn).
model TarifaComision {
  id             String    @id @default(cuid())
  version        Int       @unique
  comisionista   String // TRII o AV (COMISIONISTAS)
  lado           LadoOrden
  porcentaje     Decimal   @db.Decimal(7, 4) // de 0 a 100, sobre el valor de la orden
  minimoPorOrden Decimal   @db.Decimal(20, 4) // pesos; la comisión por porcentaje no baja de aquí
  fijoPorOrden   Decimal   @db.Decimal(20, 4) // pesos por orden, además
  ivaPct         Decimal   @db.Decimal(5, 2) // de 0 a 100, sobre la comisión
  otrosCargos    Json // [{ "nombre": "…", "tipo": "PCT" | "FIJO", "valor": "1.2345" }], hasta 3
  vigenteDesde   DateTime  @db.Date
  motivo         String
  autorId        String
  autor          Usuario   @relation(fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creadaEn       DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6) // la pone la base (inv_tarifa_comision_instante)

  @@index([autorId])
  @@map("tarifa_comision")
}
