#!/usr/bin/env bash
# wget falso con la interfaz de busybox: traduce a curl contra el Telegram falso (socket Unix, sin puertos TCP).
linea_falso="$(basename "$0")"; for a in "$@"; do linea_falso="$linea_falso"$'\t'"$a"; done; printf '%s\n' "$linea_falso" >>"$FALSO_REGISTRO" # una sola escritura: atómica entre procesos
datos="" cabecera="" salida="-" espera=15 url=""
while [ $# -gt 0 ]; do
  case "$1" in
    --post-data) datos="$2"; shift 2 ;;
    --header) cabecera="$2"; shift 2 ;;
    -O) salida="$2"; shift 2 ;;
    -T) espera="$2"; shift 2 ;;
    -q) shift ;;
    *) url="$1"; shift ;;
  esac
done
exec /usr/bin/curl -sS -f -m "$espera" --unix-socket "$FALSO_TELEGRAM_SOCKET" -H "$cabecera" --data-binary "$datos" -o "$salida" "$url"
